   "fieldtype": "Section Break",
   "label": "Xử lý và thử lại"
  },
  {
   "fieldname": "max_attempts",
   "fieldtype": "Int",
   "label": "Số lần thử tối đa",
   "default": "3",
   "description": "Quá số lần này tin chuyển sang Manual."
  },
  {
   "fieldname": "retry_backoff_minutes",
   "fieldtype": "Data",
   "label": "Chờ giữa các lần thử (phút)",
