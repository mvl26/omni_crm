{
 "autoname": "OOUT-.YYYY.-.########",
 "naming_rule": "Expression (old style)",
 "sort_field": "creation",
 "name": "Omni Outbound Message",
 "doctype": "DocType",
 "module": "Omni CRM",
 "engine": "InnoDB",
 "field_order": [
  "channel",
  "identity",
  "lead",
  "text",
  "attachment",
  "attachment_kind",
  "attachment_name",
  "col_out",
  "source",
  "sent_by",
  "bot_draft",
  "status",
  "is_sandbox",
  "sec_send",
  "attempts",
  "next_attempt_at",
  "external_message_id",
  "sent_at",
  "last_error",
  "sec_kind",
  "message_kind",
  "purpose",
  "zbs_template_id",
  "col_kind",
  "quota_consumed",
  "approved_by",
  "sec_messenger_interact",
  "reply_to_mid",
  "reaction_customer",
  "reaction_customer_at",
  "col_messenger_interact",
  "reaction_page",
  "reaction_page_by",
  "hidden_at",
  "hidden_by",
  "sticker_id",
  "sticker_url"
 ],
 "fields": [
  {
   "fieldname": "channel",
   "fieldtype": "Link",
   "label": "Kênh",
   "options": "Omni Channel",
   "in_standard_filter": 1
  },
  {
   "fieldname": "identity",
   "fieldtype": "Link",
   "label": "Người nhận",
   "options": "Omni Identity"
  },
  {
   "fieldname": "lead",
   "fieldtype": "Link",
   "label": "Lead",
   "options": "CRM Lead",
   "in_standard_filter": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "text",
   "fieldtype": "Long Text",
   "label": "Nội dung"
  },
  {
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Tệp đính kèm",
   "read_only": 1,
   "description": "V3-09: ảnh/tệp sale gửi kèm qua Zalo (tệp của Lead trong CRM)."
  },
  {
   "fieldname": "attachment_kind",
   "fieldtype": "Select",
   "label": "Loại đính kèm",
   "options": "\nimage\ngif\nfile",
   "read_only": 1
  },
  {
   "fieldname": "attachment_name",
   "fieldtype": "Data",
   "label": "Tên tệp đính kèm",
   "length": 140,
   "read_only": 1
  },
  {
   "fieldname": "col_out",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "source",
   "fieldtype": "Select",
   "label": "Nguồn",
   "options": "Sale\nBot\nSystem",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sent_by",
   "fieldtype": "Link",
   "label": "Người gửi (Sale)",
   "options": "User"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Trạng thái",
   "options": "Queued\nSent\nFailed\nBlocked",
   "default": "Queued",
   "search_index": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Blocked = quá khung gửi hoặc kênh tắt."
  },
  {
   "fieldname": "is_sandbox",
   "fieldtype": "Check",
   "label": "Tạo ở chế độ sandbox"
  },
  {
   "fieldname": "sec_send",
   "fieldtype": "Section Break",
   "label": "Gửi"
  },
  {
   "fieldname": "attempts",
   "fieldtype": "Int",
   "label": "Số lần thử",
   "default": "0"
  },
  {
   "fieldname": "next_attempt_at",
   "fieldtype": "Datetime",
   "label": "Thử lại lúc",
   "description": "Thử lại khi lỗi tạm thời; tác vụ quét đẩy lại."
  },
  {
   "fieldname": "external_message_id",
   "fieldtype": "Data",
   "label": "Mã tin bên ngoài"
  },
  {
   "fieldname": "sent_at",
   "fieldtype": "Datetime",
   "label": "Gửi lúc"
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Lỗi gần nhất"
  },
  {
   "fieldname": "bot_draft",
   "fieldtype": "Link",
   "label": "Nháp của bot",
   "options": "Omni Bot Draft",
   "description": "Với tin từ bot (Đợt 3)"
  },
  {
   "fieldname": "sec_kind",
   "fieldtype": "Section Break",
   "label": "Loại tin (V3-07)"
  },
  {
   "fieldname": "message_kind",
   "fieldtype": "Select",
   "label": "Loại tin",
   "options": "\nCS 48h\nCS ngoai 48h\nZBS Template",
   "read_only": 1
  },
  {
   "fieldname": "purpose",
   "fieldtype": "Select",
   "label": "Mục đích",
   "options": "\nreply\nfollowup\ntransaction\nrequest_info",
   "read_only": 1
  },
  {
   "fieldname": "zbs_template_id",
   "fieldtype": "Data",
   "label": "Mã mẫu ZBS",
   "read_only": 1
  },
  {
   "fieldname": "col_kind",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "quota_consumed",
   "fieldtype": "Check",
   "label": "Ăn vào quỹ tin ngoài 48 giờ",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Người đồng ý tiêu hạn mức",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "sec_messenger_interact",
   "fieldtype": "Section Break",
   "label": "Tương tác Messenger (ADR 0027)",
   "collapsible": 1
  },
  {
   "fieldname": "reply_to_mid",
   "fieldtype": "Data",
   "label": "Trả lời tin (mã tin Meta)",
   "length": 140,
   "read_only": 1,
   "description": "Mã tin (mid) mà tin này trả lời (reply một tin cụ thể)."
  },
  {
   "fieldname": "reaction_customer",
   "fieldtype": "Data",
   "label": "Khách thả cảm xúc",
   "length": 32,
   "read_only": 1
  },
  {
   "fieldname": "reaction_customer_at",
   "fieldtype": "Datetime",
   "label": "Lúc khách thả cảm xúc",
   "read_only": 1
  },
  {
   "fieldname": "col_messenger_interact",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reaction_page",
   "fieldtype": "Data",
   "label": "Page thả cảm xúc",
   "length": 32,
   "read_only": 1
  },
  {
   "fieldname": "reaction_page_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Người thả cảm xúc",
   "read_only": 1
  },
  {
   "fieldname": "hidden_at",
   "fieldtype": "Datetime",
   "label": "Ẩn trong CRM lúc",
   "read_only": 1,
   "description": "Thu hồi 1 phía: tin chỉ bị ẩn trong CRM, khách vẫn thấy (Meta không có API thu hồi). Bản ghi gốc giữ nguyên."
  },
  {
   "fieldname": "hidden_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Người ẩn",
   "read_only": 1
  },
  {
   "fieldname": "sticker_id",
   "fieldtype": "Data",
   "label": "Sticker (mã Meta)",
   "length": 32,
   "read_only": 1
  },
  {
   "fieldname": "sticker_url",
   "fieldtype": "Small Text",
   "label": "Ảnh sticker",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "Omni Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "email": 0,
   "print": 0,
   "share": 1
  },
  {
   "role": "Sales User",
   "read": 1
  }
 ],
 "sort_order": "DESC",
 "states": []
}
