{
 "autoname": "field:channel_name",
 "track_changes": 1,
 "title_field": "channel_name",
 "search_fields": "channel_type",
 "naming_rule": "By fieldname",
 "name": "Omni Channel",
 "doctype": "DocType",
 "module": "Omni CRM",
 "engine": "InnoDB",
 "field_order": [
  "channel_name",
  "channel_type",
  "col_flags",
  "enabled",
  "outbound_enabled",
  "sec_generic",
  "webhook_token",
  "sec_email",
  "email_account",
  "sec_zalo",
  "zalo_app_id",
  "zalo_oa_id",
  "zalo_app_secret",
  "zalo_oa_secret_key",
  "zalo_access_token",
  "zalo_refresh_token",
  "zalo_token_expires_at",
  "col_zalo2",
  "zalo_cs_free_hours",
  "zalo_cs_max_days",
  "zalo_skip_signature",
  "zalo_create_lead_on_follow",
  "zalo_oauth_state",
  "sec_tel",
  "telephony_provider",
  "telephony_api_key_sid",
  "telephony_api_key_secret",
  "telephony_hotline",
  "sec_status",
  "last_success_at",
  "last_error"
 ],
 "fields": [
  {
   "fieldname": "channel_name",
   "fieldtype": "Data",
   "label": "Tên kênh",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "channel_type",
   "fieldtype": "Select",
   "label": "Loại kênh",
   "options": "Email\nZalo OA\nTelephony",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_flags",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Bật kênh",
   "default": "0",
   "in_list_view": 1,
   "description": "Tắt: webhook vẫn trả 200 và lưu tin nhưng không xử lý."
  },
  {
   "fieldname": "outbound_enabled",
   "fieldtype": "Check",
   "label": "Bật chiều ra",
   "default": "0",
   "in_list_view": 1,
   "description": "Tắt: tin ra bị Blocked."
  },
  {
   "fieldname": "sec_generic",
   "fieldtype": "Section Break",
   "label": "Bí mật chung"
  },
  {
   "fieldname": "webhook_token",
   "fieldtype": "Password",
   "label": "Token webhook",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "sec_email",
   "fieldtype": "Section Break",
   "label": "Email",
   "depends_on": "eval:doc.channel_type=='Email'"
  },
  {
   "fieldname": "email_account",
   "fieldtype": "Link",
   "label": "Tài khoản email",
   "options": "Email Account",
   "depends_on": "eval:doc.channel_type=='Email'"
  },
  {
   "fieldname": "sec_zalo",
   "fieldtype": "Section Break",
   "label": "Zalo OA",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_app_id",
   "fieldtype": "Data",
   "label": "App ID",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_oa_id",
   "fieldtype": "Data",
   "label": "OA ID",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_app_secret",
   "fieldtype": "Password",
   "label": "App secret",
   "depends_on": "eval:doc.channel_type=='Zalo OA'",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "zalo_oa_secret_key",
   "fieldtype": "Password",
   "label": "OA secret key (xác thực chữ ký webhook)",
   "depends_on": "eval:doc.channel_type=='Zalo OA'",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "zalo_access_token",
   "fieldtype": "Password",
   "label": "Access token",
   "depends_on": "eval:doc.channel_type=='Zalo OA'",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "zalo_refresh_token",
   "fieldtype": "Password",
   "label": "Refresh token",
   "depends_on": "eval:doc.channel_type=='Zalo OA'",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "zalo_token_expires_at",
   "fieldtype": "Datetime",
   "label": "Access token hết hạn lúc",
   "read_only": 1,
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "col_zalo2",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "zalo_cs_free_hours",
   "fieldtype": "Int",
   "label": "Khung gửi tin tư vấn miễn phí (giờ)",
   "default": "48",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_cs_max_days",
   "fieldtype": "Int",
   "label": "Hạn tối đa gửi tin tư vấn (ngày)",
   "default": "7",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_skip_signature",
   "fieldtype": "Check",
   "label": "Bỏ qua kiểm tra chữ ký (chỉ site dev)",
   "default": "0",
   "description": "Chỉ cho site dev. Bật trên production thì cổng từ chối xử lý và cảnh báo.",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_create_lead_on_follow",
   "fieldtype": "Check",
   "label": "Tạo Lead khi khách chỉ bấm quan tâm OA",
   "default": "0",
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "zalo_oauth_state",
   "fieldtype": "Data",
   "label": "OAuth state",
   "hidden": 1,
   "read_only": 1,
   "depends_on": "eval:doc.channel_type=='Zalo OA'"
  },
  {
   "fieldname": "sec_tel",
   "fieldtype": "Section Break",
   "label": "Tổng đài",
   "depends_on": "eval:doc.channel_type=='Telephony'"
  },
  {
   "fieldname": "telephony_provider",
   "fieldtype": "Select",
   "label": "Nhà cung cấp tổng đài",
   "options": "\nStringee",
   "depends_on": "eval:doc.channel_type=='Telephony'"
  },
  {
   "fieldname": "telephony_api_key_sid",
   "fieldtype": "Data",
   "label": "API key SID",
   "depends_on": "eval:doc.channel_type=='Telephony'"
  },
  {
   "fieldname": "telephony_api_key_secret",
   "fieldtype": "Password",
   "label": "API key secret",
   "depends_on": "eval:doc.channel_type=='Telephony'",
   "no_copy": 1,
   "print_hide": 1,
   "report_hide": 1,
   "in_list_view": 0,
   "in_standard_filter": 0
  },
  {
   "fieldname": "telephony_hotline",
   "fieldtype": "Data",
   "label": "Đầu số hotline",
   "depends_on": "eval:doc.channel_type=='Telephony'"
  },
  {
   "fieldname": "sec_status",
   "fieldtype": "Section Break",
   "label": "Trạng thái"
  },
  {
   "fieldname": "last_success_at",
   "fieldtype": "Datetime",
   "label": "Lần thành công gần nhất",
   "read_only": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Lỗi gần nhất",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "Omni Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "email": 0,
   "print": 0,
   "share": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "states": []
}
