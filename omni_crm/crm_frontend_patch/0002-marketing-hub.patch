+const codeHint = computed(() => {
+  const code = normalizePostCode(post.value.post_code)
+  if (!code) return __('Chữ thường không dấu, số và gạch ngang, ví dụ spd-b06. Không đổi được sau khi tạo.')
+  return isValidPostCode(code) ? __('Mã sẽ dùng: {0}', [code]) : __('Mã chưa hợp lệ')
+})
+const publishAtInput = computed({
+  get: () => toInputDatetime(post.value.publish_at),
+  set: (v) => (post.value.publish_at = fromInputDatetime(v)),
+})
+const campaignOptions = computed(() => {
+  const names = campaigns.value.map((c) => c.name)
+  if (post.value.campaign && !names.includes(post.value.campaign)) names.unshift(post.value.campaign)
+  return names.map((n) => ({ label: n, value: n }))
+})
+const pillarOptions = computed(() => [
+  { label: '', value: '' },
+  ...pillars.value
+    .filter((p) => p.enabled || p.name === post.value.pillar)
+    .map((p) => ({ label: p.pillar_name, value: p.name })),
+])
+const uploadArgs = computed(() =>
+  isNew.value
+    ? { private: true }
+    : { private: true, doctype: 'Omni Content Post', docname: currentName.value, fieldname: 'image' },
+)
+
+const ACTION_LABELS = {
+  schedule: __('Lên lịch'),
+  unschedule: __('Huỷ lịch'),
+  cancel: __('Huỷ bài'),
+  reopen: __('Mở lại'),
+}
+const actions = computed(() => {
+  if (isNew.value) return []
+  const out = []
+  for (const key of postActions(post.value.status, canEdit.value)) {
+    if (key === 'resolve') {
+      out.push({ key: 'published', label: __('Bài đã lên Page'), run: () => resolve(true) })
+      out.push({ key: 'not-published', label: __('Bài chưa lên Page'), run: () => resolve(false) })
+    } else {
+      out.push({ key, label: ACTION_LABELS[key], run: () => act(key) })
+    }
+  }
+  return out
+})
+
+async function load() {
+  loading.value = true
+  try {
+    const [camps, pils] = await Promise.all([
+      marketingCall('campaigns'),
+      marketingCall('pillars'),
+    ])
+    campaigns.value = camps || []
+    pillars.value = pils || []
+    if (currentName.value) {
+      post.value = await marketingCall('post', { name: currentName.value })
+    } else {
+      post.value = emptyPost(props.campaign)
+    }
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    loading.value = false
+  }
+}
+
+watch(show, (v) => {
+  if (!v) return
+  currentName.value = props.name || ''
+  load()
+})
+
+function payload() {
+  const data = {}
+  for (const f of EDIT_FIELDS) if (f in post.value) data[f] = post.value[f] ?? ''
+  if (isNew.value) data.post_code = normalizePostCode(post.value.post_code)
+  return data
+}
+
+async function save(quiet = false) {
+  if (isNew.value && !isValidPostCode(post.value.post_code)) {
+    toast.error(__('Mã bài chưa hợp lệ'))
+    return false
+  }
+  busy.value = 'save'
+  try {
+    const name = await marketingCall('save_post', {
+      values: payload(),
+      name: currentName.value || undefined,
+    })
+    currentName.value = name
+    post.value = await marketingCall('post', { name })
+    if (!quiet) toast.success(__('Đã lưu bài'))
+    emit('saved', name)
+    return true
+  } catch (e) {
+    toast.error(errorText(e))
+    return false
+  } finally {
+    busy.value = ''
+  }
+}
+
+async function act(key) {
+  if (key === 'schedule' && canEdit.value && !(await save(true))) return
+  if (key === 'cancel' && !window.confirm(__('Huỷ bài này? Bài sẽ không được đăng.'))) return
+  busy.value = key
+  try {
+    await runPostAction(key, currentName.value)
+    post.value = await marketingCall('post', { name: currentName.value })
+    emit('saved', currentName.value)
+  } catch {
+    // runPostAction đã báo lỗi
+  } finally {
+    busy.value = ''
+  }
+}
+
+async function resolve(published) {
+  let url = ''
+  if (published) {
+    url = window.prompt(__('Dán link bài trên Page')) || ''
+    if (!safeUrl(url)) {
+      if (url) toast.error(__('Link bài phải bắt đầu bằng http:// hoặc https://'))
+      return
+    }
+  }
+  busy.value = published ? 'published' : 'not-published'
+  try {
+    await runPostAction('resolve', currentName.value, { published: published ? 1 : 0, post_url: url })
+    post.value = await marketingCall('post', { name: currentName.value })
+    emit('saved', currentName.value)
+  } catch {
+    // đã báo lỗi
+  } finally {
+    busy.value = ''
+  }
+}
+
+async function copyLink() {
+  try {
+    await navigator.clipboard.writeText(post.value.utm_link)
+    toast.success(__('Đã chép link có UTM'))
+  } catch {
+    toast.error(__('Không chép được, hãy chọn và chép tay'))
+  }
+}
+</script>
