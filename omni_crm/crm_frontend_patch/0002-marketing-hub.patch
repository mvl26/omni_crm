new file mode 100644
index 0000000..e43d8ba
--- /dev/null
+++ b/frontend/src/composables/marketing.js
@@ -0,0 +1,63 @@
+import { call, createResource, toast } from 'frappe-ui'
+import { computed, reactive } from 'vue'
+
+// Marketing Hub (omni_crm ADR 0031). Nhóm menu Marketing chỉ hiện khi app omni_crm có API này và người dùng đọc được
+// Omni Campaign; lời gọi lỗi (không có omni_crm, bản cũ) thì ẩn hết, CRM chạy như cũ.
+export const marketingState = reactive({
+  enabled: false,
+  can_create_campaign: false,
+  can_edit_campaign: false,
+  can_create_post: false,
+  can_edit_post: false,
+  can_edit_pillar: false,
+  is_admin: false,
+})
+
+export const marketingEnabled = computed(() => marketingState.enabled)
+
+createResource({
+  url: 'omni_crm.api.marketing_ui.ui_state',
+  cache: 'Omni Marketing UI State',
+  auto: true,
+  onSuccess: (data) => Object.assign(marketingState, data || {}),
+  onError: () => {
+    marketingState.enabled = false
+  },
+})
+
+const API = 'omni_crm.api.marketing_ui.'
+const POST_API = 'omni_crm.api.content_posts.'
+
+export function marketingCall(method, args = {}) {
+  return call(API + method, args)
+}
+
+export async function runPostAction(action, name, extra = {}) {
+  const labels = {
+    schedule: __('Đã lên lịch'),
+    unschedule: __('Đã huỷ lịch, bài về Nháp'),
+    cancel: __('Đã huỷ bài'),
+    reopen: __('Bài về Nháp'),
+    resolve: __('Đã cập nhật bài'),
+  }
+  const method = action === 'resolve' ? 'resolve_uncertain' : action
+  try {
+    const status = await call(POST_API + method, { name, ...extra })
+    toast.success(labels[action] || status)
+    return status
+  } catch (e) {
+    toast.error(errorText(e))
+    throw e
+  }
+}
+
+// Thông điệp lỗi gọn từ lỗi frappe-ui (ValidationError của máy chủ đã là tiếng Việt).
+export function errorText(e) {
+  const msg = e?.messages?.length ? e.messages.join(' ') : e?.message || ''
+  return String(msg).replace(/<[^>]*>/g, '') || __('Có lỗi, thử lại sau')
+}
+
+export function deskUrl(doctype, name) {
+  const slug = doctype.toLowerCase().replace(/ /g, '-')
+  return name ? `/app/${slug}/${encodeURIComponent(name)}` : `/app/${slug}`
+}
