+          <h3 class="text-base font-semibold text-ink-gray-9">{{ __('Kho ảnh S3 (MinIO)') }}</h3>
+          <Button
+            :label="__('Kiểm kho ảnh S3')"
+            :loading="checking"
+            :disabled="dirty"
+            :title="dirty ? __('Lưu trước khi kiểm') : ''"
+            @click="checkStorage"
+          />
+        </div>
+        <div class="flex items-center justify-between gap-4">
