+import { describe, expect, it } from 'vitest'
+import {
+  compact,
+  dayMonth,
+  emptyPost,
+  fromInputDatetime,
+  gridRange,
+  isLocked,
+  isValidPostCode,
+  monthGrid,
+  normalizePostCode,
+  postActions,
+  postTheme,
+  postsByDay,
+  safeUrl,
+  shiftMonth,
+  timeOf,
+  toInputDatetime,
+  utmLabel,
+} from '@/utils/marketing'
+
+describe('mã bài', () => {
+  it('chuẩn hoá và kiểm như máy chủ', () => {
+    expect(normalizePostCode('  SPD-B01 ')).toBe('spd-b01')
+    expect(isValidPostCode('spd-b01')).toBe(true)
+    for (const bad of ['', 'spd b01', 'spd_b01', '-spd', 'bài-1', 'a'.repeat(41)]) {
+      expect(isValidPostCode(bad)).toBe(false)
+    }
+  })
+})
+
+describe('nút theo trạng thái', () => {
+  it('khớp luật máy chủ', () => {
+    expect(postActions('Nháp', true)).toEqual(['schedule', 'cancel'])
+    expect(postActions('Đã lên lịch', true)).toEqual(['unschedule', 'cancel'])
+    expect(postActions('Lỗi', true)).toEqual(['schedule', 'cancel'])
+    expect(postActions('Đã huỷ', true)).toEqual(['reopen'])
+    expect(postActions('Cần kiểm', true)).toEqual(['resolve'])
+    expect(postActions('Đã đăng', true)).toEqual([])
+    expect(postActions('Nháp', false)).toEqual([])
+  })
+  it('khoá nội dung khi đã ra ngoài', () => {
+    expect(isLocked('Đã đăng')).toBe(true)
+    expect(isLocked('Cần kiểm')).toBe(true)
+    expect(isLocked('Nháp')).toBe(false)
+  })
+  it('màu trạng thái', () => {
+    expect(postTheme('Lỗi')).toBe('red')
+    expect(postTheme('lạ')).toBe('gray')
+  })
+})
+
+describe('lịch tháng', () => {
+  it('11/2026 bắt đầu thứ Hai 26/10, đủ tuần', () => {
+    const weeks = monthGrid(2026, 11)
+    expect(weeks[0][0]).toEqual({ date: '2026-10-26', day: 26, inMonth: false })
+    expect(weeks.every((w) => w.length === 7)).toBe(true)
+    const days = weeks.flat().filter((d) => d.inMonth)
+    expect(days.length).toBe(30)
+    expect(weeks.at(-1).at(-1).date).toBe('2026-12-06')
+    expect(gridRange(weeks)).toEqual({ start: '2026-10-26 00:00:00', end: '2026-12-06 23:59:59' })
+  })
+  it('tháng bắt đầu đúng thứ Hai không có ngày tháng trước', () => {
+    const weeks = monthGrid(2026, 6) // 01/06/2026 là thứ Hai
+    expect(weeks[0][0]).toEqual({ date: '2026-06-01', day: 1, inMonth: true })
+  })
+  it('chuyển tháng qua năm', () => {
+    expect(shiftMonth(2026, 12, 1)).toEqual({ year: 2027, month: 1 })
+    expect(shiftMonth(2026, 1, -1)).toEqual({ year: 2025, month: 12 })
+  })
+  it('gom bài theo ngày, sắp theo giờ', () => {
+    const map = postsByDay([
+      { name: 'b', publish_at: '2026-11-24 14:00:00' },
+      { name: 'a', publish_at: '2026-11-24 09:00:00' },
+      { name: 'c', publish_at: '2026-11-26 09:00:00' },
+      { name: 'x', publish_at: null },
+    ])
+    expect(map['2026-11-24'].map((p) => p.name)).toEqual(['a', 'b'])
+    expect(Object.keys(map)).toEqual(['2026-11-24', '2026-11-26'])
+  })
+})
+
+describe('định dạng', () => {
+  it('giờ, ngày, số gọn', () => {
+    expect(timeOf('2026-11-24 09:05:00')).toBe('09:05')
+    expect(dayMonth('2026-11-24 09:05:00')).toBe('24/11')
+    expect(compact(4200)).toBe('4.2k')
+    expect(compact(1000)).toBe('1k')
+    expect(compact(310)).toBe('310')
+    expect(compact(null)).toBe('–')
+  })
+  it('ô datetime-local', () => {
+    expect(toInputDatetime('2026-11-24 09:00:00')).toBe('2026-11-24T09:00')
+    expect(fromInputDatetime('2026-11-24T09:00')).toBe('2026-11-24 09:00:00')
+    expect(fromInputDatetime('')).toBe('')
+  })
+  it('UTM và link an toàn', () => {
+    expect(utmLabel({ source: 'facebook', campaign: 'spd-pk-2611' })).toBe('facebook / spd-pk-2611')
+    expect(utmLabel({})).toBe('')
+    expect(safeUrl('https://www.facebook.com/p/1')).toBe('https://www.facebook.com/p/1')
+    expect(safeUrl('javascript:alert(1)')).toBe('')
+    expect(safeUrl('/spd/')).toBe('')
+  })
+  it('bài trống mặc định 09:00 ngày mai, cách đăng Tự động', () => {
+    const p = emptyPost('SPD', new Date(2026, 10, 30, 15, 0))
+    expect(p.publish_at).toBe('2026-12-01 09:00:00')
+    expect(p.campaign).toBe('SPD')
+    expect(p.publish_mode).toBe('Tự động')
+  })
+})
