+  <PostDialog v-model="showPost" :name="postName" :campaign="selected" @saved="refresh" />
+  <CampaignDialog v-model="showCampaign" :campaign="editingCampaign" @saved="onCampaignSaved" />
+</template>
+
+<script setup>
+import LayoutHeader from '@/components/LayoutHeader.vue'
+import PostDialog from '@/components/Marketing/PostDialog.vue'
+import CampaignDialog from '@/components/Marketing/CampaignDialog.vue'
+import { Badge, Breadcrumbs, Button, FormControl, LoadingIndicator, createResource } from 'frappe-ui'
+import { computed, ref, watch } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import {
+  CAMPAIGN_STATUSES,
+  NEEDS_ATTENTION,
+  campaignTheme,
+  dayMonth,
+  postTheme,
+  safeUrl,
+  timeOf,
+} from '@/utils/marketing'
+import { marketingState } from '@/composables/marketing'
+
+const route = useRoute()
+const router = useRouter()
+const statusFilter = ref('')
+const selected = ref(route.query.campaign || '')
+const showPost = ref(false)
+const postName = ref('')
+const showCampaign = ref(false)
+const editingCampaign = ref(null)
+
+const list = createResource({
+  url: 'omni_crm.api.marketing_ui.campaigns',
+  makeParams: () => ({ status: statusFilter.value || undefined }),
+  auto: true,
+  onSuccess: (rows) => {
+    if (!selected.value && rows?.length) select(rows[0].name)
+  },
+})
+const detail = createResource({
+  url: 'omni_crm.api.marketing_ui.campaign',
+  makeParams: () => ({ name: selected.value }),
+})
+const c = computed(() => detail.data || {})
+const kpis = computed(() => {
+  const posts = c.value.posts || []
+  const target = c.value.lead_target ? ` / ${c.value.lead_target}` : ''
+  return [
+    { label: __('Bài'), value: posts.length },
+    { label: __('Đã đăng'), value: posts.filter((p) => p.status === 'Đã đăng').length },
+    { label: __('Cần xử lý'), value: posts.filter((p) => NEEDS_ATTENTION.includes(p.status)).length },
+    { label: __('Lead'), value: `${c.value.leads || 0}${target}` },
+    { label: __('Deal'), value: c.value.deals || 0 },
+  ]
+})
+
+watch(statusFilter, () => list.reload())
+watch(
+  selected,
+  (name) => {
+    if (name) detail.reload()
+  },
+  { immediate: true },
+)
+
+function select(name) {
+  selected.value = name
+  router.replace({ query: { ...route.query, campaign: name } })
+}
+
+function openPost(name) {
+  postName.value = name
+  showPost.value = true
+}
+
+function openCampaign(campaign) {
+  editingCampaign.value = campaign
+  showCampaign.value = true
+}
+
+function refresh() {
+  detail.reload()
+  list.reload()
+}
+
+function onCampaignSaved(name) {
+  list.reload()
+  if (name === selected.value) detail.reload()
+  else select(name)
+}
+</script>
