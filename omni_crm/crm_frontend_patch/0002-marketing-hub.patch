+          <FormControl v-model="tdraft.post_format" type="select" label="Định dạng" :options="FORMATS[tdraft.platform]" />
+          <FormControl v-model="tdraft.channel_account" type="select" label="Kênh" :options="channelOptions" />
+          <FormControl v-model="tdraft.when" type="datetime-local" label="Giờ đăng" />
+        </div>
+      </template>
+      <template #actions>
+        <Button class="w-full" variant="solid" label="Lưu" :loading="busy === 'target'" @click="saveTarget" />
+      </template>
+    </Dialog>
+  </div>
+</template>
+
+<script setup>
+import LayoutHeader from '@/components/LayoutHeader.vue'
+import { Badge, Dialog, FormControl, FileUploader, Tooltip, createResource, call, toast } from 'frappe-ui'
+import { ref, reactive, computed, watch, onBeforeUnmount } from 'vue'
+import { globalStore } from '@/stores/global'
+import {
+  API,
+  api,
+  ITEM_THEME,
+  TARGET_THEME,
+  FORMATS,
+  FUNNEL,
+  fmtDateTime,
+  toInputDateTime,
+  fromInputDateTime,
+  scoreClass,
+  errorText,
+  callShowMessages,
+} from '@/composables/marketing'
+
+const props = defineProps({ name: { type: String, required: true } })
+const { $socket } = globalStore()
+
+const detail = createResource({
+  url: API + 'item_detail',
+  makeParams: () => ({ name: props.name }),
+  auto: true,
+})
+const d = computed(() => detail.data)
+const item = computed(() => d.value?.item)
+
+const FIELDS = ['title', 'caption', 'pillar', 'funnel_stage', 'landing_page', 'utm_content']
+const form = reactive({})
+watch(item, (v) => v && FIELDS.forEach((f) => (form[f] = v[f] || '')), { immediate: true })
+const dirty = computed(() => item.value && FIELDS.some((f) => (form[f] || '') !== (item.value[f] || '')))
+
+const canScore = computed(() => d.value?.can_edit && (form.caption || '').trim())
+const canApprove = computed(
+  () =>
+    item.value &&
+    ((item.value.status === 'Chờ duyệt' && (d.value.is_manager || !d.value.require_approval)) ||
+      (item.value.status === 'Nháp' && !d.value.require_approval && d.value.can_edit)),
+)
+const canCancel = computed(
+  () => item.value && ['Chờ duyệt', 'Đã lên lịch', 'Thất bại', 'Đăng một phần'].includes(item.value.status),
+)
+
+const busy = ref('')
+async function run(key, fn) {
+  busy.value = key
+  try {
+    await fn()
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    busy.value = ''
+  }
+}
+
+function act(method) {
+  const key = { submit_item: 'submit', approve_item: 'approve', cancel_item: 'cancel' }[method]
+  return run(key, async () => {
+    const status = await api(method, { name: props.name })
+    toast.success(`Trạng thái bài: ${status}`)
+    detail.reload()
+  })
+}
+
+function save() {
+  return run('save', async () => {
+    const values = {}
+    FIELDS.forEach((f) => {
+      if ((form[f] || '') !== (item.value[f] || '')) values[f] = form[f] || null
+    })
+    await callShowMessages('frappe.client.set_value', { doctype: 'Omni Content Item', name: props.name, fieldname: values })
+    toast.success('Đã lưu')
+    detail.reload()
+  })
+}
+
+function rescore() {
+  return run('score', async () => {
+    if (dirty.value) await save()
+    await api('score_item', { name: props.name })
+    toast.info('Đang chấm điểm, kết quả sẽ hiện sau ít giây')
+  })
+}
+
+// Ảnh: media là ảnh bìa, media_items là ảnh thêm
+const images = computed(() => {
+  if (!item.value) return []
+  const out = []
+  if (item.value.media) out.push({ url: item.value.media, label: 'Bìa', field: 'media' })
+  ;(item.value.media_items || []).forEach((m, i) => out.push({ url: m.image, label: `#${i + 2}`, row: m.name }))
+  return out
+})
+
+async function saveMedia(media, rows) {
+  const doc = await call('frappe.client.get', { doctype: 'Omni Content Item', name: props.name })
+  doc.media = media
+  doc.media_items = rows
+  await callShowMessages('frappe.client.save', { doc })
+  detail.reload()
+}
+
+function addImage(file) {
+  return run('media', async () => {
+    const rows = (item.value.media_items || []).map((m) => ({ image: m.image, alt_text: m.alt_text }))
+    if (!item.value.media) await saveMedia(file.file_url, rows)
+    else await saveMedia(item.value.media, [...rows, { image: file.file_url }])
+  })
+}
+
+function removeImage(img) {
+  return run('media', async () => {
+    let rows = (item.value.media_items || []).map((m) => ({ name: m.name, image: m.image, alt_text: m.alt_text }))
+    let media = item.value.media
+    if (img.field === 'media') {
+      media = rows.length ? rows.shift().image : null
+    } else {
+      rows = rows.filter((r) => r.name !== img.row)
+    }
+    await saveMedia(media, rows.map(({ image, alt_text }) => ({ image, alt_text })))
+  })
+}
+
+// Nền tảng
+const channels = createResource({ url: API + 'get_social_channels', auto: true })
+function channelName(name) {
+  return (channels.data || []).find((c) => c.name === name)?.account_name || name || '—'
+}
+const channelOptions = computed(() =>
+  (channels.data || [])
+    .filter((a) => a.name && a.platform === tdraft.platform)
+    .map((a) => ({ label: `${a.account_name} (${a.status})`, value: a.name })),
+)
+function formatLabel(t) {
+  return (FORMATS[t.platform] || []).find((f) => f.value === t.post_format)?.label || t.post_format
+}
+function platformOf(target) {
+  return d.value?.targets.find((t) => t.name === target)?.platform || target
+}
+const previewChannel = computed(() => channelName(d.value?.targets[0]?.channel_account) || 'Trang của bạn')
+const previewLink = computed(() => d.value?.targets.find((t) => t.tracking_url)?.tracking_url || form.landing_page || d.value?.campaign?.landing_page)
+
+const showTarget = ref(false)
+const tdraft = reactive({})
+function openTarget(t) {
+  Object.assign(tdraft, {
+    name: t?.name || '',
+    platform: t?.platform || 'Facebook',
+    post_format: t?.post_format || 'fb_link',
+    channel_account: t?.channel_account || '',
+    when: toInputDateTime(t?.scheduled_at),
+  })
+  showTarget.value = true
+}
+watch(
+  () => tdraft.platform,
+  (p) => {
+    if (!tdraft.name && p && !(FORMATS[p] || []).some((f) => f.value === tdraft.post_format)) {
+      tdraft.post_format = FORMATS[p][0].value
+      tdraft.channel_account = ''
+    }
+  },
+)
+function saveTarget() {
+  if (!tdraft.when) return toast.error('Chọn giờ đăng')
+  return run('target', async () => {
+    const values = {
+      post_format: tdraft.post_format,
+      channel_account: tdraft.channel_account || channelOptions.value[0]?.value,
+      scheduled_at: fromInputDateTime(tdraft.when),
+    }
+    if (tdraft.name) {
+      await call('frappe.client.set_value', { doctype: 'Omni Content Target', name: tdraft.name, fieldname: values })
+    } else {
+      await call('frappe.client.insert', {
+        doc: { doctype: 'Omni Content Target', content_item: props.name, platform: tdraft.platform, ...values },
+      })
+    }
+    showTarget.value = false
+    detail.reload()
+  })
+}
+
+const pillars = createResource({
+  url: 'frappe.client.get_list',
+  params: { doctype: 'Omni Content Pillar', filters: { is_active: 1 }, fields: ['name'], limit_page_length: 0 },
+  auto: true,
+})
+const pillarOptions = computed(() => ['', ...(pillars.data || []).map((p) => p.name)])
+
+function onUpdate(data) {
+  if ((data?.item || data?.content_item) === props.name) detail.reload()
+}
+$socket?.on('oc_publish_update', onUpdate)
+onBeforeUnmount(() => $socket?.off('oc_publish_update', onUpdate))
+</script>
