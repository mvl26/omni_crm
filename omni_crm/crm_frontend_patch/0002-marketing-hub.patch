+                  <Badge :label="p.funnel_stage" variant="outline" />
+                  <span class="text-xs text-ink-gray-5">{{ fmtDateTime(p.scheduled_at) }}</span>
+                  <span class="ml-auto text-base font-semibold" :class="scoreClass(score(pi), state.threshold)">
+                    {{ score(pi) == null ? (state.scores?.[pi] ? '—' : '…') : score(pi) + '/100' }}
+                  </span>
+                </div>
+                <div class="whitespace-pre-wrap text-p-sm text-ink-gray-7">{{ p.caption }}</div>
