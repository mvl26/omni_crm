+<script setup>
+import LayoutHeader from '@/components/LayoutHeader.vue'
+import { Badge, Dialog, FormControl, FileUploader, Switch, createResource, call, toast } from 'frappe-ui'
+import { ref, reactive, computed } from 'vue'
+import { marketingHub } from '@/composables/marketingHub'
+import { API, api, fmtDateTime, errorText } from '@/composables/marketing'
+
+const DOC_THEME = { 'Đang xử lý': 'blue', 'Đã lập chỉ mục': 'green', 'Lỗi': 'red' }
+const isManager = computed(() => Boolean(marketingHub.data?.is_manager))
+
+const kb = createResource({ url: API + 'kb_overview', auto: true })
+const docs = computed(() => kb.data?.documents || [])
+const category = ref('')
+const shown = computed(() =>
+  docs.value.filter((d) => !category.value || (category.value === '-' ? !d.category : d.category === category.value)),
+)
+const categoryOptions = computed(() => [
+  { label: '(chưa phân loại)', value: '' },
+  ...(kb.data?.categories || []).filter((c) => c.is_active).map((c) => ({ label: c.category_name, value: c.name })),
+])
+
+async function toggle(doc, value) {
+  try {
+    await call('frappe.client.set_value', { doctype: 'Omni KB Document', name: doc.name, fieldname: 'is_active', value: value ? 1 : 0 })
+    kb.reload()
+  } catch (e) {
+    toast.error(errorText(e))
+  }
+}
+async function reindex(doc) {
+  try {
+    await api('kb_reindex', { name: doc.name })
+    toast.info('Đang lập chỉ mục lại')
+    setTimeout(() => kb.reload(), 3000)
+  } catch (e) {
+    toast.error(errorText(e))
+  }
+}
+
+const showUpload = ref(false)
+const saving = ref(false)
+const up = reactive({})
+function openUpload() {
+  Object.assign(up, { title: '', category: category.value && category.value !== '-' ? category.value : '', file: null })
+  showUpload.value = true
+}
+async function saveDoc() {
+  saving.value = true
+  try {
+    await call('frappe.client.insert', {
+      doc: {
+        doctype: 'Omni KB Document',
+        title: up.title || up.file.file_name,
+        category: up.category || null,
+        source_file: up.file.file_url,
+      },
+    })
+    showUpload.value = false
+    toast.success('Đã thêm, đang lập chỉ mục')
+    kb.reload()
+    setTimeout(() => kb.reload(), 4000)
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    saving.value = false
+  }
+}
+
+const showCat = ref(false)
+const cat = reactive({ category_name: '', description: '' })
+async function saveCat() {
+  try {
+    await call('frappe.client.insert', { doc: { doctype: 'Omni KB Category', ...cat, is_active: 1 } })
+    showCat.value = false
+    cat.category_name = ''
+    cat.description = ''
+    kb.reload()
+  } catch (e) {
+    toast.error(errorText(e))
+  }
+}
+
+const question = ref('')
+const asking = ref(false)
+const answer = ref(null)
+const verdict = ref('')
+const note = ref('')
+const sendingFb = ref(false)
+const fbSent = ref(false)
+async function ask() {
+  if (!question.value.trim() || asking.value) return
+  asking.value = true
+  verdict.value = ''
+  note.value = ''
+  fbSent.value = false
+  try {
+    answer.value = await api('kb_ask', { question: question.value })
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    asking.value = false
+  }
+}
+async function feedback() {
+  sendingFb.value = true
+  try {
+    await api('kb_feedback', { run: answer.value.run, verdict: verdict.value, note: note.value })
+    fbSent.value = true
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    sendingFb.value = false
+  }
+}
+</script>
