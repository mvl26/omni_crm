new file mode 100644
index 0000000..39a07de
--- /dev/null
+++ b/frontend/src/composables/marketing.js
@@ -0,0 +1,105 @@
+// Marketing Hub (omni_crm, V3-10 Prompt 3): tiện ích dùng chung cho các trang Marketing.
+import { call, frappeRequest, toast } from 'frappe-ui'
+import { serverMessageList } from '@/utils/serverMessages'
+
+export const API = 'omni_crm.marketing.api.'
+
+export function api(method, params = {}) {
+  return call(API + method, params)
+}
+
+// Cảnh báo máy chủ gửi kèm khi gọi THÀNH CÔNG (frappe.msgprint), ví dụ kho ảnh S3 chưa ghi được ảnh (ADR 0033).
+// call() của frappe-ui chỉ đọc _server_messages khi lỗi, nên trang Marketing không thấy các cảnh báo này như Desk.
+export function showServerMessages(raw = []) {
+  for (const m of serverMessageList(raw)) {
+    if (m.indicator === 'red') toast.error(m.message)
+    else if (m.indicator === 'green') toast.success(m.message)
+    else toast.warning(m.message)
+  }
+}
+
+// Như call() (cùng kết quả, cùng lỗi e.messages), thêm: hiện cảnh báo máy chủ gửi kèm khi thành công.
+export function callShowMessages(method, params = {}) {
+  return frappeRequest({ url: method, params, onServerMessages: showServerMessages })
+}
+
+// Màu trạng thái bài (Omni Content Item) và nền tảng (Omni Content Target)
+export const ITEM_THEME = {
+  'Nháp': 'gray',
+  'Chờ duyệt': 'orange',
+  'Đã lên lịch': 'blue',
+  'Đang xử lý': 'blue',
+  'Đã đăng': 'green',
+  'Đăng một phần': 'orange',
+  'Thất bại': 'red',
+  'Đã hủy': 'gray',
+}
+export const TARGET_THEME = {
+  'Chờ duyệt': 'orange',
+  'Đã lên lịch': 'blue',
+  'Đang xử lý': 'blue',
+  'Đăng thành công': 'green',
+  'Thất bại': 'red',
+  'Đã hủy': 'gray',
+}
+export const CAMPAIGN_THEME = {
+  'Nháp': 'gray',
+  'Đang chạy': 'green',
+  'Tạm dừng': 'orange',
+  'Kết thúc': 'gray',
+  'Đã hủy': 'gray',
+  'Có lỗi': 'red',
+}
+export const PLATFORMS = ['Facebook', 'Zalo OA', 'TikTok']
+export const FORMATS = {
+  Facebook: [
+    { label: 'Bài có link', value: 'fb_link' },
+    { label: 'Một ảnh', value: 'fb_photo' },
+    { label: 'Nhiều ảnh', value: 'fb_multi_photo' },
+  ],
+  'Zalo OA': [{ label: 'Bài viết OA', value: 'zalo_article' }],
+  TikTok: [{ label: 'Video (chưa hỗ trợ)', value: 'tiktok_video' }],
+}
+export const FUNNEL = ['Nhận biết', 'Cân nhắc', 'Chuyển đổi']
+
+// Số chưa có hiện "—", không hiện 0 gây hiểu nhầm (Prompt 6)
+export function dash(v, suffix = '') {
+  if (v === null || v === undefined || v === '') return '—'
+  if (typeof v === 'number') return v.toLocaleString('vi-VN') + suffix
+  return String(v) + suffix
+}
+
+export function fmtDateTime(value) {
+  if (!value) return '—'
+  const d = new Date(String(value).replace(' ', 'T'))
+  if (isNaN(d)) return String(value)
+  return d.toLocaleString('vi-VN', {
+    hour12: false,
+    day: '2-digit',
+    month: '2-digit',
+    year: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  })
+}
+
+// Giá trị cho <input type="datetime-local"> và ngược lại (giờ máy chủ = giờ Việt Nam)
+export function toInputDateTime(value) {
+  if (!value) return ''
+  return String(value).replace(' ', 'T').slice(0, 16)
+}
+export function fromInputDateTime(value) {
+  if (!value) return null
+  return value.replace('T', ' ') + ':00'
+}
+
+export function scoreClass(score, threshold) {
+  if (!score) return 'text-ink-gray-5'
+  return score >= threshold ? 'text-ink-green-3' : 'text-ink-red-3'
+}
+
+export function errorText(e) {
+  const msgs = e?.messages || []
+  if (msgs.length) return msgs.join('\n')
+  return e?.message || 'Có lỗi xảy ra'
+}
