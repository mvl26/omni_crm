+            {{ state?.status === 'cham_diem' ? `Đang chấm điểm bài ${(state.scores || []).length + 1}/${state.plan?.posts?.length || 0}…` : 'AI đang soạn…' }}
+          </div>
+          <div v-if="state?.status === 'loi'" class="rounded bg-surface-red-1 px-3 py-2 text-p-base text-ink-red-4">
+            {{ state.error }}
