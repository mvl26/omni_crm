+      </div>
+    </div>
+
+    <div class="flex-1 overflow-auto px-3 py-3 sm:px-5">
+      <div class="min-w-[720px]">
+        <div class="grid grid-cols-7 border-b border-outline-gray-2 text-center text-p-sm text-ink-gray-5">
+          <div v-for="w in WEEKDAYS" :key="w" class="py-1">{{ w }}</div>
+        </div>
+        <div class="grid grid-cols-7">
+          <div
+            v-for="cell in cells"
+            :key="cell.key"
+            class="min-h-[110px] border-b border-r border-outline-gray-1 p-1"
+            :class="cell.inMonth ? '' : 'bg-surface-gray-1'"
+          >
+            <div class="mb-1 text-right text-xs" :class="cell.isToday ? 'font-bold text-ink-blue-3' : 'text-ink-gray-5'">
+              {{ cell.day }}
+            </div>
+            <router-link
+              v-for="e in cell.entries"
+              :key="e.target"
+              :to="{ name: 'Marketing Post', params: { name: e.item } }"
+              class="mb-1 block truncate rounded px-1 py-0.5 text-xs"
+              :class="ENTRY_CLASS[TARGET_THEME[e.status] || 'gray']"
+              :title="`${e.title} · ${e.campaign_name || ''} · ${e.status}`"
+            >
+              {{ hhmm(e.scheduled_at) }} {{ short(e.platform) }} · {{ e.title }}
+            </router-link>
+          </div>
+        </div>
+      </div>
+      <div v-if="cal.loading" class="py-2 text-center text-p-sm text-ink-gray-5">Đang tải…</div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import LayoutHeader from '@/components/LayoutHeader.vue'
+import { Badge, FormControl, createResource } from 'frappe-ui'
+import { ref, computed, watch, onBeforeUnmount } from 'vue'
+import { globalStore } from '@/stores/global'
+import { API, PLATFORMS, TARGET_THEME } from '@/composables/marketing'
+
+const { $socket } = globalStore()
+const WEEKDAYS = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN']
+const ENTRY_CLASS = {
+  gray: 'bg-surface-gray-2 text-ink-gray-7',
+  orange: 'bg-surface-amber-2 text-ink-amber-4',
+  blue: 'bg-surface-blue-2 text-ink-blue-4',
+  green: 'bg-surface-green-2 text-ink-green-4',
+  red: 'bg-surface-red-2 text-ink-red-4',
+}
+
+const now = new Date()
+const month = ref(now.getMonth() + 1)
+const year = ref(now.getFullYear())
+const platform = ref('')
+const campaign = ref('')
+
+const campaigns = createResource({ url: API + 'list_campaigns', auto: true })
+const campaignOptions = computed(() => [
+  { label: 'Mọi chiến dịch', value: '' },
+  ...(campaigns.data || []).map((c) => ({ label: c.campaign_name, value: c.name })),
+])
+
+const cal = createResource({
+  url: API + 'get_calendar',
+  makeParams: () => ({
+    month: month.value,
+    year: year.value,
+    campaign: campaign.value || null,
+    platform: platform.value || null,
+  }),
+  auto: true,
+})
+watch([month, year, platform, campaign], () => cal.reload())
+
+function shift(n) {
+  let m = month.value + n
+  let y = year.value
+  if (m < 1) (m = 12), y--
+  if (m > 12) (m = 1), y++
+  month.value = m
+  year.value = y
+}
+function today() {
+  month.value = now.getMonth() + 1
+  year.value = now.getFullYear()
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+const hhmm = (v) => String(v || '').slice(11, 16)
+const short = (p) => ({ Facebook: 'FB', 'Zalo OA': 'Zalo', TikTok: 'TT' })[p] || p
+
+const cells = computed(() => {
+  const first = new Date(year.value, month.value - 1, 1)
+  const offset = (first.getDay() + 6) % 7 // thứ Hai đầu tuần
+  const start = new Date(year.value, month.value - 1, 1 - offset)
+  const byDay = {}
+  for (const e of cal.data || []) {
+    const k = String(e.scheduled_at).slice(0, 10)
+    ;(byDay[k] = byDay[k] || []).push(e)
+  }
+  const todayKey = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`
+  const out = []
+  const total = Math.ceil((offset + new Date(year.value, month.value, 0).getDate()) / 7) * 7
+  for (let i = 0; i < total; i++) {
+    const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i)
+    const key = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+    out.push({
+      key,
+      day: d.getDate(),
+      inMonth: d.getMonth() === month.value - 1,
+      isToday: key === todayKey,
+      entries: byDay[key] || [],
+    })
+  }
+  return out
+})
+
+// Realtime: worker đăng xong / lỗi -> làm mới lịch (gộp nhiều sự kiện trong 1 giây)
+let pending = null
+function onUpdate() {
+  if (pending) return
+  pending = setTimeout(() => {
+    pending = null
+    cal.reload()
+  }, 1000)
+}
+$socket?.on('oc_publish_update', onUpdate)
+onBeforeUnmount(() => {
+  $socket?.off('oc_publish_update', onUpdate)
+  if (pending) clearTimeout(pending)
+})
+</script>
