+<template>
+  <div v-if="data.data?.visible" class="flex flex-col gap-1.5 border-b px-4 py-3 sm:px-6">
+    <div class="mb-1 flex items-center gap-2">
+      <span class="text-base font-semibold text-ink-gray-9">{{ __('Marketing') }}</span>
+    </div>
+    <div v-for="row in rows" :key="row.label" class="flex items-start gap-2 text-base leading-5">
+      <div class="w-36 shrink-0 pt-0.5 text-sm text-ink-gray-5 sm:w-[106px]">{{ row.label }}</div>
+      <div class="min-w-0 flex-1 break-words">
+        <router-link
+          v-if="row.campaign && marketingEnabled"
+          :to="{ name: 'Marketing Campaigns', query: { campaign: row.campaign } }"
+          class="text-ink-gray-8 underline"
+        >
+          {{ row.value }}
+        </router-link>
+        <button
+          v-else-if="row.post"
+          class="text-left text-ink-gray-8 underline"
+          @click="showPost = true"
+        >
+          {{ row.value }}
+        </button>
+        <span v-else class="text-ink-gray-8">{{ row.value }}</span>
+      </div>
+    </div>
+  </div>
+  <PostDialog
+    v-if="data.data?.post"
+    v-model="showPost"
+    :name="data.data.post.name"
+    @saved="data.reload()"
+  />
+</template>
+
+<script setup>
+import PostDialog from '@/components/Marketing/PostDialog.vue'
+import { createResource } from 'frappe-ui'
+import { computed, ref, watch } from 'vue'
+import { dayMonth, utmLabel } from '@/utils/marketing'
+import { marketingEnabled } from '@/composables/marketing'
+
+const props = defineProps({ leadId: { type: String, required: true } })
+const showPost = ref(false)
+
+const data = createResource({
+  url: 'omni_crm.api.marketing_ui.lead_marketing',
+  makeParams: () => ({ lead: props.leadId }),
+  auto: true,
+})
+watch(
+  () => props.leadId,
+  () => data.reload(),
+)
+
+const rows = computed(() => {
+  const d = data.data
+  if (!d) return []
+  const out = []
+  if (d.campaign) out.push({ label: __('Chiến dịch'), value: d.campaign, campaign: d.campaign })
+  if (d.last_campaign && d.last_campaign !== d.campaign)
+    out.push({ label: __('Chiến dịch gần nhất'), value: d.last_campaign, campaign: d.last_campaign })
+  if (d.post)
+    out.push({
+      label: __('Bài đăng'),
+      value: [dayMonth(d.post.publish_at), d.post.platform, d.post.title].filter(Boolean).join(' · '),
+      post: true,
+    })
+  const utm = utmLabel(d.utm)
+  if (utm) out.push({ label: __('Kênh / UTM'), value: utm })
+  if (d.post?.funnel_stage) out.push({ label: __('Giai đoạn phễu'), value: d.post.funnel_stage })
+  if (d.landing_page) out.push({ label: __('Trang đích'), value: d.landing_page })
+  return out
+})
+</script>
