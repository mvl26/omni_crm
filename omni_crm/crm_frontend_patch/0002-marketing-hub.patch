+import { computed, reactive, ref, watch } from 'vue'
+import { useRoute } from 'vue-router'
+import {
+  NEEDS_ATTENTION,
+  WEEKDAYS,
+  dayMonth,
+  gridRange,
+  isoDate,
+  monthGrid,
+  postTheme,
+  postsByDay,
+  safeUrl,
+  shiftMonth,
+  timeOf,
+} from '@/utils/marketing'
+import { marketingState } from '@/composables/marketing'
+
+const route = useRoute()
+const now = new Date()
+const todayIso = isoDate(now)
+const view = reactive({ year: now.getFullYear(), month: now.getMonth() + 1 })
+const selectedDay = ref(todayIso)
+const campaignFilter = ref(route.query.campaign || '')
+const showPost = ref(false)
+const postName = ref('')
+
+const weeks = computed(() => monthGrid(view.year, view.month))
+const posts = createResource({
+  url: 'omni_crm.api.marketing_ui.calendar',
+  makeParams: () => ({ ...gridRange(weeks.value), campaign: campaignFilter.value || undefined }),
+  auto: true,
+})
+const campaigns = createResource({ url: 'omni_crm.api.marketing_ui.campaigns', auto: true })
+const campaignNames = computed(() => (campaigns.data || []).map((c) => ({ label: c.campaign_name, value: c.name })))
+const byDay = computed(() => postsByDay(posts.data))
+const dayPosts = computed(() => byDay.value[selectedDay.value] || [])
+const monthCount = computed(() => {
+  const prefix = `${view.year}-${String(view.month).padStart(2, '0')}`
+  return (posts.data || []).filter((p) => String(p.publish_at).startsWith(prefix)).length
+})
+
+watch([() => view.year, () => view.month, campaignFilter], () => posts.reload())
+
+function move(delta) {
+  Object.assign(view, shiftMonth(view.year, view.month, delta))
+  selectedDay.value = `${view.year}-${String(view.month).padStart(2, '0')}-01`
+}
+
+function today() {
+  Object.assign(view, { year: now.getFullYear(), month: now.getMonth() + 1 })
+  selectedDay.value = todayIso
+}
+
+function chipClass(status) {
+  const theme = postTheme(status)
+  return {
+    gray: 'bg-surface-gray-2 text-ink-gray-7',
+    blue: 'bg-surface-blue-1 text-ink-blue-3',
+    green: 'bg-surface-green-1 text-ink-green-3',
+    red: 'bg-surface-red-1 text-ink-red-4',
+    orange: 'bg-surface-amber-1 text-ink-amber-3',
+  }[theme]
+}
+
+function openPost(name) {
+  postName.value = name
+  showPost.value = true
+}
+</script>
