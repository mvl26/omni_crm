+++ b/frontend/src/components/Settings/Marketing/ContentVoiceSettings.vue
@@ -0,0 +1,244 @@
+<template>
+  <div class="flex h-full flex-col gap-6 px-6 py-8 text-ink-gray-8">
+    <div class="flex justify-between px-2">
+      <div class="flex flex-col gap-1 w-9/12">
+        <h2 class="flex gap-2 text-xl font-semibold leading-none h-5">
+          Nội dung &amp; giọng văn
+        </h2>
+        <p class="text-p-base text-ink-gray-6">
+          Trụ cột nội dung để phân loại bài, và giọng văn AI dùng khi viết bài.
+        </p>
+      </div>
+      <div class="flex items-center w-3/12 justify-end">
+        <Button
+          v-if="canEditMarketingSettings"
+          label="Mới"
+          icon-left="plus"
+          variant="solid"
+          @click="openNew"
+        />
+      </div>
+    </div>
+
+    <div class="flex-1 flex flex-col gap-6 overflow-y-auto">
+      <div class="flex flex-col">
+        <div class="flex items-center py-2 px-2 text-sm text-ink-gray-5">
+          <div class="w-4/12">Trụ cột</div>
+          <div class="w-6/12">Mô tả</div>
+          <div class="w-2/12 text-right">Đang dùng</div>
+        </div>
+        <div class="h-px border-t mx-2 border-outline-gray-modals" />
+        <div
+          v-if="!pillars.loading && !pillars.data?.length"
+          class="px-2 py-6 text-p-base text-ink-gray-5"
+        >
+          Chưa có trụ cột nội dung. Bấm "+ Mới" để thêm.
+        </div>
+        <template v-for="(p, i) in pillars.data || []" :key="p.name">
+          <div v-if="i" class="h-px border-t mx-2 border-outline-gray-modals" />
+          <div
+            class="flex items-center py-3 px-2 rounded hover:bg-surface-menu-bar cursor-pointer"
+            @click="openEdit(p)"
+          >
+            <div
+              class="w-4/12 text-p-base font-medium text-ink-gray-7 truncate pr-3"
+            >
+              {{ p.pillar_name }}
+            </div>
+            <div class="w-6/12 text-p-sm text-ink-gray-6 truncate pr-3">
+              {{ p.description || '—' }}
+            </div>
+            <div class="w-2/12 flex justify-end" @click.stop>
+              <Switch
+                :model-value="Boolean(p.is_active)"
+                size="sm"
+                :disabled="!canEditMarketingSettings"
+                @update:model-value="(v) => toggle(p, v)"
+              />
+            </div>
+          </div>
+        </template>
+      </div>
+
+      <div class="flex flex-col gap-2 px-2">
+        <div class="flex items-center justify-between">
+          <div class="flex flex-col">
+            <div class="text-p-base font-medium text-ink-gray-7">
+              Giọng văn thương hiệu
+            </div>
+            <div class="text-p-sm text-ink-gray-5">
+              Ví dụ: xưng "Miyano", gọi "anh/chị", lịch sự, ngắn gọn; không bịa
+              giá, số liệu, cam kết.
+            </div>
+          </div>
+          <Button
+            v-if="voiceDirty && canEditMarketingSettings"
+            label="Lưu"
+            variant="solid"
+            :loading="settings.setValue.loading"
+            @click="saveVoice"
+          />
+        </div>
+        <Textarea
+          v-model="voice"
+          :rows="6"
+          :disabled="!canEditMarketingSettings"
+        />
+      </div>
+    </div>
+
+    <Dialog
+      v-model="dialog.show"
+      :options="{ title: dialog.name ? 'Sửa trụ cột' : 'Trụ cột mới' }"
+    >
+      <template #body-content>
+        <div class="flex flex-col gap-3">
+          <FormControl
+            v-model="dialog.pillar_name"
+            label="Tên trụ cột"
+            :disabled="Boolean(dialog.name)"
+          />
+          <FormControl
+            v-model="dialog.description"
+            type="textarea"
+            label="Mô tả"
+          />
+        </div>
+      </template>
+      <template #actions>
+        <Button
+          variant="solid"
+          class="w-full"
+          label="Lưu"
+          :loading="busy"
+          @click="savePillar"
+        />
+      </template>
+    </Dialog>
+  </div>
+</template>
+
+<script setup>
+import { canEditMarketingSettings } from '@/composables/marketingHub'
+import {
+  Button,
+  Dialog,
+  FormControl,
+  Switch,
+  Textarea,
+  call,
+  createDocumentResource,
+  createListResource,
+  toast,
+} from 'frappe-ui'
+import { computed, reactive, ref, watch } from 'vue'
+
+const pillars = createListResource({
+  doctype: 'Omni Content Pillar',
+  fields: ['name', 'pillar_name', 'description', 'is_active'],
+  orderBy: 'pillar_name asc',
+  pageLength: 200,
+  auto: true,
+})
+
+const settings = createDocumentResource({
+  doctype: 'Omni Marketing Settings',
+  name: 'Omni Marketing Settings',
+  auto: true,
+})
+const voice = ref('')
+const savedVoice = ref('')
+watch(
+  () => settings.doc,
+  (d) => {
+    if (!d) return
+    voice.value = d.brand_voice || ''
+    savedVoice.value = voice.value
+  },
+  { immediate: true },
+)
+const voiceDirty = computed(() => voice.value !== savedVoice.value)
+
+function err(e) {
+  return e?.messages?.[0] || e?.message || 'Có lỗi'
+}
+
+function saveVoice() {
+  settings.setValue.submit(
+    { brand_voice: voice.value },
+    {
+      onSuccess: () => toast.success('Đã lưu giọng văn'),
+      onError: (e) => toast.error(err(e)),
+    },
+  )
+}
+
+const dialog = reactive({
+  show: false,
+  name: '',
+  pillar_name: '',
+  description: '',
+})
+const busy = ref(false)
+
+function openNew() {
+  Object.assign(dialog, {
+    show: true,
+    name: '',
+    pillar_name: '',
+    description: '',
+  })
+}
+function openEdit(p) {
+  if (!canEditMarketingSettings.value) return
+  Object.assign(dialog, {
+    show: true,
+    name: p.name,
+    pillar_name: p.pillar_name,
+    description: p.description || '',
+  })
+}
+
+async function savePillar() {
+  busy.value = true
+  try {
+    if (dialog.name) {
+      await call('frappe.client.set_value', {
+        doctype: 'Omni Content Pillar',
+        name: dialog.name,
+        fieldname: { description: dialog.description },
+      })
+    } else {
+      await call('frappe.client.insert', {
+        doc: {
+          doctype: 'Omni Content Pillar',
+          pillar_name: dialog.pillar_name,
+          description: dialog.description,
+          is_active: 1,
+        },
+      })
+    }
+    dialog.show = false
+    pillars.reload()
+    toast.success('Đã lưu trụ cột')
+  } catch (e) {
+    toast.error(err(e))
+  } finally {
+    busy.value = false
+  }
+}
+
+async function toggle(p, value) {
+  try {
+    await call('frappe.client.set_value', {
+      doctype: 'Omni Content Pillar',
+      name: p.name,
+      fieldname: 'is_active',
+      value: value ? 1 : 0,
+    })
+    pillars.reload()
+  } catch (e) {
+    toast.error(err(e))
+  }
+}
+</script>
diff --git a/frontend/src/components/Settings/Marketing/MarketingAISettings.vue b/frontend/src/components/Settings/Marketing/MarketingAISettings.vue
