+          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
+            <FormControl v-model="draft.pillar" type="select" label="Trụ cột" :options="pillarOptions" />
+            <FormControl v-model="draft.funnel_stage" type="select" label="Giai đoạn phễu" :options="['', ...FUNNEL]" />
+            <FormControl v-model="draft.platform" type="select" label="Nền tảng" :options="['Facebook', 'Zalo OA']" />
+            <FormControl v-model="draft.post_format" type="select" label="Định dạng" :options="FORMATS[draft.platform]" />
+            <FormControl v-model="draft.channel_account" type="select" label="Kênh" :options="channelOptions" />
+            <FormControl v-model="draft.when" type="datetime-local" label="Giờ đăng" />
+          </div>
+          <p class="text-p-sm text-ink-gray-5">Bài mới ở trạng thái Nháp. Mở bài để chấm điểm AI, thêm ảnh và gửi duyệt.</p>
+        </div>
