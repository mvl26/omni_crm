+        </div>
+        <div>
+          <Button :label="__('Thêm')" iconLeft="plus" :loading="adding" @click="add" />
+        </div>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { Button, FormControl, LoadingIndicator, Switch, call, createResource, toast } from 'frappe-ui'
+import { reactive, ref } from 'vue'
+import { errorText, marketingState } from '@/composables/marketing'
+
+const pillars = createResource({ url: 'omni_crm.api.marketing_ui.pillars', auto: true })
+const draft = reactive({ pillar_name: '', description: '' })
+const adding = ref(false)
+
+async function toggle(p, value) {
+  try {
+    await call('frappe.client.set_value', {
+      doctype: 'Omni Content Pillar',
+      name: p.name,
+      fieldname: 'enabled',
+      value: value ? 1 : 0,
+    })
+    pillars.reload()
+  } catch (e) {
+    toast.error(errorText(e))
+  }
+}
+
+async function add() {
+  const name = draft.pillar_name.trim()
+  if (!name) return
+  adding.value = true
+  try {
+    await call('frappe.client.insert', {
+      doc: { doctype: 'Omni Content Pillar', pillar_name: name, description: draft.description.trim(), enabled: 1 },
+    })
+    draft.pillar_name = ''
+    draft.description = ''
+    pillars.reload()
+    toast.success(__('Đã thêm trụ cột'))
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    adding.value = false
+  }
+}
+</script>
