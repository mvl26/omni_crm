+          <Switch
+            :modelValue="Boolean(p.enabled)"
+            size="sm"
+            :disabled="!marketingState.can_edit_pillar"
+            @update:modelValue="(v) => toggle(p, v)"
+          />
+        </div>
+      </div>
+      <div v-if="marketingState.can_edit_pillar" class="flex flex-col gap-2 rounded border border-dashed p-3">
