+<script setup>
+import LayoutHeader from '@/components/LayoutHeader.vue'
+import { Badge, Dialog, FormControl, createResource, call, toast } from 'frappe-ui'
+import { ref, computed, reactive } from 'vue'
+import { useRouter } from 'vue-router'
+import {
+  API,
+  api,
+  CAMPAIGN_THEME,
+  ITEM_THEME,
+  TARGET_THEME,
+  FORMATS,
+  FUNNEL,
+  fmtDateTime,
+  fromInputDateTime,
+  scoreClass,
+  errorText,
+} from '@/composables/marketing'
+
+const props = defineProps({ name: { type: String, required: true } })
+const router = useRouter()
+
+const detail = createResource({
+  url: API + 'campaign_detail',
+  makeParams: () => ({ name: props.name }),
+  auto: true,
+})
+const c = computed(() => detail.data?.campaign)
+const items = computed(() => detail.data?.items || [])
+const threshold = computed(() => detail.data?.threshold || 0)
+const pendingCount = computed(() => items.value.filter((i) => ['Nháp', 'Chờ duyệt'].includes(i.status)).length)
+const approveLabel = computed(() =>
+  detail.data?.require_approval && !detail.data?.is_manager ? 'Gửi duyệt cả chiến dịch' : 'Duyệt và lên lịch',
+)
+
+const results = ref([])
+const approving = ref(false)
+async function approveAll() {
+  approving.value = true
+  try {
+    results.value = await api('approve_campaign', { name: props.name })
+    detail.reload()
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    approving.value = false
+  }
+}
+
+const pillars = createResource({
+  url: 'frappe.client.get_list',
+  params: { doctype: 'Omni Content Pillar', filters: { is_active: 1 }, fields: ['name'], limit_page_length: 0 },
+  auto: true,
+})
+const pillarOptions = computed(() => ['', ...(pillars.data || []).map((p) => p.name)])
+const channels = createResource({ url: API + 'get_social_channels', auto: true })
+const channelOptions = computed(() =>
+  (channels.data || [])
+    .filter((a) => a.platform === draft.platform && a.name && a.platform !== 'TikTok')
+    .map((a) => ({ label: `${a.account_name} (${a.status})`, value: a.name })),
+)
+
+const showNew = ref(false)
+const saving = ref(false)
+const draft = reactive({})
+function openNew() {
+  Object.assign(draft, {
+    title: '',
+    caption: '',
+    pillar: '',
+    funnel_stage: '',
+    platform: 'Facebook',
+    post_format: 'fb_link',
+    channel_account: '',
+    when: '',
+  })
+  showNew.value = true
+}
+
+async function createPost() {
+  if (!draft.title || !draft.when) return toast.error('Nhập tiêu đề và giờ đăng')
+  saving.value = true
+  try {
+    const item = await call('frappe.client.insert', {
+      doc: {
