+          <FormControl v-model="form.s3_bucket" :label="__('Bucket')" :placeholder="'crm-media'" />
+          <FormControl v-model="form.s3_access_key" :label="__('Access key')" />
+          <FormControl
+            v-model="secret"
+            type="password"
+            :label="__('Secret key')"
+            :placeholder="settings.data?.secret_set ? __('Đã có, để trống nếu không đổi') : ''"
+          />
+          <FormControl v-model="form.s3_prefix" :label="__('Thư mục trong bucket')" />
+          <FormControl v-model="form.s3_region" :label="__('Region')" />
