+            <div class="text-xs text-ink-gray-5">
+              Chi phí AI phiên này: {{ state.cost_usd }} USD. Bài dưới {{ state.threshold }} điểm không được lên lịch.
+            </div>
+          </div>
+
+          <div v-if="state?.campaign" class="flex flex-col gap-2 rounded bg-surface-green-1 px-3 py-2 text-p-base">
+            <div>Đã tạo chiến dịch {{ state.campaign }}.</div>
+            <div v-for="r in state.results" :key="r.item" class="text-p-sm">
+              {{ r.title }}: <b>{{ r.status }}</b><span v-if="r.message" class="text-ink-red-3"> — {{ r.message }}</span>
+            </div>
+            <div>
+              <Button label="Mở chiến dịch" variant="solid" @click="openCampaign" />
+            </div>
+          </div>
+        </div>
+
+        <div v-if="!state?.campaign" class="flex flex-col gap-2">
+          <Textarea
+            v-model="text"
+            :rows="3"
+            :placeholder="state?.status === 'hoi_lai' ? 'Trả lời câu hỏi (hoặc bấm gợi ý ở trên)…' : 'Mô tả chiến dịch cần tạo…'"
+            :disabled="busy"
+          />
+          <div class="flex flex-wrap items-center gap-2">
+            <FileUploader
+              :uploadArgs="{ private: true }"
+              fileTypes=".pdf,.docx,.txt,.md,.png,.jpg,.jpeg,.webp"
+              @success="(f) => files.push(f)"
+            >
+              <template #default="{ openFileSelector, uploading }">
+                <Button
+                  :label="uploading ? 'Đang tải…' : 'Đính kèm tệp / ảnh'"
+                  icon-left="paperclip"
+                  :disabled="busy"
+                  @click="openFileSelector"
+                />
+              </template>
+            </FileUploader>
+            <Badge
+              v-for="(f, i) in files"
+              :key="f.file_url"
+              :label="f.file_name"
+              variant="subtle"
+              class="cursor-pointer"
+              @click="files.splice(i, 1)"
+            />
+            <div class="ml-auto flex gap-2">
+              <Button v-if="state" label="Phiên mới" :disabled="busy" @click="reset" />
+              <Button
+                v-if="state?.status === 'san_sang'"
+                label="Duyệt và lên lịch"
+                variant="solid"
+                :loading="creating"
+                @click="create"
+              />
+              <Button
+                v-else
+                label="Gửi"
+                variant="solid"
+                :loading="sending"
+                :disabled="busy || (!text.trim() && !files.length)"
+                @click="send"
+              />
+            </div>
+          </div>
+          <div v-if="state?.status === 'san_sang'" class="text-xs text-ink-gray-5">
+            Muốn sửa kế hoạch: gõ yêu cầu và bấm Gửi bên dưới thay vì duyệt.
+            <Button size="sm" variant="ghost" label="Gửi yêu cầu sửa" :disabled="!text.trim()" @click="send" />
+          </div>
+        </div>
+      </div>
+    </template>
+  </Dialog>
+</template>
+
+<script setup>
+import { Dialog, Badge, Textarea, FileUploader, LoadingIndicator, toast } from 'frappe-ui'
+import { ref, computed, watch, nextTick, onBeforeUnmount } from 'vue'
+import { useRouter } from 'vue-router'
+import { globalStore } from '@/stores/global'
+import { api, fmtDateTime, scoreClass, errorText } from '@/composables/marketing'
+
+const show = defineModel({ type: Boolean, default: false })
+const emit = defineEmits(['created'])
+const router = useRouter()
+const { $socket } = globalStore()
+
+const state = ref(null)
+const text = ref('')
+const files = ref([])
+const answers = ref({})
+const sending = ref(false)
+const creating = ref(false)
+const scroller = ref(null)
+let timer = null
+
+const busy = computed(() => ['dang_xu_ly', 'cham_diem'].includes(state.value?.status))
+const score = (i) => state.value?.scores?.[i]?.score ?? null
+
+function pick(qi, s) {
+  answers.value = { ...answers.value, [qi]: s }
+  const qs = state.value?.questions || []
+  text.value = qs
+    .map((q, i) => (answers.value[i] ? `${q.question} ${answers.value[i]}` : ''))
+    .filter(Boolean)
+    .join('\n')
+}
+
+async function refresh() {
+  if (!state.value?.session_id) return
+  try {
+    state.value = await api('planner_state', { session_id: state.value.session_id })
+  } catch (e) {
+    toast.error(errorText(e))
+    stopPolling()
+  }
+}
+
+function startPolling() {
+  stopPolling()
+  timer = setInterval(() => (busy.value ? refresh() : stopPolling()), 5000)
+}
+function stopPolling() {
+  if (timer) clearInterval(timer)
+  timer = null
+}
+
+async function send() {
+  sending.value = true
+  try {
+    state.value = await api('planner_send', {
+      text: text.value,
+      files: JSON.stringify(files.value.map((f) => f.file_url)),
+      session_id: state.value?.session_id || null,
+    })
+    text.value = ''
+    files.value = []
+    answers.value = {}
+    startPolling()
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    sending.value = false
+  }
+}
+
+async function create() {
+  creating.value = true
+  try {
+    state.value = await api('planner_create', { session_id: state.value.session_id })
+    toast.success('Đã tạo chiến dịch từ kế hoạch')
+    emit('created', state.value.campaign)
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    creating.value = false
+  }
+}
+
+function reset() {
+  stopPolling()
+  state.value = null
+  text.value = ''
+  files.value = []
+  answers.value = {}
+}
+
+function openCampaign() {
+  show.value = false
+  router.push({ name: 'Marketing Campaign', params: { name: state.value.campaign } })
+}
+
+function onUpdate(data) {
+  if (data?.session_id && data.session_id === state.value?.session_id) refresh()
+}
+$socket?.on('oc_plan_update', onUpdate)
+onBeforeUnmount(() => {
+  stopPolling()
+  $socket?.off('oc_plan_update', onUpdate)
+})
+
+watch(
+  () => [state.value?.turns?.length, state.value?.scores?.length, state.value?.status],
+  () => nextTick(() => scroller.value && (scroller.value.scrollTop = scroller.value.scrollHeight)),
+)
+</script>
