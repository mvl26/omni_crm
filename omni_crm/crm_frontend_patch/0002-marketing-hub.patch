+++ b/frontend/tests/unit/marketingServerMessages.test.js
@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest'
+import { serverMessageList } from '@/utils/serverMessages'
+
+// ADR 0033 việc V2: cảnh báo máy chủ gửi kèm khi lưu thành công (frappe.msgprint) phải hiện trên trang Marketing.
+describe('serverMessageList', () => {
+  it('đọc cảnh báo kho ảnh S3 như Frappe gửi (_server_messages)', () => {
+    const raw = [
+      JSON.stringify({
+        message:
+          'Kho ảnh S3: ghi ảnh không được (EndpointConnectionError). Ảnh vẫn lưu trên máy chủ CRM, sẽ tự đẩy lại trong vòng 1 giờ.',
+        indicator: 'orange',
+        alert: 1,
+      }),
+    ]
+    expect(serverMessageList(raw)).toEqual([
+      {
+        message:
+          'Kho ảnh S3: ghi ảnh không được (EndpointConnectionError). Ảnh vẫn lưu trên máy chủ CRM, sẽ tự đẩy lại trong vòng 1 giờ.',
+        indicator: 'orange',
+      },
+    ])
+  })
+  it('bỏ thẻ HTML, bỏ tin rỗng, nhận chuỗi không phải JSON', () => {
+    expect(
+      serverMessageList([
+        JSON.stringify({ message: '<b>Đã</b> lưu', indicator: 'green' }),
+        JSON.stringify({ message: '   ' }),
+        'tin thường',
+      ]),
+    ).toEqual([
+      { message: 'Đã lưu', indicator: 'green' },
+      { message: 'tin thường', indicator: '' },
+    ])
+  })
