+<script setup>
+import { Button, FormControl, LoadingIndicator, Switch, call, createResource, toast } from 'frappe-ui'
+import { computed, ref } from 'vue'
+import { errorText } from '@/composables/marketing'
+
+const CHECKS = ['content_publish_enabled', 'content_metrics_enabled', 's3_media_enabled', 's3_verify_tls']
+const form = ref({})
+const original = ref('')
+const secret = ref('')
+const saving = ref(false)
+const checking = ref(false)
+
+function load(data) {
+  const v = { ...(data?.values || {}) }
+  for (const f of CHECKS) v[f] = Boolean(Number(v[f]))
+  form.value = v
+  original.value = JSON.stringify(v)
+  secret.value = ''
+}
+
+const settings = createResource({
+  url: 'omni_crm.api.marketing_ui.settings',
+  auto: true,
+  onSuccess: load,
+})
+const dirty = computed(() => JSON.stringify(form.value) !== original.value || Boolean(secret.value))
+const channelOptions = computed(() => [
+  { label: __('Chưa chọn'), value: '' },
+  ...(settings.data?.channels || []).map((c) => ({ label: `${c.name} (${c.meta_page_name || c.meta_page_id || '–'})`, value: c.name })),
+])
+
+async function save() {
+  saving.value = true
+  try {
+    const values = { ...form.value }
+    for (const f of CHECKS) values[f] = values[f] ? 1 : 0
+    if (secret.value) values.s3_secret_key = secret.value
+    const data = await call('omni_crm.api.marketing_ui.save_settings', { values })
+    settings.setData(data)
+    load(data)
+    toast.success(__('Đã lưu thiết lập'))
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    saving.value = false
+  }
+}
+
+async function checkStorage() {
+  checking.value = true
+  try {
+    const res = await call('omni_crm.api.media.check_storage')
+    toast.success(__('Kho ảnh S3 dùng được: bucket {0}', [res?.bucket || '']))
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    checking.value = false
+  }
+}
+</script>
