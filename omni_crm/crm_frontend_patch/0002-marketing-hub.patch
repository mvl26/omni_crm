diff --git a/frontend/src/utils/serverMessages.js b/frontend/src/utils/serverMessages.js
new file mode 100644
index 0000000..cbed91c
--- /dev/null
+++ b/frontend/src/utils/serverMessages.js
@@ -0,0 +1,20 @@
+// Đọc cảnh báo máy chủ gửi kèm (_server_messages của Frappe) thành danh sách gọn (ADR 0033, việc V2).
+// `raw`: mảng chuỗi JSON như frappeRequest đưa cho onServerMessages. Trả [{ message, indicator }], bỏ thẻ HTML.
+export function serverMessageList(raw = []) {
+  const out = []
+  for (const item of raw || []) {
+    let m = item
+    if (typeof m === 'string') {
+      try {
+        m = JSON.parse(m)
+      } catch {
+        m = { message: m }
+      }
+    }
+    const text = String(m?.message ?? '')
+      .replace(/<[^>]*>/g, '')
+      .trim()
+    if (text) out.push({ message: text, indicator: m?.indicator || '' })
+  }
+  return out
+}
