diff --git a/frontend/src/utils/marketing.js b/frontend/src/utils/marketing.js
new file mode 100644
index 0000000..f42f454
--- /dev/null
+++ b/frontend/src/utils/marketing.js
@@ -0,0 +1,185 @@
+// Hàm thuần cho Marketing Hub trong /crm (omni_crm ADR 0031). Không gọi máy chủ, có vitest.
+
+export const POST_STATUS_THEME = {
+  'Nháp': 'gray',
+  'Đã lên lịch': 'blue',
+  'Đang đăng': 'orange',
+  'Đã đăng': 'green',
+  'Lỗi': 'red',
+  'Cần kiểm': 'orange',
+  'Bỏ lỡ': 'orange',
+  'Đã huỷ': 'gray',
+}
+
+export const CAMPAIGN_STATUS_THEME = {
+  'Nháp': 'gray',
+  'Đang chạy': 'green',
+  'Tạm dừng': 'orange',
+  'Kết thúc': 'blue',
+  'Đã huỷ': 'gray',
+}
+
+export const CAMPAIGN_STATUSES = ['Nháp', 'Đang chạy', 'Tạm dừng', 'Kết thúc', 'Đã huỷ']
+export const CAMPAIGN_PLATFORMS = ['Meta', 'Google', 'Website', 'Liên hệ chủ động', 'Đa kênh']
+export const POST_PLATFORMS = ['Facebook', 'Zalo OA', 'Khác']
+export const PUBLISH_MODES = ['Đăng tay', 'Tự động']
+export const FUNNEL_STAGES = ['Nhận biết', 'Cân nhắc', 'Chuyển đổi']
+export const NEEDS_ATTENTION = ['Lỗi', 'Cần kiểm', 'Bỏ lỡ']
+export const LOCKED_STATUSES = ['Đang đăng', 'Đã đăng', 'Cần kiểm']
+export const WEEKDAYS = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN']
+
+const POST_CODE_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/
+
+export function postTheme(status) {
+  return POST_STATUS_THEME[status] || 'gray'
+}
+
+export function campaignTheme(status) {
+  return CAMPAIGN_STATUS_THEME[status] || 'gray'
+}
+
+// Mã bài như máy chủ (ADR 0029): bỏ khoảng trắng hai đầu, chữ thường; hợp lệ khi chỉ có chữ, số, gạch ngang, tối đa 40.
+export function normalizePostCode(value) {
+  return String(value || '').trim().toLowerCase()
+}
+
+export function isValidPostCode(value) {
+  const code = normalizePostCode(value)
+  return code.length > 0 && code.length <= 40 && POST_CODE_RE.test(code)
+}
+
+// Các nút đổi trạng thái được hiện cho một bài, cùng luật với máy chủ (marketing/content_posts.py).
+export function postActions(status, canEdit) {
+  if (!canEdit) return []
+  const actions = []
+  if (['Nháp', 'Lỗi', 'Bỏ lỡ'].includes(status)) actions.push('schedule')
+  if (status === 'Đã lên lịch') actions.push('unschedule')
+  if (['Nháp', 'Đã lên lịch', 'Lỗi', 'Bỏ lỡ'].includes(status)) actions.push('cancel')
+  if (status === 'Đã huỷ') actions.push('reopen')
+  if (status === 'Cần kiểm') actions.push('resolve')
+  return actions
+}
+
+export function isLocked(status) {
+  return LOCKED_STATUSES.includes(status)
+}
+
+// Chỉ link http(s) mới được làm liên kết (link bài, trang đích nhập tay có thể là bất kỳ chữ nào).
+export function safeUrl(url) {
+  const value = String(url || '').trim()
+  return /^https?:\/\/[^\s]+$/i.test(value) ? value : ''
+}
+
+function pad(n) {
+  return String(n).padStart(2, '0')
+}
+
+export function isoDate(d) {
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+}
+
+// Lưới tháng bắt đầu thứ Hai: các tuần, mỗi tuần 7 ngày {date, day, inMonth}. `month` từ 1 đến 12.
+export function monthGrid(year, month) {
+  const first = new Date(year, month - 1, 1)
+  const last = new Date(year, month, 0)
+  const lead = (first.getDay() + 6) % 7 // số ngày tháng trước trước thứ Hai đầu tiên (thứ Hai = 0)
+  const tail = 6 - ((last.getDay() + 6) % 7) // số ngày tháng sau tới hết Chủ nhật cuối
+  const total = lead + last.getDate() + tail
+  const weeks = []
+  for (let i = 0; i < total; i++) {
+    const d = new Date(year, month - 1, 1 - lead + i)
+    if (i % 7 === 0) weeks.push([])
+    weeks[weeks.length - 1].push({ date: isoDate(d), day: d.getDate(), inMonth: d.getMonth() === month - 1 })
+  }
+  return weeks
+}
+
+// Khoảng thời gian cần tải cho lưới tháng (cả ngày đầu, cuối lưới).
+export function gridRange(weeks) {
+  const firstDay = weeks[0][0].date
+  const lastWeek = weeks[weeks.length - 1]
+  return { start: `${firstDay} 00:00:00`, end: `${lastWeek[lastWeek.length - 1].date} 23:59:59` }
+}
+
+export function shiftMonth(year, month, delta) {
+  const d = new Date(year, month - 1 + delta, 1)
+  return { year: d.getFullYear(), month: d.getMonth() + 1 }
+}
+
+// `publish_at` dạng "YYYY-MM-DD HH:MM:SS" của máy chủ: ngày và giờ, không đổi múi giờ.
+export function dayOf(datetime) {
+  return String(datetime || '').slice(0, 10)
+}
+
+export function timeOf(datetime) {
+  return String(datetime || '').slice(11, 16)
+}
+
+export function dayMonth(datetime) {
+  const d = dayOf(datetime)
+  return d ? `${d.slice(8, 10)}/${d.slice(5, 7)}` : ''
+}
+
+export function postsByDay(posts) {
+  const map = {}
+  for (const p of posts || []) {
+    const key = dayOf(p.publish_at)
+    if (!key) continue
+    ;(map[key] = map[key] || []).push(p)
+  }
+  for (const key of Object.keys(map)) {
+    map[key].sort((a, b) => String(a.publish_at).localeCompare(String(b.publish_at)))
+  }
+  return map
+}
+
+// 4200 -> "4.2k"; null -> "–".
+export function compact(n) {
+  if (n === null || n === undefined || n === '') return '–'
+  const v = Number(n)
+  if (!Number.isFinite(v)) return '–'
+  if (Math.abs(v) >= 1000000) return `${trim1(v / 1000000)}M`
+  if (Math.abs(v) >= 1000) return `${trim1(v / 1000)}k`
+  return String(Math.round(v))
+}
+
+function trim1(v) {
+  return v.toFixed(1).replace(/\.0$/, '')
+}
+
+// "facebook / spd-pk-2611" từ các trường UTM của Lead; "" khi không có.
+export function utmLabel(utm) {
+  if (!utm) return ''
+  return [utm.source, utm.campaign].filter(Boolean).join(' / ')
+}
+
+// Giá trị cho ô datetime-local từ "YYYY-MM-DD HH:MM:SS" và ngược lại.
+export function toInputDatetime(value) {
+  const v = String(value || '')
+  return v ? v.slice(0, 16).replace(' ', 'T') : ''
+}
+
+export function fromInputDatetime(value) {
+  const v = String(value || '')
+  if (!v) return ''
+  const s = v.replace('T', ' ')
+  return s.length === 16 ? `${s}:00` : s
+}
+
+// Bài trống cho hộp "Thêm bài": giờ đăng mặc định 09:00 ngày mai, cách đăng mặc định Tự động (CRM tự đăng lên Page).
+export function emptyPost(campaign, now = new Date()) {
+  const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 9, 0, 0)
+  return {
+    post_code: '',
+    campaign: campaign || '',
+    title: '',
+    platform: 'Facebook',
+    publish_mode: 'Tự động',
+    publish_at: `${isoDate(d)} 09:00:00`,
+    content: '',
+    image: '',
+    pillar: '',
+    funnel_stage: '',
+    landing_url: '',
+  }
+}
diff --git a/frontend/tests/unit/marketing.test.js b/frontend/tests/unit/marketing.test.js
