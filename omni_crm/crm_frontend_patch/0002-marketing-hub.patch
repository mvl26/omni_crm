@@ -0,0 +1,136 @@
+<template>
+  <Dialog v-model="show" :options="{ size: '3xl' }">
+    <template #body>
+      <div class="flex flex-col gap-4 px-6 pb-6 pt-5 text-ink-gray-8">
+        <div class="flex items-center justify-between">
+          <h3 class="text-xl font-semibold text-ink-gray-9">
+            {{ isNew ? __('Tạo chiến dịch') : __('Sửa chiến dịch') }}
+          </h3>
+          <Button variant="ghost" icon="x" @click="show = false" />
+        </div>
+        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
+          <FormControl
+            v-model="form.campaign_name"
+            class="sm:col-span-2"
+            :label="__('Tên chiến dịch')"
+            :disabled="!isNew"
+          />
+          <FormControl
+            v-model="form.status"
+            type="select"
+            :label="__('Trạng thái')"
+            :options="CAMPAIGN_STATUSES"
+          />
+          <FormControl
+            v-model="form.platform"
+            type="select"
+            :label="__('Nền tảng')"
+            :options="CAMPAIGN_PLATFORMS"
+          />
+          <FormControl
+            v-model="form.utm_campaign"
+            :label="__('utm_campaign')"
+            :placeholder="'spd-pk-2611'"
+            :description="__('Bắt buộc khi chiến dịch có bài đăng')"
+          />
+          <FormControl v-model="form.owner_team" :label="__('Nhóm phụ trách')" />
+          <FormControl v-model="form.start_date" type="date" :label="__('Ngày bắt đầu')" />
+          <FormControl v-model="form.end_date" type="date" :label="__('Ngày kết thúc')" />
+          <FormControl v-model="form.lead_target" type="number" :label="__('Mục tiêu số Lead')" />
+          <FormControl
+            v-model="form.landing_url"
+            class="sm:col-span-3"
+            :label="__('Trang đích')"
+            :placeholder="'https://yhct.miyano.com.vn/spd/'"
+            :description="__('Link đích mặc định của các bài trong chiến dịch')"
+          />
+          <FormControl
+            v-model="form.objective"
+            type="textarea"
+            class="sm:col-span-3"
+            :rows="2"
+            :label="__('Mục tiêu')"
+          />
+          <FormControl
+            v-model="form.target_audience"
+            type="textarea"
+            class="sm:col-span-3"
+            :rows="2"
+            :label="__('Khách hàng đích')"
+          />
+          <FormControl v-model="form.budget" type="number" :label="__('Ngân sách dự kiến')" />
+          <FormControl v-model="form.spend" type="number" :label="__('Chi phí thực tế (nhập tay)')" />
+        </div>
+        <div class="flex justify-end gap-2 border-t pt-4">
+          <Button :label="__('Đóng')" @click="show = false" />
+          <Button
+            variant="solid"
+            :label="isNew ? __('Tạo chiến dịch') : __('Lưu')"
+            :loading="saving"
+            @click="save"
+          />
+        </div>
+      </div>
+    </template>
+  </Dialog>
+</template>
+
+<script setup>
+import { Button, Dialog, FormControl, toast } from 'frappe-ui'
+import { computed, ref, watch } from 'vue'
+import { CAMPAIGN_PLATFORMS, CAMPAIGN_STATUSES } from '@/utils/marketing'
+import { errorText, marketingCall } from '@/composables/marketing'
+
+const props = defineProps({
+  campaign: { type: Object, default: null },
+})
+const emit = defineEmits(['saved'])
+const show = defineModel({ type: Boolean, default: false })
+
+const FIELDS = [
+  'campaign_name',
+  'platform',
+  'status',
+  'utm_campaign',
+  'start_date',
+  'end_date',
+  'owner_team',
+  'objective',
+  'target_audience',
+  'landing_url',
+  'lead_target',
+  'budget',
+  'spend',
+]
+const form = ref({})
+const saving = ref(false)
+const isNew = computed(() => !props.campaign?.name)
+
+watch(show, (v) => {
+  if (!v) return
+  const base = { platform: 'Đa kênh', status: 'Nháp' }
+  const src = props.campaign || {}
+  form.value = Object.fromEntries(FIELDS.map((f) => [f, src[f] ?? base[f] ?? '']))
+})
+
+async function save() {
+  if (!String(form.value.campaign_name || '').trim()) {
+    toast.error(__('Nhập tên chiến dịch'))
+    return
+  }
+  saving.value = true
+  try {
+    const name = await marketingCall('save_campaign', {
+      values: form.value,
+      name: props.campaign?.name || undefined,
+    })
+    toast.success(__('Đã lưu chiến dịch'))
+    emit('saved', name)
+    show.value = false
+  } catch (e) {
+    toast.error(errorText(e))
+  } finally {
+    saving.value = false
+  }
+}
+</script>
