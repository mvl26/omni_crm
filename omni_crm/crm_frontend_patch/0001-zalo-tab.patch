+import { describe, expect, it } from 'vitest'
+import {
+  MAX_COMMAND_CHARS,
+  canSend,
+  hasWrites,
+  linkTab,
+  recordUrl,
+  shown,
+  statusText,
+  toolText,
+} from '@/utils/assistantChat'
+
+describe('recordUrl', () => {
+  it('Lead mở trong CRM, nhật ký và việc mở trong desk', () => {
+    expect(recordUrl('CRM Lead', 'CRM-LEAD-2026-00003')).toBe(
+      '/crm/leads/CRM-LEAD-2026-00003',
+    )
+    expect(recordUrl('Omni Care Log', 'OCL-2026-0000001')).toBe(
+      '/app/omni-care-log/OCL-2026-0000001',
+    )
+    expect(recordUrl('CRM Task', 'TASK 1')).toBe('/app/crm-task/TASK%201')
+  })
+  it('loại lạ hoặc thiếu tên thì không có link', () => {
+    expect(recordUrl('User', 'x')).toBe('')
+    expect(recordUrl('CRM Task', '')).toBe('')
+  })
+})
+
+describe('canSend', () => {
+  it('cần phiên, không chờ, có chữ, không quá dài', () => {
+    expect(canSend('ghi log', false, 'AST-1')).toBe(true)
+    expect(canSend('  ', false, 'AST-1')).toBe(false)
+    expect(canSend('x', true, 'AST-1')).toBe(false)
+    expect(canSend('x', false, '')).toBe(false)
+    expect(canSend('x'.repeat(MAX_COMMAND_CHARS + 1), false, 'AST-1')).toBe(
+      false,
+    )
+  })
+})
+
+describe('nhãn', () => {
+  it('trạng thái và tool có nhãn tiếng Việt, lạ thì giữ nguyên', () => {
+    expect(statusText('Pending')).toBe('Chờ duyệt')
+    expect(statusText('Limit')).toBe('Chưa làm (chạm trần)')
+    expect(statusText('X')).toBe('X')
+    expect(toolText('create_care_log')).toBe('Ghi nhật ký chăm sóc')
+    expect(toolText('find_lead')).toBe('find_lead')
+  })
+  it('giá trị rỗng hiện (trống)', () => {
+    expect(shown('')).toBe('(trống)')
+    expect(shown(null)).toBe('(trống)')
+    expect(shown(0)).toBe('0')
+  })
+  it('hasWrites chỉ tính thao tác đã ghi', () => {
+    expect(hasWrites([{ status: 'Pending' }, { status: 'Denied' }])).toBe(false)
+    expect(hasWrites([{ status: 'Success' }])).toBe(true)
+    expect(hasWrites(null)).toBe(false)
+  })
+})
+
+describe('linkTab', () => {
+  it('chỉ mở tab có thật của trang Lead trong CRM', () => {
+    expect(linkTab({ tab: 'calls' })).toBe('calls')
+    expect(linkTab({ tab: 'Tasks' })).toBe('tasks')
+    expect(linkTab({ tab: 'javascript:alert(1)' })).toBe('')
+    expect(linkTab({ doctype: 'Omni Care Log' })).toBe('')
+    expect(linkTab(null)).toBe('')
+  })
+})
