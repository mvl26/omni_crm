diff --git a/frontend/src/utils/assistantChat.js b/frontend/src/utils/assistantChat.js
new file mode 100644
index 0000000..22a3c2b
--- /dev/null
+++ b/frontend/src/utils/assistantChat.js
@@ -0,0 +1,70 @@
+// Hàm thuần cho tab "Trợ lý" (omni_crm V3-05): đường dẫn bản ghi, trạng thái thao tác, kiểm câu lệnh.
+// Dữ liệu và mọi kiểm tra quyền nằm ở máy chủ (omni_crm.assistant.api); ở đây chỉ hiển thị.
+
+export const MAX_COMMAND_CHARS = 2000
+
+const DESK_ROUTES = {
+  'Omni Care Log': 'omni-care-log',
+  'CRM Task': 'crm-task',
+}
+
+// Link tới bản ghi vừa tạo/sửa: Lead mở trong CRM, bản ghi khác mở trong desk.
+export function recordUrl(doctype, name) {
+  if (!doctype || !name) return ''
+  const id = encodeURIComponent(name)
+  if (doctype === 'CRM Lead') return `/crm/leads/${id}`
+  const route = DESK_ROUTES[doctype]
+  return route ? `/app/${route}/${id}` : ''
+}
+
+// Tab của trang Lead trong Frappe CRM để mở khi bấm vào bản ghi trợ lý vừa tạo (máy chủ gửi `tab`).
+// Không mở giao diện quản trị /app. Bản ghi không có tab trong CRM (nhật ký chăm sóc) thì không bấm được.
+const CRM_TABS = ['calls', 'tasks', 'notes', 'activity', 'emails', 'comments']
+
+export function linkTab(link) {
+  const tab = String(link?.tab || '').toLowerCase()
+  return CRM_TABS.includes(tab) ? tab : ''
+}
+
+const STATUS_TEXT = {
+  Success: 'Đã ghi',
+  Pending: 'Chờ duyệt',
+  Denied: 'Bị từ chối',
+  Error: 'Lỗi',
+  Limit: 'Chưa làm (chạm trần)',
+  Rejected: 'Đã bỏ',
+}
+
+export function statusText(status) {
+  return STATUS_TEXT[status] || status || ''
+}
+
+const TOOL_TEXT = {
+  create_care_log: 'Ghi nhật ký chăm sóc',
+  upsert_task: 'Tạo/sửa việc',
+  update_lead_fields: 'Đề xuất sửa Lead',
+  create_call_log: 'Ghi cuộc gọi',
+}
+
+export function toolText(tool) {
+  return TOOL_TEXT[tool] || tool || ''
+}
+
+// Có gửi được câu lệnh không: không rỗng, không quá dài, không đang chờ, phiên đã mở.
+export function canSend(text, busy, session) {
+  const t = (text || '').trim()
+  return (
+    Boolean(session) && !busy && t.length > 0 && t.length <= MAX_COMMAND_CHARS
+  )
+}
+
+// Có thao tác nào đã ghi vào CSDL (để các tab khác của trang Lead tự nạp lại).
+export function hasWrites(actions) {
+  return (actions || []).some((a) => a && a.status === 'Success')
+}
+
+// Giá trị hiển thị trong thẻ duyệt: rỗng thì ghi rõ "(trống)".
+export function shown(value) {
+  const v = value == null ? '' : String(value)
+  return v === '' ? '(trống)' : v
+}
diff --git a/frontend/src/utils/callNotes.js b/frontend/src/utils/callNotes.js
new file mode 100644
index 0000000..6383c9d
--- /dev/null
+++ b/frontend/src/utils/callNotes.js
@@ -0,0 +1,25 @@
+// Nội dung ghi chú của cuộc gọi (omni_crm V3-05, ADR 0016 mục 14): FCRM Note.content là HTML của trình soạn thảo.
+// Chuyển thành chữ thuần để hiện trong thẻ cuộc gọi (không chèn HTML thô vào trang: nội dung có thể do bot hoặc khách tạo).
+
+export function htmlToText(html) {
+  if (!html) return ''
+  const withBreaks = String(html)
+    .replace(/<br\s*\/?>/gi, '\n')
+    .replace(/<\/(p|div|li|h[1-6])>/gi, '\n')
+  const doc = new DOMParser().parseFromString(withBreaks, 'text/html')
+  return (doc.body.textContent || '')
+    .replace(/\u00a0/g, ' ')
+    .replace(/\n{3,}/g, '\n\n')
+    .trim()
+}
+
+// Danh sách {name, title, text} từ `_notes` của get_call_log; bỏ ghi chú rỗng.
+export function callNotes(notes) {
+  return (notes || [])
+    .map((n) => ({
+      name: n?.name || '',
+      title: n?.title || '',
+      text: htmlToText(n?.content),
+    }))
+    .filter((n) => n.text || n.title)
+}
diff --git a/frontend/src/utils/messengerThread.js b/frontend/src/utils/messengerThread.js
new file mode 100644
index 0000000..7ce28f5
--- /dev/null
+++ b/frontend/src/utils/messengerThread.js
@@ -0,0 +1,377 @@
+// Hàm thuần cho tab "Messenger" (omni_crm, ADR 0023): đính kèm (ảnh / video / âm thanh / tệp đã lưu trong CRM), kiểm tệp
+// sale chọn để gửi, liên kết hộp thư Meta Business Suite, mẫu tin nhắn (ADR 0026). Gom bong bóng, nhãn, giờ và luật URL
+// dùng lại `zaloThread.js` (không sửa tệp đó). Không phụ thuộc Vue/DOM.
+import {
+  INLINE_IMAGE_TYPES,
+  attachmentLabel,
+  canSubmit,
+  fileExtension,
+  fileNameFromUrl,
+  isInlineImageUrl,
+  isSafeUrl,
+} from '@/utils/zaloThread'
+
+/** Loại kênh trong tín hiệu realtime `omni_inbox_update` và trong `Omni Channel.channel_type`. */
+export const MESSENGER_CHANNEL = 'Meta Messenger'
+
+const MB = 1024 * 1024
+const LOCAL_FILE = /^\/(?:private\/)?files\//
+
+// --- Đính kèm: tệp khách gửi đã được chép vào File của CRM; tệp sale gửi cũng là File của Lead ---
+
+/**
+ * Đường dẫn tệp trong CRM (/files, /private/files) dùng được, hoặc '' nếu bị từ chối. Cùng luật nghiêm ngặt với ảnh nội tuyến
+ * (`isInlineImageUrl`): không `..` (kể cả %2e), không `//`, không `\`, ký tự điều khiển hay khoảng trắng.
+ * `allowSpace`: nhận dấu cách thường (tên tệp Frappe có thể chứa) và trả đường đã mã hóa dấu cách thành %20 (như máy chủ
+ * `media.is_safe_link`); chỉ dùng cho liên kết tải, KHÔNG dùng cho src của ảnh/video/âm thanh.
+ */
+export function localFileUrl(url, { allowSpace = false } = {}) {
+  const value = String(url || '')
+  if (!LOCAL_FILE.test(value)) return ''
+  const candidate = allowSpace ? value.replace(/ /g, '%20') : value
+  return isInlineImageUrl(candidate) ? candidate : ''
+}
+
+/** Tên tệp cuối đường dẫn nội bộ (bỏ query, giải mã %xx); '' nếu không có. */
+export function localFileName(url) {
+  const path = String(url || '')
+    .split(/[?#]/)[0]
+    .replace(/\/+$/, '')
+  const seg = path.slice(path.lastIndexOf('/') + 1)
+  try {
+    return decodeURIComponent(seg).slice(0, 80)
+  } catch {
+    return seg.slice(0, 80)
+  }
+}
+
+/** Cách vẽ theo loại (type của Messenger, rồi mime khi type thiếu hoặc là 'file'): 'image' | 'video' | 'audio' | ''. */
+export function mediaKind(type, mime) {
+  const t = String(type || '').toLowerCase()
+  if (INLINE_IMAGE_TYPES.includes(t)) return 'image'
+  if (t === 'video' || t === 'audio') return t
+  if (t && t !== 'file') return ''
+  const m = String(mime || '').toLowerCase()
+  if (m.startsWith('image/')) return 'image'
+  if (m.startsWith('video/')) return 'video'
+  if (m.startsWith('audio/')) return 'audio'
+  return ''
+}
+
+function nameOf(att, url, local) {
+  const name = String(att?.name || '').trim()
+  if (name && !/^(?:https?:\/\/|\/)/i.test(name)) return name.slice(0, 80) // không in URL dài
+  return (
+    (local ? localFileName(url) : fileNameFromUrl(url)) ||
+    attachmentLabel(att?.type)
+  )
+}
+
+/**
+ * Mô hình hiển thị đính kèm của tab Messenger: [{ index, kind, url, src, text }].
+ * - kind 'image' | 'video' | 'audio': vẽ thẳng (<img>, <video controls>, <audio controls>), CHỈ khi url là /files hoặc
+ *   /private/files sạch (cùng gốc với CRM, người xem đã đăng nhập); `src` = `url`.
+ * - kind 'link': liên kết mở/tải tệp (đường /files có thể có dấu cách, hoặc http(s) sạch); `src` rỗng.
+ * - kind 'note': tệp không lưu được vào CRM (url rỗng, máy chủ ghi `note`): chỉ chữ "tên (ghi chú)", không liên kết.
+ * Mục có URL lạ (javascript:, data:, //host, `..`...) bị bỏ. `text` là chữ thuần, hiển thị bằng nội suy (không chèn HTML thô).
+ */
+export function messengerAttachmentViews(list) {
+  if (!Array.isArray(list)) return []
+  const out = []
+  for (const att of list) {
+    if (!att || typeof att !== 'object') continue
+    const url = String(att.url || '')
+    if (!url) {
+      const note = String(att.note || '')
+        .trim()
+        .slice(0, 200)
+      if (!note) continue
+      const name =
+        String(att.name || '')
+          .trim()
+          .slice(0, 80) || attachmentLabel(att.type)
+      out.push({
+        index: out.length,
+        kind: 'note',
+        url: '',
+        src: '',
+        text: `${name} (${note})`,
+      })
+      continue
+    }
+    const kind = mediaKind(att.type, att.mime)
+    const src = kind ? localFileUrl(url) : ''
+    if (src) {
+      out.push({
+        index: out.length,
+        kind,
+        url: src,
+        src,
+        text: nameOf(att, src, true),
+      })
+      continue
+    }
+    const local = localFileUrl(url, { allowSpace: true })
+    const href = local || (isSafeUrl(url) ? url : '')
+    if (!href) continue
+    out.push({
+      index: out.length,
+      kind: 'link',
+      url: href,
+      src: '',
+      text: nameOf(att, href, Boolean(local)),
+    })
+  }
+  return out
+}
+
+// --- Realtime ---
+
+/** Tín hiệu realtime `omni_inbox_update` có thuộc hội thoại Messenger đang xem không (payload chỉ có {lead, channels}). */
+export function isMessengerUpdate(payload, lead) {
+  if (!payload || !lead || payload.lead !== lead) return false
+  const channels = payload.channels
+  return (
+    !Array.isArray(channels) ||
+    !channels.length ||
+    channels.includes(MESSENGER_CHANNEL)
+  )
+}
+
+// --- Hộp thư Meta Business Suite (thay nút "Mở chat Zalo OA") ---
+
+/** Hộp thư chung của Meta Business Suite: dùng khi máy chủ chưa có mã Page để mở đúng hộp thư của Page. */
+export const META_INBOX_URL = 'https://business.facebook.com/latest/inbox/all/'
+const META_INBOX_PREFIX = 'https://business.facebook.com/'
+
+/**
+ * Liên kết hộp thư Meta của khách (`contact.inbox_url` do máy chủ dựng), hoặc '' nếu không hợp lệ. Chỉ nhận đúng
+ * https://business.facebook.com/...: không userinfo, không cổng, không `\`/ký tự điều khiển/khoảng trắng.
+ */
+export function metaInboxUrl(contact) {
+  const value = String(contact?.inbox_url ?? '')
+  if (!value.startsWith(META_INBOX_PREFIX) || !isSafeUrl(value)) return ''
+  let u
+  try {
+    u = new URL(value)
+  } catch {
+    return ''
+  }
+  if (
+    u.protocol !== 'https:' ||
+    u.hostname !== 'business.facebook.com' ||
+    u.username ||
+    u.password ||
+    u.port
+  )
+    return ''
+  return u.href
+}
+
+/** Mở hộp thư Meta (đúng Page nếu có liên kết hợp lệ, nếu không thì hộp thư chung) ở tab mới; true nếu gọi được window.open. */
