+            <div
+              :class="[
+                'max-w-[85%] rounded-lg px-3 py-1.5 text-base text-ink-gray-9 shadow-sm',
+                bubbleSide(msg) === 'right'
+                  ? 'bg-blue-100'
+                  : 'bg-surface-gray-2',
+                msg.status === 'Failed' || msg.status === 'Blocked'
+                  ? 'border border-red-400'
+                  : '',
+              ]"
+            >
+              <div class="mb-0.5 text-xs text-ink-gray-5">
+                {{ senderLabel(msg) }}
+              </div>
+              <div
+                v-if="displayText(msg)"
+                class="whitespace-pre-wrap break-words"
+              >
+                {{ displayText(msg) }}
+              </div>
+              <div
+                v-for="att in attachmentViews(msg.attachments)"
+                :key="att.index"
+                class="mt-1 text-sm"
+              >
+                <a
+                  v-if="att.src && !brokenImages[`${msg.name}:${att.index}`]"
+                  :href="att.url"
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  class="block"
+                  :title="__('Mở ảnh gốc')"
+                >
+                  <img
+                    :src="att.src"
+                    :alt="__(att.label)"
+                    loading="lazy"
+                    referrerpolicy="no-referrer"
+                    class="max-h-60 max-w-[240px] rounded object-contain"
+                    @error="brokenImages[`${msg.name}:${att.index}`] = true"
+                  />
+                </a>
+                <a
+                  v-else
+                  :href="att.url"
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  class="text-ink-blue-3 underline"
+                  >{{ att.src ? __(att.label) : att.text }}</a
+                >
+              </div>
+              <div
+                v-if="msg.sandbox"
+                class="mt-1 text-xs italic text-ink-gray-6"
+              >
+                {{ __('Thử nghiệm (sandbox), chưa gửi tới khách') }}
+              </div>
+              <div v-if="statusText(msg)" class="mt-1 text-xs text-ink-red-3">
+                {{ statusText(msg) }}
+              </div>
+              <div class="mt-0.5 text-right text-xs text-ink-gray-5">
+                {{ timeLabel(msg.at) }}
+              </div>
+            </div>
+          </div>
+        </div>
+      </template>
+    </div>
+
+    <div
+      v-if="contact"
+      class="border-t px-3 py-2 text-sm text-ink-gray-7 sm:px-10"
+    >
+      <div class="flex flex-wrap items-center gap-2">
+        <Button :label="__('Mở chat Zalo OA')" @click="openChat" />
+        <span v-if="panelMode === 'direct' && contactNames">{{
+          __('Mở chat với {0}', [contactNames])
+        }}</span>
+      </div>
+      <!-- Dự phòng khi thiếu mã Zalo hoặc mã OA: không mở thẳng được hội thoại, phải tìm tay -->
+      <div
+        v-if="panelMode === 'fallback'"
+        class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1"
+      >
+        <span>{{
+          __(
+            'Chưa mở thẳng được hội thoại. Trong danh sách chat, tìm khách theo tên hoặc mã Zalo:',
+          )
+        }}</span>
+        <span v-if="contactNames" class="font-medium text-ink-gray-9">{{
+          contactNames
+        }}</span>
+        <template v-if="contact.zalo_user_id">
+          <span :title="contact.zalo_user_id">{{
+            __('Mã') + ' ' + shortZaloId(contact.zalo_user_id)
+          }}</span>
+          <Button
+            size="sm"
+            variant="ghost"
+            :label="__('Sao chép')"
+            @click="copyId"
+          />
+        </template>
+      </div>
+      <div v-if="contact.name_note" class="mt-1 text-xs text-ink-gray-5">
+        {{ contact.name_note }}
+      </div>
+    </div>
+
+    <div class="border-t px-3 py-2.5 sm:px-10">
+      <div
+        v-if="!compose.can_send"
+        class="mb-2 rounded bg-surface-gray-2 px-3 py-2 text-sm text-ink-gray-7"
+      >
+        {{ compose.reason }}
+      </div>
+      <div
+        v-else-if="compose.paid && compose.message"
+        class="mb-2 rounded border border-amber-400 px-3 py-2 text-sm text-ink-gray-8"
+      >
+        {{ compose.message }}
+      </div>
+      <div
+        v-if="compose.sandbox && compose.linked"
+        class="mb-1 text-xs text-ink-gray-5"
+      >
+        {{
+          __('Chế độ thử: tin gửi chỉ được ghi lại, không gửi thật tới khách.')
+        }}
+      </div>
+      <!-- V3-07: quỹ tin ngoài khung 48 giờ, máy chủ chỉ trả khi khách đã quá 48 giờ không nhắn -->
+      <div
+        v-if="compose.quota"
+        class="mb-1 text-xs"
+        :class="
+          compose.quota.level === 'ok' ? 'text-ink-gray-5' : 'text-ink-red-3'
+        "
+      >
+        {{ compose.quota.text }}
+      </div>
+      <div
+        v-if="compose.can_request_phone"
+        class="mb-2 flex flex-wrap items-center gap-2 text-sm text-ink-gray-7"
+      >
+        <Button
+          size="sm"
+          :label="__('Xin số điện thoại')"
+          :loading="requestingPhone"
+          @click="requestPhone"
+        />
+        <span>{{
+          __('Gửi thẻ để khách bấm chia sẻ số điện thoại qua Zalo')
+        }}</span>
+      </div>
+      <!-- V3-09: ảnh / tệp đã chọn, chờ gửi -->
+      <div
+        v-if="pickedFile"
+        class="mb-2 flex items-center gap-2 rounded bg-surface-gray-2 px-2 py-1 text-sm text-ink-gray-8"
+      >
+        <span class="truncate">📎 {{ pickedFile.name }}</span>
+        <span class="shrink-0 text-xs text-ink-gray-5">{{ pickedHint }}</span>
+        <Button
+          size="sm"
+          variant="ghost"
+          :label="__('Bỏ')"
+          :disabled="sending"
+          @click="clearFile"
+        />
+      </div>
+      <div class="flex items-end gap-2">
+        <input
+          ref="fileInput"
+          type="file"
+          class="hidden"
+          :accept="compose.media_accept || ''"
+          @change="onPickFile"
+        />
+        <Button
+          v-if="compose.can_send_media"
+          :title="__('Gửi ảnh hoặc tệp (JPG, PNG, PDF, DOC, DOCX, CSV)')"
+          :disabled="sending"
+          @click="fileInput?.click()"
+        >
+          📎
+        </Button>
+        <Textarea
+          v-model="text"
+          type="textarea"
+          class="min-h-8 w-full"
+          :rows="3"
+          :disabled="!compose.can_send"
+          :placeholder="
+            pickedFile
+              ? __('Chú thích (không bắt buộc)')
+              : __('Nhập tin trả lời Zalo')
+          "
+          @keydown.enter.exact.prevent="submit()"
+        />
+        <Button
+          variant="solid"
+          :label="__('Gửi qua Zalo')"
+          :loading="sending"
+          :disabled="
+            !canSubmitWithFile(
+              compose,
+              text,
+              pickedFile,
+              sending,
+              compose.max_chars,
+            )
+          "
+          @click="submit()"
+        />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import {
+  computed,
+  nextTick,
+  onBeforeUnmount,
+  onMounted,
+  reactive,
+  ref,
+  watch,
+} from 'vue'
+import {
+  Button,
+  LoadingIndicator,
+  Textarea,
+  call,
+  createResource,
+  toast,
+} from 'frappe-ui'
+import { globalStore } from '@/stores/global'
+import {
+  POLL_MS,
+  ZALO_EVENT,
+  botCard,
+  bubbleSide,
+  canSubmit,
+  canSubmitWithFile,
+  checkMediaFile,
+  dayLabel,
+  groupByDay,
+  chatPanelMode,
+  copyToClipboard,
+  isRelevantUpdate,
+  sendWithConfirm,
+  openOaChat,
+  shortZaloId,
+  attachmentViews,
+  displayText,
+  sourceOf,
+  timeLabel,
+} from '@/utils/zaloThread'
+
+const props = defineProps({
+  doctype: { type: String, required: true },
+  docname: { type: String, required: true },
+})
+
+const { $socket } = globalStore()
+
+const text = ref('')
+const sending = ref(false)
+const requestingPhone = ref(false)
+const fileInput = ref(null)
+const pickedFile = ref(null) // V3-09: ảnh/tệp sale chọn, chưa gửi
+let uploaded = null // { file, url }: tệp đã tải lên CRM, dùng lại nếu sale bấm gửi lần nữa (không tải trùng)
+const scroller = ref(null)
+const loadFailed = ref(false)
+const brokenImages = reactive({}) // ảnh tải lỗi: rơi về liên kết có nhãn
+
+// Dữ liệu và mọi guard (khung 48 giờ, hạn mức, từ chối liên hệ, sandbox) nằm ở máy chủ: omni_crm.api.zalo_tab.
+const conversation = createResource({
+  url: 'omni_crm.api.zalo_tab.get_conversation',
+  makeParams: () => ({ doctype: props.doctype, name: props.docname }),
+  auto: true,
+  onSuccess: () => {
+    loadFailed.value = false
+    nextTick(scrollToBottom)
+  },
+  onError: () => {
+    loadFailed.value = true
+  },
+})
+
+const messages = computed(() => conversation.data?.messages || [])
+const groups = computed(() => groupByDay(messages.value))
+const compose = computed(
+  () =>
+    conversation.data?.compose || {
+      can_send: false,
+      reason: '',
+      paid: false,
+      message: '',
+      sandbox: false,
+      quota: null,
+      linked: false,
+    },
+)
+
+// Nhắn từ trang chính thức của Zalo OA (OA gói Cơ bản không gửi được qua API). Zalo không mở thẳng hội thoại theo
+// tham số, nên chỉ hiện thông tin để nhân viên tự tìm khách. Zalo chặn nhúng trang chat vào khung (đã thử): chỉ có nút mở cửa sổ riêng.
+const contact = computed(() => conversation.data?.contact || null)
+
+// Tóm tắt, ý định, mức gấp, điểm do bot phân tích ghi vào Lead (omni_crm.api.zalo_tab._bot).
+const bot = computed(() => botCard(conversation.data?.bot))
+function chipLabel(chip) {
+  if (chip.key === 'intent') return __('Ý định: {0}', [chip.value])
+  if (chip.key === 'urgency') return __('Mức gấp: {0}', [chip.value])
+  return __('Điểm: {0}', [chip.value])
+}
+const panelMode = computed(() => chatPanelMode(contact.value))
+const contactNames = computed(() => {
+  const c = contact.value
+  if (!c) return ''
+  return [...new Set([c.lead_name, c.display_name].filter(Boolean))].join(' / ')
+})
+
+function openChat() {
+  if (!openOaChat(contact.value)) toast.error(__('Trình duyệt chặn cửa sổ mới'))
+}
+
+async function copyId() {
+  const res = await copyToClipboard(contact.value?.zalo_user_id)
+  if (res.ok) toast.success(__('Đã sao chép mã Zalo'))
+  else toast.error(__('Không sao chép được, hãy chọn và chép tay'))
+}
+
+function senderLabel(msg) {
+  const source = sourceOf(msg)
+  if (source === 'customer') return msg.sender
+  if (source === 'bot') return `${__('Bot')} · ${msg.sender}`
+  if (source === 'echo') return __('Nhân viên (ngoài hệ thống)')
+  return `${__('Sale')} · ${msg.sender}`
+}
+
+function statusText(msg) {
+  if (msg.status === 'Queued' || msg.queued) return __('Đang gửi...')
+  if (msg.status === 'Blocked') return msg.error || __('Bị chặn, chưa gửi')
+  if (msg.status === 'Failed') return msg.error || __('Gửi lỗi')
+  return ''
+}
+
+function scrollToBottom() {
+  const el = scroller.value
+  if (el) el.scrollTop = el.scrollHeight
+}
+
+function reload() {
+  if (sending.value) return
+  conversation.reload()
+}
+
+const pickedHint = computed(() => {
+  const kind = pickedFile.value ? checkMediaFile(pickedFile.value).kind : ''
+  if (kind === 'file')
+    return __('Tệp: lời nhắn (nếu có) gửi thành tin riêng trước')
+  if (kind === 'image') return __('Ảnh trên 1 MB sẽ được nén trước khi gửi')
+  return ''
+})
+
+function onPickFile(event) {
+  const file = event.target.files?.[0]
+  event.target.value = '' // chọn lại cùng tệp vẫn kích hoạt change
+  if (!file) return
+  const check = checkMediaFile(file)
+  if (check.error) {
+    toast.error(__(check.error))
+    return
+  }
+  pickedFile.value = file
+}
+
+function clearFile() {
+  pickedFile.value = null
+}
+
+// Tải tệp lên CRM (gắn vào Lead/Deal đang mở, riêng tư), trả file_url. Máy chủ kiểm lại tệp thuộc Lead trước khi gửi Zalo.
+async function uploadToCrm(file) {
+  if (uploaded?.file === file) return uploaded.url
+  const form = new FormData()
+  form.append('file', file, file.name)
+  form.append('doctype', props.doctype)
+  form.append('docname', props.docname)
+  form.append('is_private', '1')
+  const resp = await fetch('/api/method/upload_file', {
+    method: 'POST',
+    headers: {
+      Accept: 'application/json',
+      'X-Frappe-CSRF-Token': window.csrf_token,
+    },
+    body: form,
+  })
+  const data = await resp.json().catch(() => ({}))
+  const url = data?.message?.file_url
+  if (!resp.ok || !url) {
+    let msg = ''
+    try {
+      msg = JSON.parse(
+        JSON.parse(data._server_messages || '[]')[0] || '{}',
+      ).message
+    } catch (e) {
+      msg = ''
+    }
+    throw new Error(msg || __('Không tải được tệp lên CRM'))
+  }
+  uploaded = { file, url }
+  return url
+}
+
+async function submitFile() {
+  const file = pickedFile.value
+  sending.value = true
+  try {
+    const fileUrl = await uploadToCrm(file)
+    const res = await sendWithConfirm(
+      (value, confirmPaid) =>
+        call('omni_crm.api.zalo_tab.send_attachment', {
+          doctype: props.doctype,
+          name: props.docname,
+          file_url: fileUrl,
+          text: value,
+          confirm_paid: confirmPaid,
+        }),
+      (warning) => window.confirm(`${warning}\n\n${__('Bạn vẫn muốn gửi?')}`),
+      text.value,
+    )
+    if (res?.status === 'Blocked') {
+      toast.error(res.reason || __('Tin bị chặn, chưa gửi'))
+    } else if (res) {
+      text.value = ''
+      pickedFile.value = null
+      uploaded = null
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] ||
+        error?.message ||
+        __('Không gửi được ảnh/tệp qua Zalo'),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+async function submit() {
+  if (pickedFile.value) {
+    if (
+      canSubmitWithFile(
+        compose.value,
+        text.value,
+        pickedFile.value,
+        sending.value,
+        compose.value.max_chars,
+      )
+    )
+      await submitFile()
+    return
+  }
+  if (
+    !canSubmit(
+      compose.value,
+      text.value,
+      sending.value,
+      compose.value.max_chars,
+    )
+  )
+    return
+  const body = text.value
+  sending.value = true // giữ cờ này đến khi CẢ hai lần gọi (nếu có xác nhận phí) kết thúc: không gửi đôi
+  try {
+    const res = await sendWithConfirm(
+      (value, confirmPaid) =>
+        call('omni_crm.api.zalo_tab.send', {
+          doctype: props.doctype,
+          name: props.docname,
+          text: value,
+          confirm_paid: confirmPaid,
+        }),
+      (warning) => window.confirm(`${warning}\n\n${__('Bạn vẫn muốn gửi?')}`),
+      body,
+    )
+    if (res?.status === 'Blocked') {
+      toast.error(res.reason || __('Tin bị chặn, chưa gửi'))
+    } else if (res) {
+      text.value = ''
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] || error?.message || __('Không gửi được tin Zalo'),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// V3-07: gửi thẻ request_user_info; điều kiện (chưa có số, trong 48 giờ, chưa xin trong phiên) kiểm ở máy chủ.
+async function requestPhone() {
+  if (requestingPhone.value) return
+  requestingPhone.value = true
+  try {
+    await call('omni_crm.api.zalo_tab.request_phone', {
+      doctype: props.doctype,
+      name: props.docname,
+    })
+    toast.success(__('Đã gửi thẻ xin số điện thoại'))
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] || error?.message || __('Không gửi được thẻ xin số'),
+    )
+  } finally {
+    requestingPhone.value = false
+    conversation.reload()
+  }
+}
+
+// Realtime: payload chỉ có {lead, channels}, không có nội dung tin; nhận tín hiệu rồi tải lại qua API có kiểm quyền.
+let timer = null
+let poll = null
+function onUpdate(payload) {
+  if (!isRelevantUpdate(payload, conversation.data?.lead)) return
+  clearTimeout(timer)
+  timer = setTimeout(reload, 500)
+}
+
+function onVisible() {
+  if (!document.hidden) reload()
+}
+
+onMounted(() => {
+  $socket?.on(ZALO_EVENT, onUpdate)
+  // Dự phòng khi mất kết nối realtime; tab trình duyệt ẩn thì không thăm dò, hiện lại thì tải ngay.
+  poll = setInterval(() => {
+    if (!document.hidden) reload()
+  }, POLL_MS)
+  document.addEventListener('visibilitychange', onVisible)
+})
+
+onBeforeUnmount(() => {
+  $socket?.off(ZALO_EVENT, onUpdate)
+  clearInterval(poll)
+  document.removeEventListener('visibilitychange', onVisible)
+  clearTimeout(timer)
+})
+
+watch(
+  () => [props.doctype, props.docname],
+  () => conversation.reload(),
+)
+</script>
