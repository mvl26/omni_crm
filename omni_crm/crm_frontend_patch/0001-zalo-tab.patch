+describe('canSubmit', () => {
+  const open = { can_send: true }
+  it('cần khung mở, có chữ, không đang gửi', () => {
+    expect(canSubmit(open, 'xin chào', false)).toBe(true)
+    expect(canSubmit(open, '   ', false)).toBe(false)
+    expect(canSubmit(open, 'x', true)).toBe(false)
+    expect(canSubmit({ can_send: false }, 'x', false)).toBe(false)
+    expect(canSubmit(null, 'x', false)).toBe(false)
+  })
+  it('chặn tin quá dài', () => {
+    expect(canSubmit(open, 'a'.repeat(6001), false, 6000)).toBe(false)
+    expect(canSubmit(open, 'a'.repeat(6000), false, 6000)).toBe(true)
+  })
+})
