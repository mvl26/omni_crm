+  for (const att of list) {
+    if (!att || typeof att !== 'object') continue
+    const url = String(att.url || '')
+    const sticker = String(att.type || '').toLowerCase() === 'sticker'
+    if (!url && sticker) {
+      out.push({
+        index: out.length,
+        kind: 'sticker',
+        url: '',
+        src: '',
+        text: 'Sticker',
+        note: String(att.note || '')
+          .trim()
+          .slice(0, 200),
+      })
+      continue
+    }
+    if (!url) {
+      const note = String(att.note || '')
+        .trim()
+        .slice(0, 200)
+      if (!note) continue
+      const name =
+        String(att.name || '')
+          .trim()
+          .slice(0, 80) || attachmentLabel(att.type)
+      out.push({
+        index: out.length,
+        kind: 'note',
+        url: '',
+        src: '',
+        text: `${name} (${note})`,
+      })
+      continue
+    }
+    const kind = mediaKind(att.type, att.mime)
+    const src = kind ? localFileUrl(url) : ''
+    if (src && sticker) {
+      out.push({
+        index: out.length,
+        kind: 'sticker',
+        url: src,
+        src,
+        text: nameOf(att, src, true),
+        note: '',
+      })
+      continue
+    }
+    if (src) {
+      out.push({
+        index: out.length,
+        kind,
+        url: src,
+        src,
+        text: nameOf(att, src, true),
+      })
+      continue
+    }
+    const local = localFileUrl(url, { allowSpace: true })
+    const href = local || (isSafeUrl(url) ? url : '')
+    if (!href) continue
+    out.push({
+      index: out.length,
+      kind: 'link',
+      url: href,
+      src: '',
+      text: nameOf(att, href, Boolean(local)),
+    })
+  }
+  return out
+}
