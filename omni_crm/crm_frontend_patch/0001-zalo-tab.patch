+++ b/frontend/src/composables/messenger.js
@@ -0,0 +1,399 @@
+import { call, createResource } from 'frappe-ui'
+import { computed, onScopeDispose, reactive, ref, watch } from 'vue'
+import {
+  FORWARD_SEARCH_DEBOUNCE_MS,
+  filterTemplates,
+  forwardQuery,
+  forwardTargetList,
+  micErrorText,
+  needsTemplateSearch,
+  pickRecorderMime,
+  stickerList,
+  stickerPackList,
+  stickerQuery,
+  templateList,
+  voiceBaseMime,
+  voiceExtension,
+  voiceMaxSeconds,
+} from '@/utils/messengerThread'
+
+// Tab Messenger (ADR 0023) chỉ hiện khi app omni_crm đã cài và công tắc không bị tắt (Omni Settings.messenger_tab_disabled).
+// Nếu omni_crm không có trên site (hoặc bản omni_crm cũ chưa có API này), lời gọi lỗi và tab đơn giản không hiện (CRM chạy như cũ).
+export const messengerEnabled = ref(false)
+
+createResource({
+  url: 'omni_crm.api.messenger_tab.tab_state',
+  cache: 'Omni Messenger Tab Enabled',
+  auto: true,
+  onSuccess: (data) => {
+    messengerEnabled.value = Boolean(data?.enabled)
+  },
+  onError: () => {
+    messengerEnabled.value = false
+  },
+})
+
+/**
+ * Mẫu tin nhắn của tab Messenger (ADR 0026): một resource cho mỗi tab (tab được tạo lại theo Lead/Deal), chỉ tải khi
+ * bảng chọn mở lần đầu, không thăm dò. Máy chủ đã lọc, sắp xếp và điền sẵn theo Lead và người dùng. Lỗi tải hiện ngay
+ * trong bảng chọn (có nút thử lại), không bật thông báo chung.
+ */
+export function useMessengerTemplates(getParams) {
+  const resource = createResource({
+    url: 'omni_crm.api.messenger_tab.get_templates',
+    makeParams: () => getParams(),
+    onError: () => {},
+  })
+  const query = ref('')
+  const items = computed(() => templateList(resource.data))
+  const shown = computed(() => filterTemplates(items.value, query.value))
+  const showSearch = computed(() => needsTemplateSearch(items.value))
+
+  function load() {
+    if (resource.loading || resource.fetched) return
+    resource.fetch().catch(() => {}) // lỗi đã nằm ở resource.error
+  }
+
+  function reset() {
+    resource.reset()
+    query.value = ''
+  }
+
+  return { resource, query, items, shown, showSearch, load, reset }
+}
+
+/** Ngừng gõ chừng này mili giây thì mới tìm sticker. */
+export const STICKER_SEARCH_DEBOUNCE_MS = 400
+
+const STICKER_API = 'omni_crm.api.messenger_tab.'
+const PENDING = Object.freeze({ loading: true, items: [], error: '' })
+
+/**
+ * Kho sticker của Meta cho bảng chọn sticker (ADR 0027), đệm theo từng tab (không phụ thuộc Lead): danh sách bộ tải khi bảng
+ * chọn mở lần đầu, sticker của một bộ khi bấm vào bộ đó, tìm kiếm khi ngừng gõ (từ 2 ký tự). Kết quả tốt giữ đến khi tab đóng;
+ * kết quả có `error` (vd. sandbox, thiếu App Secret) hoặc lời gọi lỗi thì lần mở / bấm / gõ / "Thử lại" sau gọi lại.
+ * `view`: { mode: 'packs' | 'pack' | 'search' | 'hint', loading, items, error } cho phần thân bảng chọn.
+ */
+export function useMessengerStickers() {
+  const cache = reactive({}) // 'packs' | 'pack:<mã bộ>' | 'search:<từ khóa>' -> { loading, items, error }
+  const query = ref('')
+  const pack = ref(null) // bộ đang xem: { id, name }
+  const search = computed(() => stickerQuery(query.value))
+  let timer = null
+
+  function fetchList(key, method, params, parse) {
+    const hit = cache[key]
+    if (hit && (hit.loading || !hit.error)) return
+    cache[key] = { ...PENDING }
+    call(STICKER_API + method, params)
+      .then((res) => {
+        cache[key] = { loading: false, ...parse(res) }
+      })
+      .catch((error) => {
+        cache[key] = {
+          loading: false,
+          items: [],
+          error:
+            error?.messages?.[0] ||
+            error?.message ||
+            'Không tải được sticker của Meta',
+        }
+      })
+  }
+
+  const searchKey = (q) => `search:${q.toLowerCase()}`
+  const packKey = (id) => `pack:${id}`
+
+  /** Tải phần đang xem nếu chưa có (hoặc lần trước lỗi). */
+  function load() {
+    const { q, ready } = search.value
+    if (q) {
+      if (ready) fetchList(searchKey(q), 'sticker_search', { q }, stickerList)
+    } else if (pack.value) {
+      fetchList(
+        packKey(pack.value.id),
+        'sticker_pack',
+        { pack: pack.value.id },
+        stickerList,
+      )
+    } else {
+      fetchList('packs', 'sticker_packs', {}, stickerPackList)
+    }
+  }
+
+  const view = computed(() => {
+    const { q, ready } = search.value
+    if (q && !ready)
+      return { mode: 'hint', loading: false, items: [], error: '' }
+    if (q) return { mode: 'search', ...(cache[searchKey(q)] || PENDING) }
+    if (pack.value)
+      return { mode: 'pack', ...(cache[packKey(pack.value.id)] || PENDING) }
+    return { mode: 'packs', ...(cache.packs || PENDING) }
+  })
+
+  watch(
+    () => search.value.q,
+    () => {
+      clearTimeout(timer)
+      if (search.value.ready)
+        timer = setTimeout(load, STICKER_SEARCH_DEBOUNCE_MS)
+      else load() // ô tìm trống: về danh sách bộ / bộ đang xem
+    },
+  )
+  onScopeDispose(() => clearTimeout(timer))
+
+  /** Mở bảng chọn: xóa ô tìm, giữ bộ đang xem. */
+  function open() {
+    query.value = ''
+    load()
+  }
+
+  function openPack(item) {
+    pack.value = { id: item.id, name: item.name }
+    load()
+  }
+
+  function back() {
+    pack.value = null
+    load()
+  }
+
+  return { query, pack, view, open, openPack, back, load }
+}
+
+/**
+ * Ghi âm trong trình duyệt cho tab Messenger (ADR 0027 đợt 2): xin micro, ghi bằng MediaRecorder (kiểu đầu tiên trình duyệt
+ * nhận trong `VOICE_MIMES`), tự dừng ở `getMaxSeconds()` giây, nghe lại bằng object URL. Không gửi gì: tab tải `voice.blob`
+ * lên CRM rồi gọi `send_voice`.
+ * `voice`: { phase: 'idle' | 'starting' | 'recording' | 'stopping' | 'recorded', elapsed (giây), blob, mime (kiểu gốc, vd.
+ * audio/webm), url (object URL để nghe lại) }. Dừng / hủy / tab đóng: luôn tắt micro (dừng mọi track) và thu hồi object URL.
+ * `onError(câu chưa dịch)`: micro bị chặn / không có, trình duyệt không hỗ trợ, bản ghi trống.
+ */
+export function useVoiceRecorder({ getMaxSeconds, onError } = {}) {
+  const voice = reactive({
+    phase: 'idle',
+    elapsed: 0,
+    blob: null,
+    mime: '',
+    url: '',
+  })
+  let stream = null
+  let recorder = null
+  let chunks = []
+  let timer = null
+  let startedAt = 0
+  let max = 0
+  let token = 0 // tăng mỗi lần bắt đầu / hủy: kết quả xin micro đến muộn của lần trước bị bỏ
+
+  const fail = (message) => onError?.(message)
+
+  function stopTracks() {
+    if (stream) for (const track of stream.getTracks()) track.stop()
+    stream = null
+  }
+
+  function measure() {
+    voice.elapsed = Math.min(max, (Date.now() - startedAt) / 1000)
+  }
+
+  /** Về trạng thái chờ: tắt micro, bỏ bản ghi, thu hồi object URL. */
+  function reset() {
+    clearInterval(timer)
+    timer = null
+    stopTracks()
+    if (voice.url) URL.revokeObjectURL(voice.url)
+    recorder = null
+    chunks = []
+    Object.assign(voice, {
+      phase: 'idle',
+      elapsed: 0,
+      blob: null,
+      mime: '',
+      url: '',
+    })
+  }
+
+  /** Xin micro rồi bắt đầu ghi; chỉ khi đang chờ (không ghi đè bản ghi đang có). */
+  async function start() {
+    if (voice.phase !== 'idle') return
+    const devices = globalThis.navigator?.mediaDevices
+    const Recorder = globalThis.MediaRecorder
+    if (typeof devices?.getUserMedia !== 'function' || !Recorder) {
+      fail(
+        globalThis.isSecureContext === false
+          ? 'Ghi âm chỉ dùng được khi mở CRM bằng HTTPS.'
+          : 'Trình duyệt này không hỗ trợ ghi âm. Hãy dùng Chrome, Edge, Firefox hoặc Safari bản mới.',
+      )
+      return
+    }
+    const mime = pickRecorderMime((m) => Recorder.isTypeSupported?.(m))
+    if (!mime) {
+      fail(
+        'Trình duyệt này không ghi được định dạng âm thanh mà máy chủ nhận (WebM, Ogg, MP4).',
+      )
+      return
+    }
+    const mine = ++token
+    voice.phase = 'starting'
+    let media
+    try {
+      media = await devices.getUserMedia({ audio: true })
+    } catch (error) {
+      if (mine !== token) return // đã hủy trong lúc chờ
+      voice.phase = 'idle'
+      fail(micErrorText(error))
+      return
+    }
+    if (mine !== token) {
+      // đã hủy (hoặc tab đóng) trong lúc chờ cấp quyền: tắt micro ngay
+      for (const track of media.getTracks()) track.stop()
+      return
+    }
+    stream = media
+    let rec
+    try {
+      rec = new Recorder(media, { mimeType: mime })
+    } catch {
+      reset()
+      fail('Trình duyệt không bắt đầu ghi âm được.')
+      return
+    }
+    recorder = rec
+    chunks = []
+    rec.ondataavailable = (event) => {
+      if (rec === recorder && event.data?.size) chunks.push(event.data)
+    }
+    rec.onstop = () => {
+      if (rec !== recorder) return // đã hủy: bỏ dữ liệu
+      clearInterval(timer)
+      timer = null
+      stopTracks()
+      const type = voiceExtension(rec.mimeType) ? rec.mimeType : mime
+      const blob = new Blob(chunks, { type: voiceBaseMime(type) })
+      chunks = []
+      recorder = null
+      if (!blob.size) {
+        reset()
+        fail('Bản ghi âm trống. Hãy ghi lại.')
+        return
+      }
+      voice.blob = blob
+      voice.mime = voiceBaseMime(type)
+      voice.url = URL.createObjectURL(blob)
+      voice.phase = 'recorded'
+    }
+    max = voiceMaxSeconds(getMaxSeconds?.())
+    try {
+      rec.start(1000)
+    } catch {
+      reset()
+      fail('Trình duyệt không bắt đầu ghi âm được.')
+      return
+    }
+    startedAt = Date.now()
+    voice.elapsed = 0
+    voice.phase = 'recording'
+    timer = setInterval(() => {
+      measure()
+      if (voice.elapsed >= max) stop() // tự dừng ở thời lượng tối đa
+    }, 250)
+  }
+
+  /** Dừng ghi (giữ bản ghi để nghe lại / gửi); micro tắt ngay. */
+  function stop() {
+    if (voice.phase !== 'recording' || !recorder) return
+    clearInterval(timer)
+    timer = null
+    measure()
+    voice.phase = 'stopping'
+    try {
+      if (recorder.state !== 'inactive') recorder.stop()
+      else recorder.onstop?.()
+    } catch {
+      reset()
+      fail('Không dừng được ghi âm.')
+      return
+    }
+    stopTracks()
+  }
+
+  /** Hủy ở bất kỳ bước nào (đang xin micro, đang ghi, đã ghi): bỏ bản ghi, tắt micro. */
+  function cancel() {
+    token++
+    const rec = recorder
+    recorder = null // onstop của bản đang ghi sẽ bỏ dữ liệu
+    if (rec && rec.state !== 'inactive') {
+      try {
+        rec.stop()
+      } catch {
+        // đã dừng
+      }
+    }
+    reset()
+  }
+
+  onScopeDispose(cancel)
+
+  return { voice, start, stop, cancel }
+}
+
+/**
+ * Danh sách khách để chuyển tiếp một tin (ADR 0027 đợt 2): `open()` gọi `forward_targets` một lần với ô tìm rỗng; gõ vào ô
+ * tìm thì ngừng 300 ms mới gọi lại. Kết quả đến muộn của lần gọi cũ bị bỏ. `state`: { loading, items (forwardTargetList),
+ * error }. Máy chủ lọc (Lead khác có Messenger, người dùng được sửa) và cho biết gửi được hay lý do.
+ */
+export function useForwardTargets(getParams) {
+  const query = ref('')
+  const state = reactive({ loading: false, items: [], error: '' })
+  let timer = null
+  let seq = 0
+  let lastQ = null // từ khóa của lần gọi gần nhất; null khi bảng đang đóng
+
+  function load() {
+    clearTimeout(timer)
+    const q = forwardQuery(query.value)
+    const id = ++seq
+    lastQ = q
+    state.loading = true
+    state.error = ''
+    call('omni_crm.api.messenger_tab.forward_targets', { ...getParams(), q })
+      .then((res) => {
+        if (id === seq) state.items = forwardTargetList(res)
+      })
+      .catch((error) => {
+        if (id !== seq) return
+        state.items = []
+        state.error =
+          error?.messages?.[0] ||
+          error?.message ||
+          'Không tải được danh sách khách Messenger'
+      })
+      .finally(() => {
+        if (id === seq) state.loading = false
+      })
+  }
+
+  watch(query, (value) => {
+    if (lastQ === null) return
+    clearTimeout(timer)
+    if (forwardQuery(value) !== lastQ)
+      timer = setTimeout(load, FORWARD_SEARCH_DEBOUNCE_MS)
+  })
+
+  function open() {
+    query.value = ''
+    state.items = []
+    load()
+  }
+
+  function close() {
+    clearTimeout(timer)
+    seq++
+    lastQ = null
+    state.loading = false
+  }
+
+  onScopeDispose(close)
+
+  return { query, state, open, close, load }
+}
