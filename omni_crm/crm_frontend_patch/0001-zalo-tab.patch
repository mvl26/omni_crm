+  if (!win || typeof win.open !== 'function') return false
+  win.open(
+    metaInboxUrl(contact) || META_INBOX_URL,
+    '_blank',
+    'noopener,noreferrer',
+  )
+  return true
+}
+
+// --- Sale gửi ảnh / tệp qua Messenger (ADR 0023 mục 4) ---
+
+/** Danh sách đuôi mặc định, trùng `omni_crm.channels.meta_messenger.media_out.ACCEPT` (máy chủ gửi kèm trong `compose`). */
+export const DEFAULT_MEDIA_ACCEPT =
+  '.jpg,.jpeg,.png,.gif,.mp4,.mp3,.m4a,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip'
+export const DEFAULT_MEDIA_MAX_MB = 25
+
+const KIND_BY_EXT = {
+  '.jpg': 'image',
+  '.jpeg': 'image',
+  '.png': 'image',
+  '.gif': 'image',
+  '.mp4': 'video',
+  '.mp3': 'audio',
+  '.m4a': 'audio',
+}
+
+/** Đuôi tệp được nhận (chữ thường, có dấu chấm) từ chuỗi `accept` của máy chủ; rỗng hoặc lạ thì dùng danh sách mặc định. */
+export function acceptList(accept) {
+  const list = String(accept || '')
+    .split(',')
+    .map((s) => s.trim().toLowerCase())
+    .filter((s) => /^\.[a-z0-9]{1,10}$/.test(s))
+  if (list.length) return [...new Set(list)]
+  return DEFAULT_MEDIA_ACCEPT.split(',')
+}
+
+/** Cỡ tối đa (byte) theo `media_max_mb` của máy chủ; thiếu hoặc không hợp lệ thì 25 MB. */
+export function mediaMaxBytes(maxMb) {
+  const n = Number(maxMb)
+  return (Number.isFinite(n) && n > 0 ? n : DEFAULT_MEDIA_MAX_MB) * MB
+}
+
+/** Cỡ tệp dễ đọc: "850 KB", "1,5 MB". */
+export function formatSize(bytes) {
+  const n = Number(bytes) || 0
+  if (n < MB) return `${Math.max(1, Math.round(n / 1024))} KB`
+  return `${(Math.round((n / MB) * 10) / 10).toString().replace('.', ',')} MB`
+}
+
+/**
+ * Kiểm tệp sale chọn theo `compose.media_accept` và `compose.media_max_mb` của máy chủ: trả { kind } (image | video | audio
+ * | file) nếu gửi được, hoặc { error } (chuỗi tiếng Việt chưa dịch). Máy chủ kiểm lại (loại, cỡ, tệp thuộc Lead).
+ */
+export function checkMessengerFile(file, compose = null) {
+  if (!file) return { error: 'Chưa chọn tệp' }
+  const allowed = acceptList(compose?.media_accept)
+  const ext = fileExtension(file.name)
+  if (!ext || !allowed.includes(ext))
+    return {
+      error: `Messenger chỉ nhận tệp ${allowed.map((e) => e.slice(1).toUpperCase()).join(', ')}`,
+    }
+  if (!file.size) return { error: 'Tệp rỗng' }
+  const max = mediaMaxBytes(compose?.media_max_mb)
+  if (file.size > max)
+    return {
+      error: `Tệp quá lớn: Messenger nhận tối đa ${String(max / MB).replace('.', ',')} MB`,
+    }
+  return { kind: KIND_BY_EXT[ext] || 'file' }
+}
+
+/**
+ * Nút Gửi bật khi: không có tệp thì như `canSubmit` (có chữ, trong giới hạn); có tệp thì khung soạn cho gửi ảnh/tệp, tệp
+ * hợp lệ, chữ (không bắt buộc) trong giới hạn: chữ đi thành tin riêng TRƯỚC tệp nên giới hạn là `max_chars`, không phải 2.000.
