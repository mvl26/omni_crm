+export function checkMessengerFile(file, compose = null) {
+  if (!file) return { error: 'Chưa chọn tệp' }
+  const allowed = acceptList(compose?.media_accept)
+  const ext = fileExtension(file.name)
+  if (!ext || !allowed.includes(ext))
+    return {
+      error: `Messenger chỉ nhận tệp ${allowed.map((e) => e.slice(1).toUpperCase()).join(', ')}`,
+    }
+  if (!file.size) return { error: 'Tệp rỗng' }
+  const max = mediaMaxBytes(compose?.media_max_mb)
+  if (file.size > max)
+    return {
+      error: `Tệp quá lớn: Messenger nhận tối đa ${String(max / MB).replace('.', ',')} MB`,
+    }
