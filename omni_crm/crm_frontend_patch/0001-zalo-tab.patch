+            )
+          "
+          @click="submit()"
+        />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import {
+  computed,
+  nextTick,
+  onBeforeUnmount,
+  onMounted,
+  reactive,
+  ref,
+  watch,
+} from 'vue'
+import {
+  Button,
+  LoadingIndicator,
+  Textarea,
+  call,
+  createResource,
+  toast,
+} from 'frappe-ui'
+import { globalStore } from '@/stores/global'
+import {
+  POLL_MS,
+  ZALO_EVENT,
+  botCard,
+  bubbleSide,
+  canSubmit,
+  canSubmitWithFile,
+  checkMediaFile,
+  dayLabel,
+  groupByDay,
+  chatPanelMode,
+  copyToClipboard,
+  isRelevantUpdate,
+  sendWithConfirm,
+  openOaChat,
+  shortZaloId,
+  attachmentViews,
+  displayText,
+  sourceOf,
+  timeLabel,
+} from '@/utils/zaloThread'
+
+const props = defineProps({
+  doctype: { type: String, required: true },
+  docname: { type: String, required: true },
+})
+
+const { $socket } = globalStore()
+
+const text = ref('')
+const sending = ref(false)
+const requestingPhone = ref(false)
+const fileInput = ref(null)
+const pickedFile = ref(null) // V3-09: ảnh/tệp sale chọn, chưa gửi
+let uploaded = null // { file, url }: tệp đã tải lên CRM, dùng lại nếu sale bấm gửi lần nữa (không tải trùng)
+const scroller = ref(null)
+const loadFailed = ref(false)
+const brokenImages = reactive({}) // ảnh tải lỗi: rơi về liên kết có nhãn
+
+// Dữ liệu và mọi guard (khung 48 giờ, hạn mức, từ chối liên hệ, sandbox) nằm ở máy chủ: omni_crm.api.zalo_tab.
+const conversation = createResource({
+  url: 'omni_crm.api.zalo_tab.get_conversation',
+  makeParams: () => ({ doctype: props.doctype, name: props.docname }),
+  auto: true,
+  onSuccess: () => {
+    loadFailed.value = false
+    nextTick(scrollToBottom)
+  },
+  onError: () => {
+    loadFailed.value = true
+  },
+})
+
+const messages = computed(() => conversation.data?.messages || [])
+const groups = computed(() => groupByDay(messages.value))
+const compose = computed(
+  () =>
+    conversation.data?.compose || {
+      can_send: false,
+      reason: '',
+      paid: false,
+      message: '',
+      sandbox: false,
+      quota: null,
+      linked: false,
+    },
+)
+
+// Nhắn từ trang chính thức của Zalo OA (OA gói Cơ bản không gửi được qua API). Zalo không mở thẳng hội thoại theo
+// tham số, nên chỉ hiện thông tin để nhân viên tự tìm khách. Zalo chặn nhúng trang chat vào khung (đã thử): chỉ có nút mở cửa sổ riêng.
+const contact = computed(() => conversation.data?.contact || null)
+
+// Tóm tắt, ý định, mức gấp, điểm do bot phân tích ghi vào Lead (omni_crm.api.zalo_tab._bot).
+const bot = computed(() => botCard(conversation.data?.bot))
+function chipLabel(chip) {
+  if (chip.key === 'intent') return __('Ý định: {0}', [chip.value])
+  if (chip.key === 'urgency') return __('Mức gấp: {0}', [chip.value])
+  return __('Điểm: {0}', [chip.value])
+}
+const panelMode = computed(() => chatPanelMode(contact.value))
+const contactNames = computed(() => {
+  const c = contact.value
+  if (!c) return ''
+  return [...new Set([c.lead_name, c.display_name].filter(Boolean))].join(' / ')
+})
+
+function openChat() {
+  if (!openOaChat(contact.value)) toast.error(__('Trình duyệt chặn cửa sổ mới'))
+}
+
+async function copyId() {
+  const res = await copyToClipboard(contact.value?.zalo_user_id)
+  if (res.ok) toast.success(__('Đã sao chép mã Zalo'))
+  else toast.error(__('Không sao chép được, hãy chọn và chép tay'))
+}
+
+function senderLabel(msg) {
+  const source = sourceOf(msg)
+  if (source === 'customer') return msg.sender
+  if (source === 'bot') return `${__('Bot')} · ${msg.sender}`
+  if (source === 'echo') return __('Nhân viên (ngoài hệ thống)')
+  return `${__('Sale')} · ${msg.sender}`
+}
+
+function statusText(msg) {
+  if (msg.status === 'Queued' || msg.queued) return __('Đang gửi...')
+  if (msg.status === 'Blocked') return msg.error || __('Bị chặn, chưa gửi')
+  if (msg.status === 'Failed') return msg.error || __('Gửi lỗi')
+  return ''
+}
+
+function scrollToBottom() {
+  const el = scroller.value
+  if (el) el.scrollTop = el.scrollHeight
+}
+
+function reload() {
+  if (sending.value) return
+  conversation.reload()
+}
+
+const pickedHint = computed(() => {
+  const kind = pickedFile.value ? checkMediaFile(pickedFile.value).kind : ''
+  if (kind === 'file')
+    return __('Tệp: lời nhắn (nếu có) gửi thành tin riêng trước')
+  if (kind === 'image') return __('Ảnh trên 1 MB sẽ được nén trước khi gửi')
+  return ''
+})
+
+function onPickFile(event) {
+  const file = event.target.files?.[0]
+  event.target.value = '' // chọn lại cùng tệp vẫn kích hoạt change
+  if (!file) return
+  const check = checkMediaFile(file)
+  if (check.error) {
+    toast.error(__(check.error))
+    return
+  }
+  pickedFile.value = file
+}
+
+function clearFile() {
+  pickedFile.value = null
+}
+
+// Tải tệp lên CRM (gắn vào Lead/Deal đang mở, riêng tư), trả file_url. Máy chủ kiểm lại tệp thuộc Lead trước khi gửi Zalo.
+async function uploadToCrm(file) {
+  if (uploaded?.file === file) return uploaded.url
+  const form = new FormData()
+  form.append('file', file, file.name)
+  form.append('doctype', props.doctype)
+  form.append('docname', props.docname)
+  form.append('is_private', '1')
+  const resp = await fetch('/api/method/upload_file', {
+    method: 'POST',
+    headers: {
+      Accept: 'application/json',
+      'X-Frappe-CSRF-Token': window.csrf_token,
+    },
+    body: form,
+  })
+  const data = await resp.json().catch(() => ({}))
+  const url = data?.message?.file_url
+  if (!resp.ok || !url) {
+    let msg = ''
+    try {
+      msg = JSON.parse(
+        JSON.parse(data._server_messages || '[]')[0] || '{}',
+      ).message
+    } catch (e) {
+      msg = ''
+    }
+    throw new Error(msg || __('Không tải được tệp lên CRM'))
+  }
+  uploaded = { file, url }
+  return url
+}
+
+async function submitFile() {
+  const file = pickedFile.value
+  sending.value = true
+  try {
+    const fileUrl = await uploadToCrm(file)
+    const res = await sendWithConfirm(
+      (value, confirmPaid) =>
+        call('omni_crm.api.zalo_tab.send_attachment', {
+          doctype: props.doctype,
+          name: props.docname,
+          file_url: fileUrl,
+          text: value,
+          confirm_paid: confirmPaid,
+        }),
+      (warning) => window.confirm(`${warning}\n\n${__('Bạn vẫn muốn gửi?')}`),
+      text.value,
+    )
+    if (res?.status === 'Blocked') {
+      toast.error(res.reason || __('Tin bị chặn, chưa gửi'))
+    } else if (res) {
+      text.value = ''
+      pickedFile.value = null
+      uploaded = null
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] ||
+        error?.message ||
+        __('Không gửi được ảnh/tệp qua Zalo'),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+async function submit() {
+  if (pickedFile.value) {
+    if (
+      canSubmitWithFile(
+        compose.value,
+        text.value,
+        pickedFile.value,
+        sending.value,
+        compose.value.max_chars,
+      )
+    )
+      await submitFile()
+    return
+  }
+  if (
+    !canSubmit(
+      compose.value,
+      text.value,
+      sending.value,
+      compose.value.max_chars,
+    )
+  )
+    return
+  const body = text.value
+  sending.value = true // giữ cờ này đến khi CẢ hai lần gọi (nếu có xác nhận phí) kết thúc: không gửi đôi
+  try {
+    const res = await sendWithConfirm(
+      (value, confirmPaid) =>
+        call('omni_crm.api.zalo_tab.send', {
+          doctype: props.doctype,
+          name: props.docname,
+          text: value,
+          confirm_paid: confirmPaid,
+        }),
+      (warning) => window.confirm(`${warning}\n\n${__('Bạn vẫn muốn gửi?')}`),
+      body,
+    )
+    if (res?.status === 'Blocked') {
+      toast.error(res.reason || __('Tin bị chặn, chưa gửi'))
+    } else if (res) {
+      text.value = ''
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] || error?.message || __('Không gửi được tin Zalo'),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// V3-07: gửi thẻ request_user_info; điều kiện (chưa có số, trong 48 giờ, chưa xin trong phiên) kiểm ở máy chủ.
+async function requestPhone() {
+  if (requestingPhone.value) return
+  requestingPhone.value = true
+  try {
+    await call('omni_crm.api.zalo_tab.request_phone', {
+      doctype: props.doctype,
+      name: props.docname,
+    })
+    toast.success(__('Đã gửi thẻ xin số điện thoại'))
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] || error?.message || __('Không gửi được thẻ xin số'),
+    )
+  } finally {
+    requestingPhone.value = false
+    conversation.reload()
+  }
+}
+
+// Realtime: payload chỉ có {lead, channels}, không có nội dung tin; nhận tín hiệu rồi tải lại qua API có kiểm quyền.
+let timer = null
+let poll = null
+function onUpdate(payload) {
+  if (!isRelevantUpdate(payload, conversation.data?.lead)) return
+  clearTimeout(timer)
+  timer = setTimeout(reload, 500)
+}
+
+function onVisible() {
+  if (!document.hidden) reload()
+}
+
+onMounted(() => {
+  $socket?.on(ZALO_EVENT, onUpdate)
+  // Dự phòng khi mất kết nối realtime; tab trình duyệt ẩn thì không thăm dò, hiện lại thì tải ngay.
+  poll = setInterval(() => {
+    if (!document.hidden) reload()
+  }, POLL_MS)
+  document.addEventListener('visibilitychange', onVisible)
+})
+
+onBeforeUnmount(() => {
+  $socket?.off(ZALO_EVENT, onUpdate)
+  clearInterval(poll)
+  document.removeEventListener('visibilitychange', onVisible)
+  clearTimeout(timer)
+})
+
+watch(
+  () => [props.doctype, props.docname],
+  () => conversation.reload(),
+)
+</script>
