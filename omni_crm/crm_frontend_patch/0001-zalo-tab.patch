+  const items = Array.isArray(list) ? list : []
+  const q = foldText(query)
+  if (!q) return items
+  const words = q.split(' ')
+  return items.filter((t) => {
+    if (!t || typeof t !== 'object') return false
+    const hay = foldText([t.title, t.note, t.error ? '' : t.text].join(' '))
+    return words.every((w) => hay.includes(w))
+  })
+}
