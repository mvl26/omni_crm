+    compose?.can_send &&
+    compose?.can_send_media &&
+    !sending &&
+    !checkMessengerFile(file, compose).error &&
+    value.length <= maxChars,
+  )
+}
+
+/**
+ * Kết quả trả về của `upload_file` (Frappe): { url } khi có `message.file_url` (chỉ nhận /files, /private/files), hoặc
+ * { error } với thông điệp của máy chủ nếu đọc được (`_server_messages`), rỗng nếu không (người gọi dùng câu mặc định).
+ */
+export function parseUploadResponse(ok, data) {
+  const url = String(data?.message?.file_url || '')
+  if (ok && LOCAL_FILE.test(url)) return { url }
+  try {
+    const first = JSON.parse(data?._server_messages || '[]')[0]
+    return { error: String(JSON.parse(first || '{}').message || '') }
+  } catch {
+    return { error: '' }
+  }
+}
+
+/**
+ * Sau khi gọi `send` / `send_attachment`: { ok, clearText, clearFile, error }. Bị chặn thì giữ khung soạn để sửa, trừ phần chữ
+ * đã xếp hàng (có `text_outbound`: chữ đi rồi, chỉ tệp bị chặn) để bấm lại không gửi chữ hai lần.
+ */
+export function sendOutcome(res) {
+  if (res?.status === 'Blocked')
