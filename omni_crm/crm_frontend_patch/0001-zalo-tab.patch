+describe('sendWithConfirm', () => {
+  it('không cần xác nhận: gửi đúng một lần', async () => {
+    const calls = []
+    const send = async (body, paid) => {
+      calls.push([body, paid])
+      return { status: 'Queued' }
+    }
+    const res = await sendWithConfirm(send, () => true, 'xin chào')
+    expect(res).toEqual({ status: 'Queued' })
+    expect(calls).toEqual([['xin chào', 0]])
+  })
+  it('cần xác nhận phí: hỏi, rồi gửi lần hai với confirm_paid=1 và CHỜ xong mới trả về', async () => {
+    const order = []
+    const send = async (body, paid) => {
+      order.push(`start${paid}`)
+      if (paid === 0) return { status: 'confirm_required', warning: 'có phí' }
+      await new Promise((r) => setTimeout(r, 10))
+      order.push('end1')
+      return { status: 'Queued' }
+    }
+    let asked = null
+    const res = await sendWithConfirm(send, (w) => ((asked = w), true), 'x')
+    order.push('returned')
+    expect(asked).toBe('có phí')
+    expect(res).toEqual({ status: 'Queued' })
+    expect(order).toEqual(['start0', 'start1', 'end1', 'returned'])
+  })
+  it('người dùng hủy: không gửi lần hai, trả null', async () => {
+    let n = 0
+    const send = async () => {
+      n += 1
+      return { status: 'confirm_required', warning: 'có phí' }
+    }
+    expect(await sendWithConfirm(send, () => false, 'x')).toBeNull()
+    expect(n).toBe(1)
+  })
+  it('lỗi ở lần gọi nào cũng ném ra cho người gọi', async () => {
+    const send = async () => {
+      throw new Error('mạng')
+    }
+    await expect(sendWithConfirm(send, () => true, 'x')).rejects.toThrow('mạng')
+  })
+})
