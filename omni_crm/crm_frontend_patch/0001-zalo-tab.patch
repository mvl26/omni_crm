+
+/**
+ * Chèn `insert` vào `text` tại vùng chọn [start, end) của ô soạn (thay phần đang bôi đen): { text, cursor }, `cursor` ngay
+ * sau phần chèn. `start` không phải số nguyên (không đọc được con trỏ) thì nối vào cuối; vị trí được kẹp trong độ dài chữ.
+ */
+export function insertAtCursor(text, start, end, insert) {
+  const value = text == null ? '' : String(text)
+  const add = insert == null ? '' : String(insert)
+  const clamp = (n) => Math.min(Math.max(n, 0), value.length)
+  let from = Number.isInteger(start) ? clamp(start) : value.length
+  let to = Number.isInteger(start) && Number.isInteger(end) ? clamp(end) : from
+  if (to < from) [from, to] = [to, from]
+  return {
+    text: value.slice(0, from) + add + value.slice(to),
+    cursor: from + add.length,
+  }
+}
+
+/** Host ảnh sticker được vẽ (CDN của Meta), trùng `STICKER_HOSTS` của máy chủ: đúng host hoặc tên miền con. */
+export const STICKER_HOSTS = ['fbcdn.net', 'fbsbx.com', 'facebook.com']
+
+/** URL ảnh sticker vẽ được: https, host thuộc `STICKER_HOSTS`, không userinfo, không cổng lạ, không ký tự lạ. */
+export function isStickerUrl(url) {
+  const value = String(url || '')
+  if (!isSafeUrl(value)) return false
+  let u
+  try {
+    u = new URL(value)
+  } catch {
+    return false
+  }
+  if (u.protocol !== 'https:' || u.username || u.password) return false
+  if (u.port && u.port !== '443') return false
+  const host = u.hostname.toLowerCase()
+  return STICKER_HOSTS.some((d) => host === d || host.endsWith('.' + d))
+}
+
+/**
+ * Cách vẽ sticker của tin sale gửi (`msg.sticker` = { id, url }): { id, src, like }, hoặc null nếu tin không phải sticker.
+ * `src` chỉ khác rỗng khi URL qua `isStickerUrl`; `like` khi là sticker 👍 của Messenger (`compose.like_sticker_id`).
+ * Giao diện: có `src` thì vẽ ảnh, không thì `like` vẽ 👍 lớn, còn lại "[Sticker]".
+ */
+export function stickerView(sticker, likeId = '') {
+  if (!sticker || typeof sticker !== 'object') return null
+  const id = String(sticker.id ?? '').trim()
+  return {
+    id,
+    src: isStickerUrl(sticker.url) ? String(sticker.url) : '',
+    like: Boolean(id) && id === String(likeId ?? '').trim(),
+  }
+}
+
+const STICKER_ID = /^\d{1,30}$/
+
+/** Tìm sticker: cần ít nhất chừng này ký tự (như máy chủ `sticker_search`). */
+export const STICKER_SEARCH_MIN = 2
+
+/** Từ khóa tìm sticker như máy chủ chuẩn hóa (gộp khoảng trắng, tối đa 50 ký tự): { q, ready }; `ready` khi đủ 2 ký tự. */
+export function stickerQuery(value) {
+  const chars = [
+    ...String(value ?? '')
+      .split(/\s+/)
+      .filter(Boolean)
+      .join(' '),
+  ].slice(0, 50)
+  return { q: chars.join(''), ready: chars.length >= STICKER_SEARCH_MIN }
+}
+
+/** Kết quả `sticker_packs`: { items: [{ id, name, preview, count }], error }. Bỏ bộ không có mã số; ảnh đại diện lạ thì rỗng. */
+export function stickerPackList(res) {
+  const items = []
+  const seen = new Set()
+  for (const p of Array.isArray(res?.items) ? res.items : []) {
+    const id = String(p?.id ?? '')
+    if (!STICKER_ID.test(id) || seen.has(id)) continue
+    seen.add(id)
+    items.push({
+      id,
+      name:
+        String(p.name ?? '')
+          .trim()
+          .slice(0, 80) || 'Sticker',
+      preview: isStickerUrl(p.preview_image_url)
+        ? String(p.preview_image_url)
+        : '',
+      count: Math.max(0, Math.floor(Number(p.count) || 0)),
+    })
+  }
+  return { items, error: String(res?.error ?? '').trim() }
+}
+
+/** Kết quả `sticker_pack` / `sticker_search`: { items: [{ id, name, url, animated }], error }. Chỉ giữ sticker có mã số và ảnh vẽ được. */
+export function stickerList(res) {
+  const items = []
+  const seen = new Set()
+  for (const s of Array.isArray(res?.items) ? res.items : []) {
+    const id = String(s?.id ?? '')
+    if (!STICKER_ID.test(id) || seen.has(id) || !isStickerUrl(s.image_url))
+      continue
+    seen.add(id)
+    items.push({
+      id,
+      name: String(s.name ?? '')
+        .trim()
+        .slice(0, 80),
+      url: String(s.image_url),
+      animated: Boolean(s.animated),
+    })
+  }
+  return { items, error: String(res?.error ?? '').trim() }
+}
+
+/**
+ * Tin sale chọn để trả lời: { doctype, name, text, label }, hoặc null nếu tin thiếu loại / tên. `text`: chữ của tin trên
+ * một dòng (≤ 80 ký tự); tin không có chữ thì `text` rỗng và `label` ("Sticker", "Tệp đính kèm", "Tin nhắn") do giao diện dịch.
+ */
+export function replyTarget(msg) {
+  if (!msg || !MESSAGE_DOCTYPES.includes(msg.doctype) || !msg.name) return null
+  const text = oneLine(msg.text, QUOTE_CHARS)
+  const atts = Array.isArray(msg.attachments) ? msg.attachments : []
+  let label = ''
+  if (!text) {
+    if (
+      msg.sticker ||
+      atts.some((a) => String(a?.type).toLowerCase() === 'sticker')
+    )
+      label = 'Sticker'
+    else label = atts.length ? 'Tệp đính kèm' : 'Tin nhắn'
+  }
+  return { doctype: msg.doctype, name: String(msg.name), text, label }
+}
+
+/** Tham số trả lời gửi kèm `send` / `send_attachment` / `send_sticker`: { reply_to_doctype, reply_to }, hoặc {} nếu không trả lời. */
+export function replyPayload(replyTo) {
+  const doctype = String(replyTo?.doctype ?? '')
+  const name = String(replyTo?.name ?? '')
+  if (!MESSAGE_DOCTYPES.includes(doctype) || !name) return {}
+  return { reply_to_doctype: doctype, reply_to: name }
+}
+
+/**
+ * Trích dẫn trên bong bóng (`msg.reply_to` của máy chủ): null nếu tin không trả lời tin nào; tin gốc đã ẩn / không còn thì
+ * { missing: true, ... }; còn lại { missing: false, name, sender, customer, text } (một dòng; `customer` khi tin gốc của khách).
+ */
+export function quoteLabel(msg) {
+  const q = msg?.reply_to
+  if (!q || typeof q !== 'object') return null
+  const name = String(q.name ?? '')
+  if (q.missing || !name)
+    return { missing: true, name: '', sender: '', customer: false, text: '' }
+  return {
+    missing: false,
+    name,
+    sender: oneLine(q.sender, 40),
+    customer: q.direction === 'in',
+    text: oneLine(q.text, QUOTE_CHARS),
+  }
+}
+
+/** Chip cảm xúc dưới bong bóng (`msg.reactions`): [{ key: 'customer' | 'page', emoji, glyph }], khách trước; rỗng thì bỏ. */
+export function reactionChips(reactions) {
+  if (!reactions || typeof reactions !== 'object') return []
+  const out = []
+  for (const key of ['customer', 'page']) {
+    const value = reactions[key]
+    const emoji = typeof value === 'string' ? value.trim() : ''
+    if (emoji && emoji.length <= 32)
+      out.push({ key, emoji, glyph: emojiGlyph(emoji) })
+  }
+  return out
+}
+
+/** Hàng cảm xúc nhanh: [{ emoji, glyph, active }]; `active` là cảm xúc Page đang thả (`reactions.page`, bỏ qua U+FE0F). */
+export function reactionChoices(current) {
+  const now = bareEmoji(current).trim()
+  return REACTION_EMOJIS.map((emoji) => ({
+    emoji,
+    glyph: emojiGlyph(emoji),
+    active: Boolean(now) && bareEmoji(emoji) === now,
+  }))
+}
+
+/**
+ * Thao tác được phép trên một tin: { react, reply, hide, unhide, forward, any }. Máy chủ quyết định (`can_react`, `can_hide`,
+ * `can_forward`, `mid`, `compose.can_react`, `compose.can_send`) và kiểm lại khi gọi. Trả lời cần mã tin Meta; mã "sandbox:"
+ * chỉ dùng được khi site đang sandbox (như máy chủ). Chuyển tiếp (ADR 0027 đợt 2) chỉ theo `msg.can_forward` (tin Page đã
+ * gửi, đang hiện, có nội dung), không phụ thuộc khung 24 giờ của khách đang xem. Tin thiếu loại / tên: không thao tác nào.
+ */
+export function messageActions(msg, compose) {
+  const ok = Boolean(msg && MESSAGE_DOCTYPES.includes(msg.doctype) && msg.name)
+  const mid = String(msg?.mid ?? '')
+  const react = ok && Boolean(compose?.can_react && msg.can_react)
+  const reply =
+    ok &&
+    Boolean(compose?.can_send) &&
+    Boolean(mid) &&
+    (!mid.startsWith('sandbox:') || Boolean(compose?.sandbox))
+  const hide = ok && Boolean(msg.can_hide) && !msg.hidden
+  const unhide = ok && Boolean(msg.can_hide) && Boolean(msg.hidden)
+  const forward = ok && Boolean(msg.can_forward) && !msg.hidden
+  return {
+    react,
+    reply,
+    hide,
+    unhide,
+    forward,
+    any: react || reply || hide || unhide || forward,
+  }
+}
+
+// --- Ghi âm (ADR 0027 đợt 2): trình duyệt ghi, tải lên CRM tên `ghi-am-…`, máy chủ đổi sang MP3 rồi gửi kiểu audio ---
+
+/** Kiểu ghi âm thử theo thứ tự cho MediaRecorder (Chrome / Edge / Firefox ghi WebM hoặc Ogg Opus, Safari ghi MP4). */
+export const VOICE_MIMES = [
+  'audio/webm;codecs=opus',
+  'audio/webm',
+  'audio/ogg;codecs=opus',
+  'audio/mp4',
+]
+
+/** Tiền tố tên tệp ghi âm: máy chủ chỉ xóa bản gốc sau khi đổi sang MP3 khi tên có tiền tố này (`media_out.VOICE_PREFIX`). */
+export const VOICE_PREFIX = 'ghi-am-'
+
+/** Thời lượng ghi tối đa mặc định (giây), như `media_out.VOICE_MAX_SECONDS`; máy chủ gửi kèm `compose.voice_max_seconds`. */
+export const VOICE_MAX_SECONDS = 300
+
+const VOICE_EXT = {
+  'audio/webm': '.webm',
+  'audio/ogg': '.ogg',
+  'audio/mp4': '.m4a',
+}
+
+/**
+ * Kiểu ghi âm đầu tiên trong `VOICE_MIMES` mà trình duyệt nhận (`isSupported` thường là `MediaRecorder.isTypeSupported`),
+ * hoặc '' nếu không có kiểu nào (không ghi âm được). Hàm kiểm ném lỗi thì coi như không nhận kiểu đó.
+ */
+export function pickRecorderMime(isSupported) {
+  if (typeof isSupported !== 'function') return ''
+  for (const mime of VOICE_MIMES) {
+    try {
+      if (isSupported(mime)) return mime
+    } catch {
+      // trình duyệt lạ: thử kiểu kế tiếp
+    }
+  }
+  return ''
+}
+
+/** Kiểu gốc của mime ghi âm, bỏ tham số (vd. "audio/webm;codecs=opus" -> "audio/webm"); chữ thường. */
+export function voiceBaseMime(mime) {
+  return String(mime ?? '')
+    .split(';')[0]
+    .trim()
+    .toLowerCase()
+}
+
+/** Đuôi tệp theo mime ghi âm: .webm, .ogg, .m4a; mime khác thì ''. */
+export function voiceExtension(mime) {
+  return VOICE_EXT[voiceBaseMime(mime)] || ''
+}
+
+/**
+ * Tên tệp ghi âm tải lên CRM: "ghi-am-YYYYMMDD-HHMMSS.<đuôi>" theo giờ máy người dùng, đuôi khớp mime (.webm, .ogg, .m4a).
+ * '' nếu mime không thuộc ba kiểu trên hoặc ngày không hợp lệ (không tải lên).
+ */
+export function voiceFileName(date, mime) {
+  const ext = voiceExtension(mime)
+  if (!ext || !(date instanceof Date) || Number.isNaN(date.getTime())) return ''
+  const pad = (n) => String(n).padStart(2, '0')
+  const day = `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}`
+  const time = `${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`
+  return `${VOICE_PREFIX}${day}-${time}${ext}`
+}
+
+/** Thời lượng "mm:ss" (làm tròn xuống giây); âm, rỗng hoặc không phải số thì "00:00". */
+export function formatDuration(seconds) {
+  const n = Number(seconds)
+  const total = Number.isFinite(n) && n > 0 ? Math.floor(n) : 0
+  const pad = (v) => String(v).padStart(2, '0')
+  return `${pad(Math.floor(total / 60))}:${pad(total % 60)}`
+}
+
+/** Thời lượng ghi tối đa (giây) theo `compose.voice_max_seconds`; thiếu hoặc không hợp lệ thì 300. */
+export function voiceMaxSeconds(value) {
+  const n = Math.floor(Number(value))
+  return Number.isFinite(n) && n > 0 ? n : VOICE_MAX_SECONDS
+}
+
+/**
+ * Câu báo khi không bật được micro (chưa dịch), theo `name` của lỗi getUserMedia (hoặc chuỗi tên lỗi): bị chặn quyền, không có
+ * micro, micro đang bận; lỗi khác dùng câu chung.
+ */
+export function micErrorText(error) {
+  const name = String(
+    typeof error === 'string' ? error : (error?.name ?? ''),
+  ).trim()
+  if (
+    ['NotAllowedError', 'PermissionDeniedError', 'SecurityError'].includes(name)
+  )
+    return 'Trình duyệt chưa cho phép dùng micro. Bấm biểu tượng ổ khóa cạnh địa chỉ trang, cho phép micro rồi thử lại.'
+  if (
+    ['NotFoundError', 'DevicesNotFoundError', 'OverconstrainedError'].includes(
+      name,
+    )
+  )
+    return 'Không tìm thấy micro trên máy này.'
+  if (['NotReadableError', 'TrackStartError', 'AbortError'].includes(name))
+    return 'Micro đang bận hoặc không dùng được (có thể ứng dụng khác đang dùng). Thử lại sau.'
+  return 'Không bật được micro để ghi âm.'
+}
+
+// --- Chuyển tiếp (ADR 0027 đợt 2): chỉ tin Page đã gửi, tới khách Messenger của Lead khác ---
+
+/** Ngừng gõ chừng này mili giây thì mới tìm khách để chuyển tiếp. */
+export const FORWARD_SEARCH_DEBOUNCE_MS = 300
+
+/** Từ khóa tìm khách như máy chủ chuẩn hóa `forward_targets` (gộp khoảng trắng, tối đa 80 ký tự). */
+export function forwardQuery(value) {
+  return [
+    ...String(value ?? '')
+      .split(/\s+/)
+      .filter(Boolean)
+      .join(' '),
+  ]
+    .slice(0, 80)
+    .join('')
+}
+
+/**
+ * Một khách trong danh sách chuyển tiếp (`forward_targets` -> items[i]): { lead, name, canSend, status }, hoặc null nếu thiếu
+ * mã Lead. `status` (chưa dịch): "Gửi được", hoặc lý do của máy chủ (vd. ngoài 24 giờ), thiếu lý do thì "Chưa gửi được".
+ */
+export function forwardTargetView(item) {
+  if (!item || typeof item !== 'object') return null
+  const lead = String(item.lead ?? '').trim()
+  if (!lead) return null
+  const canSend = Boolean(item.can_send)
+  const reason = String(item.reason ?? '').trim()
+  return {
+    lead,
+    name:
+      String(item.lead_name ?? '')
+        .trim()
+        .slice(0, 140) || lead,
+    canSend,
+    status: canSend ? 'Gửi được' : reason || 'Chưa gửi được',
+  }
+}
+
+/** Danh sách khách chuyển tiếp từ kết quả `forward_targets` ({ items }): giữ thứ tự máy chủ, bỏ mục rác và Lead trùng, tối đa 20. */
+export function forwardTargetList(res) {
+  const out = []
+  const seen = new Set()
+  for (const item of Array.isArray(res?.items) ? res.items : []) {
+    const view = forwardTargetView(item)
+    if (!view || seen.has(view.lead)) continue
+    seen.add(view.lead)
+    out.push(view)
+    if (out.length >= 20) break
+  }
+  return out
+}
