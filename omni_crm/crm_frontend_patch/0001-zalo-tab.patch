+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_MEDIA_ACCEPT,
+  EMOJI_GROUPS,
+  FORWARD_SEARCH_DEBOUNCE_MS,
+  HEART,
+  MESSAGE_DOCTYPES,
+  META_INBOX_URL,
+  MESSENGER_CHANNEL,
+  REACTION_EMOJIS,
+  STICKER_HOSTS,
+  TEMPLATE_SEARCH_AFTER,
+  VOICE_MAX_SECONDS,
+  VOICE_MIMES,
+  VOICE_PREFIX,
+  acceptList,
+  applyTemplate,
+  canSubmitMessenger,
+  checkMessengerFile,
+  emojiGlyph,
+  filterTemplates,
+  foldText,
+  formatDuration,
+  formatSize,
+  forwardQuery,
+  forwardTargetList,
+  forwardTargetView,
+  insertAtCursor,
+  isMessengerUpdate,
+  isStickerUrl,
+  localFileName,
+  localFileUrl,
+  mediaKind,
+  mediaMaxBytes,
+  messageActions,
+  messengerAttachmentViews,
+  metaInboxUrl,
+  micErrorText,
+  needsTemplateSearch,
+  openMetaInbox,
+  overLimit,
+  parseUploadResponse,
+  pickRecorderMime,
+  quoteLabel,
+  reactionChips,
+  reactionChoices,
+  replyPayload,
+  replyTarget,
+  sendOutcome,
+  stickerList,
+  stickerPackList,
+  stickerQuery,
+  stickerView,
+  templateList,
+  voiceBaseMime,
+  voiceExtension,
+  voiceFileName,
+  voiceMaxSeconds,
+} from '@/utils/messengerThread'
+
+const MB = 1024 * 1024
+const f = (name, size) => ({ name, size })
+const COMPOSE = {
+  can_send: true,
+  can_send_media: true,
+  media_accept: DEFAULT_MEDIA_ACCEPT,
+  media_max_mb: 25,
+  max_chars: 6000,
+}
+
+describe('localFileUrl / localFileName (tệp trong CRM)', () => {
+  it('nhận /files, /private/files sạch', () => {
+    expect(localFileUrl('/files/a.png')).toBe('/files/a.png')
+    expect(localFileUrl('/private/files/a%20b.jpg')).toBe(
+      '/private/files/a%20b.jpg',
+    )
+  })
+  it('từ chối đường lạ, .., //, ký tự điều khiển, URL ngoài', () => {
+    for (const bad of [
+      '',
+      null,
+      undefined,
+      'https://cdn.example/a.png',
+      '//evil.example/files/a.png',
+      '/files/../private/files/x.png',
+      '/private/files/%2e%2e/x.png',
+      '/files//x.png',
+      '/files/a\\b.png',
+      '/files/a\nb.png',
+      '/files/a\tb.png',
+      'javascript:alert(1)',
+      '/filesx/a.png',
+      'files/a.png',
+    ]) {
+      expect(localFileUrl(bad)).toBe('')
+      expect(localFileUrl(bad, { allowSpace: true })).toBe('')
+    }
+  })
+  it('dấu cách: từ chối cho src, nhận và mã hóa cho liên kết', () => {
+    expect(localFileUrl('/private/files/Báo giá.pdf')).toBe('')
+    expect(
+      localFileUrl('/private/files/Bao gia thu.pdf', { allowSpace: true }),
+    ).toBe('/private/files/Bao%20gia%20thu.pdf')
+  })
+  it('tên tệp cuối đường dẫn', () => {
+    expect(localFileName('/private/files/B%C3%A1o%20gi%C3%A1.pdf?x=1')).toBe(
+      'Báo giá.pdf',
+    )
+    expect(localFileName('/files/a%zz.pdf')).toBe('a%zz.pdf') // mã hỏng: giữ nguyên
+    expect(localFileName('')).toBe('')
+  })
+})
+
+describe('mediaKind', () => {
+  it('theo type, rồi mime khi type thiếu hoặc là file', () => {
+    expect(mediaKind('image')).toBe('image')
+    expect(mediaKind('GIF')).toBe('image')
+    expect(mediaKind('sticker')).toBe('image')
+    expect(mediaKind('video', 'video/mp4')).toBe('video')
+    expect(mediaKind('audio')).toBe('audio')
+    expect(mediaKind('', 'audio/mpeg')).toBe('audio')
