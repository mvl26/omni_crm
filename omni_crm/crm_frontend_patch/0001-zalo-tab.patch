+/** Có ký tự điều khiển, khoảng trắng hoặc `\` (trình duyệt coi `\` như `/`, nên `https://evil.com\@zdn.vn` trỏ tới evil.com). */
+function hasBadChars(url) {
+  for (const ch of String(url)) {
+    const code = ch.codePointAt(0)
+    if (
+      ch === '\\' ||
+      code <= 0x20 ||
+      (code >= 0x7f && code <= 0xa0) ||
+      code === 0x2028 ||
+      code === 0x2029 ||
+      code === 0xfeff
+    )
+      return true
+  }
+  return false
+}
+
+/** Chỉ cho phép liên kết http(s) sạch; mọi thứ khác (javascript:, data:, /files/...) bị bỏ. Không `\`, ký tự điều khiển, khoảng trắng. */
+export function isSafeUrl(url) {
+  const value = String(url || '')
+  return /^https?:\/\//i.test(value) && !hasBadChars(value)
+}
+
+/** Danh sách đính kèm đã lọc: chỉ URL http(s), mỗi mục có name để hiển thị; giữ type và thumb nếu có. */
+export function safeAttachments(list) {
+  if (!Array.isArray(list)) return []
+  return list
+    .filter((a) => a && isSafeUrl(a.url))
+    .map((a) => ({
+      url: String(a.url).trim(),
+      name: String(a.name || a.url).slice(0, 120),
+      ...(a.type ? { type: String(a.type).toLowerCase().slice(0, 30) } : {}),
+      ...(a.thumb && isSafeUrl(a.thumb)
