+        <span class="text-sm font-semibold text-ink-gray-9">{{
+          __('Tóm tắt của bot AI')
+        }}</span>
+        <span
+          v-for="chip in bot.chips"
+          :key="chip.key"
+          class="rounded bg-surface-gray-3 px-1.5 py-0.5 text-xs text-ink-gray-8"
