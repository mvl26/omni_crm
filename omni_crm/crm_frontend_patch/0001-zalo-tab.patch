+// Gửi bản ghi (kèm tin đang trả lời nếu có). Cờ `sending` giữ suốt lúc tải lên, đổi MP3 và gửi: mọi nút gửi khác khóa.
+async function sendVoice() {
+  if (sending.value || voice.phase !== 'recorded' || !voice.blob) return
+  if (!compose.value.can_send_voice) {
+    toast.error(
+      compose.value.voice_reason ||
+        compose.value.reason ||
+        __('Hiện chưa gửi được ghi âm qua Messenger'),
+    )
+    return
+  }
+  const blob = voice.blob
+  const fileName = voiceFileName(new Date(), voice.mime)
+  if (!fileName) {
+    toast.error(__('Định dạng ghi âm không được hỗ trợ'))
+    return
+  }
+  sending.value = true
+  voiceSending.value = true
+  try {
+    let fileUrl = voiceUpload?.blob === blob ? voiceUpload.url : ''
+    if (!fileUrl) {
+      fileUrl = await postUpload(
+        new File([blob], fileName, { type: voice.mime }),
+      )
+      voiceUpload = { blob, url: fileUrl }
+    }
+    const res = await call('omni_crm.api.messenger_tab.send_voice', {
+      doctype: props.doctype,
+      name: props.docname,
+      file_url: fileUrl,
+      ...replyPayload(replyTo.value),
+    })
+    voiceUpload = null // máy chủ đã nhận bản ghi (đổi xong thì xóa bản gốc): lần gửi sau phải tải lại
+    const outcome = sendOutcome(res)
+    if (outcome.ok) {
+      replyTo.value = null
+      cancelRecording()
+    } else toast.error(__(outcome.error))
+  } catch (error) {
+    toast.error(errorText(error, __('Không gửi được ghi âm qua Messenger')))
+  } finally {
+    voiceSending.value = false
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// Chuyển tiếp: chỉ tin Page đã gửi (`msg.can_forward`), tới khách Messenger của Lead khác; máy chủ kiểm lại mọi guard.
+const forwardMsg = ref(null) // tin đang chọn khách để chuyển tiếp
+const forwarding = ref('') // Lead đang được chuyển tiếp tới: không gọi đôi
+const {
+  query: forwardSearch,
+  state: forwardTargets,
+  open: openForwardTargets,
+  close: closeForwardTargets,
+  load: loadForwardTargets,
+} = useForwardTargets(() => ({ doctype: props.doctype, name: props.docname }))
+
+const forwardOpen = computed({
+  get: () => Boolean(forwardMsg.value),
+  set: (value) => {
+    if (!value) closeForward()
+  },
+})
+
+const forwardPreview = computed(() => {
+  const target = replyTarget(forwardMsg.value)
+  return target ? target.text || __(target.label) : ''
+})
+
+function openForward(msg, close) {
+  close()
+  if (!msg?.can_forward) return
+  forwardMsg.value = msg
+  openForwardTargets()
+}
+
+function closeForward() {
+  forwardMsg.value = null
+  closeForwardTargets()
+}
+
+async function chooseForwardTarget(item) {
+  const msg = forwardMsg.value
+  if (!msg || !item?.canSend || forwarding.value) return
+  if (
+    !window.confirm(
+      __(
+        'Chuyển tiếp tin này tới {0}? Khách nhận sẽ thấy như tin mới từ Page.',
+        [item.name],
+      ),
+    )
+  )
+    return
+  forwarding.value = item.lead
+  try {
+    const outcome = sendOutcome(
+      await call('omni_crm.api.messenger_tab.forward', {
+        doctype: props.doctype,
+        name: props.docname,
+        message_doctype: msg.doctype,
+        message: msg.name,
+        target_lead: item.lead,
+      }),
+    )
+    if (outcome.ok) toast.success(__('Đã chuyển tiếp'))
+    else toast.error(__(outcome.error))
+    if (forwardMsg.value === msg) closeForward()
+    conversation.reload()
+  } catch (error) {
+    toast.error(errorText(error, __('Không chuyển tiếp được tin')))
+  } finally {
+    forwarding.value = ''
+  }
+}
+
+// Tóm tắt, ý định, mức gấp, điểm do bot phân tích ghi vào Lead (cùng hàm `_bot` của tab Zalo ở máy chủ).
+const bot = computed(() => botCard(conversation.data?.bot))
+function chipLabel(chip) {
+  if (chip.key === 'intent') return __('Ý định: {0}', [chip.value])
+  if (chip.key === 'urgency') return __('Mức gấp: {0}', [chip.value])
+  return __('Điểm: {0}', [chip.value])
+}
+
+// Hộp thư Meta Business Suite: liên kết do máy chủ dựng (mở đúng Page); chỉ nhận https://business.facebook.com/.
+const contact = computed(() => conversation.data?.contact || null)
+const directInbox = computed(() => Boolean(metaInboxUrl(contact.value)))
+const contactNames = computed(() => {
+  const c = contact.value
+  if (!c) return ''
+  return [...new Set([c.lead_name, c.display_name].filter(Boolean))].join(' / ')
+})
+
+function openInbox() {
+  if (!openMetaInbox(contact.value))
+    toast.error(__('Trình duyệt chặn cửa sổ mới'))
+}
+
+function senderLabel(msg) {
+  const source = sourceOf(msg)
+  if (source === 'customer') return msg.sender
+  if (source === 'bot') return `${__('Bot')} · ${msg.sender}`
+  if (source === 'echo') return __('Nhân viên (ngoài hệ thống)')
+  return `${__('Sale')} · ${msg.sender}`
+}
+
+function statusText(msg) {
+  if (msg.status === 'Queued' || msg.queued) return __('Đang gửi...')
+  if (msg.status === 'Blocked') return msg.error || __('Bị chặn, chưa gửi')
+  if (msg.status === 'Failed') return msg.error || __('Gửi lỗi')
+  return ''
+}
+
+function scrollToBottom() {
+  const el = scroller.value
+  if (el) el.scrollTop = el.scrollHeight
+}
+
+function reload() {
+  if (sending.value) return
+  conversation.reload()
+}
+
+function onPickFile(event) {
+  const file = event.target.files?.[0]
+  event.target.value = '' // chọn lại cùng tệp vẫn kích hoạt change
+  if (!file) return
+  const check = checkMessengerFile(file, compose.value)
+  if (check.error) {
+    toast.error(__(check.error))
+    return
+  }
+  pickedFile.value = file
+}
+
+function clearFile() {
+  pickedFile.value = null
+}
+
+// Enter gửi; Shift+Enter xuống dòng. Bỏ qua Enter khi bộ gõ tiếng Việt đang ghép chữ (không gửi nửa chừng).
+function onEnter(event) {
+  if (event.isComposing || event.keyCode === 229) return
+  event.preventDefault()
+  submit()
+}
+
+// Tải tệp lên CRM (gắn vào Lead/Deal đang mở, riêng tư) như tab Zalo, trả file_url. Máy chủ kiểm lại tệp thuộc Lead.
+async function uploadToCrm(file) {
+  if (uploaded?.file === file) return uploaded.url
+  const url = await postUpload(file)
+  uploaded = { file, url }
+  return url
+}
+
+// Một lần gọi upload_file (dùng chung cho 📎 và bản ghi âm), trả file_url hoặc ném lỗi có câu của máy chủ.
+async function postUpload(file) {
+  const form = new FormData()
+  form.append('file', file, file.name)
+  form.append('doctype', props.doctype)
+  form.append('docname', props.docname)
+  form.append('is_private', '1')
+  const resp = await fetch('/api/method/upload_file', {
+    method: 'POST',
+    headers: {
+      Accept: 'application/json',
+      'X-Frappe-CSRF-Token': window.csrf_token,
+    },
+    body: form,
+  })
+  const data = await resp.json().catch(() => ({}))
+  const result = parseUploadResponse(resp.ok, data)
+  if (!result.url)
+    throw new Error(result.error || __('Không tải được tệp lên CRM'))
+  return result.url
+}
+
+function applyOutcome(res) {
+  const outcome = sendOutcome(res)
+  if (outcome.clearText) {
+    text.value = ''
+    replyTo.value = null // tin đi đầu (mang trích dẫn) đã xếp hàng
+  }
+  if (outcome.clearFile) {
+    pickedFile.value = null
+    uploaded = null
+  }
+  if (!outcome.ok) toast.error(__(outcome.error))
+}
+
+async function submit() {
+  if (
+    !canSubmitMessenger(
+      compose.value,
+      text.value,
+      pickedFile.value,
+      sending.value,
+      compose.value.max_chars,
+    )
+  )
+    return
+  const file = pickedFile.value
+  const body = text.value
+  const reply = replyPayload(replyTo.value) // ADR 0027: trả lời một tin cụ thể
+  sending.value = true // giữ cờ đến khi xong cả tải tệp lẫn gửi: không gửi đôi
+  try {
+    if (file) {
+      const fileUrl = await uploadToCrm(file)
+      applyOutcome(
+        await call('omni_crm.api.messenger_tab.send_attachment', {
+          doctype: props.doctype,
+          name: props.docname,
+          file_url: fileUrl,
+          text: body,
+          ...reply,
+        }),
+      )
+    } else {
+      applyOutcome(
+        await call('omni_crm.api.messenger_tab.send', {
+          doctype: props.doctype,
+          name: props.docname,
+          text: body,
+          ...reply,
+        }),
+      )
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] ||
+        error?.message ||
+        (file
+          ? __('Không gửi được ảnh/tệp qua Messenger')
+          : __('Không gửi được tin Messenger')),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// Realtime: payload chỉ có {lead, channels}, không có nội dung tin; nhận tín hiệu rồi tải lại qua API có kiểm quyền.
+let timer = null
+let poll = null
+function onUpdate(payload) {
+  if (!isMessengerUpdate(payload, conversation.data?.lead)) return
+  clearTimeout(timer)
+  timer = setTimeout(reload, 500)
+}
+
+function onVisible() {
+  if (!document.hidden) reload()
+}
+
+onMounted(() => {
+  $socket?.on(ZALO_EVENT, onUpdate) // cùng sự kiện `omni_inbox_update` của Hộp thư, lọc theo kênh Meta Messenger
+  // Dự phòng khi mất kết nối realtime; tab trình duyệt ẩn thì không thăm dò, hiện lại thì tải ngay.
+  poll = setInterval(() => {
+    if (!document.hidden) reload()
+  }, POLL_MS)
+  document.addEventListener('visibilitychange', onVisible)
+})
+
+onBeforeUnmount(() => {
+  $socket?.off(ZALO_EVENT, onUpdate)
+  clearInterval(poll)
+  document.removeEventListener('visibilitychange', onVisible)
+  clearTimeout(timer)
+  clearTimeout(flashTimer)
+})
+
+watch(
+  () => [props.doctype, props.docname],
+  () => {
+    replyTo.value = null // tin đang trả lời thuộc Lead cũ
+    cancelVoice() // bản ghi âm dở và tin đang chuyển tiếp thuộc Lead cũ
+    closeForward()
+    conversation.reload()
+    resetTemplates() // mẫu đã điền theo Lead cũ: tải lại khi mở bảng chọn
+  },
+)
+</script>
