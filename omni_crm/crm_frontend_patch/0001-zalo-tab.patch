+import { createResource } from 'frappe-ui'
+import { ref } from 'vue'
+
+// Tab "Trợ lý" (omni_crm V3-05) chỉ hiện khi app omni_crm đã cài và công tắc Omni Settings.assistant_enabled bật.
+// Không có omni_crm thì lời gọi lỗi và tab không hiện (CRM chạy như cũ).
+export const assistantEnabled = ref(false)
+
+createResource({
+  url: 'omni_crm.assistant.api.tab_state',
+  cache: 'Omni Assistant Tab Enabled',
+  auto: true,
+  onSuccess: (data) => {
