+        >
+        <span v-if="bot.analyzedAt" class="ml-auto text-xs text-ink-gray-5">{{
+          __('Phân tích lúc {0}', [bot.analyzedAt])
+        }}</span>
+      </div>
+      <div
+        v-if="bot.summary"
+        class="mt-1.5 max-h-[40vh] overflow-y-auto whitespace-pre-wrap break-words text-base leading-relaxed text-ink-gray-8"
+      >
+        {{ bot.summary }}
+      </div>
+    </div>
+    <div
+      ref="scroller"
+      class="min-h-0 flex-1 overflow-y-auto px-3 pb-3 sm:px-10"
+    >
+      <div
+        v-if="conversation.loading && !conversation.data"
+        class="flex items-center justify-center gap-3 py-10 text-ink-gray-4"
+      >
+        <LoadingIndicator class="h-5 w-5" />
+        <span>{{ __('Loading...') }}</span>
+      </div>
+      <div
+        v-else-if="loadFailed"
+        class="py-10 text-center text-base text-ink-red-3"
+      >
+        {{ __('Không tải được hội thoại Zalo. Thử tải lại trang.') }}
+      </div>
+      <div
+        v-else-if="!messages.length"
+        class="py-10 text-center text-base text-ink-gray-5"
+      >
+        {{ __('Chưa có tin nhắn Zalo nào với khách này.') }}
+      </div>
+      <template v-else>
+        <div
+          v-if="conversation.data?.truncated"
+          class="pb-2 text-center text-sm text-ink-gray-5"
+        >
+          {{ __('Chỉ hiện các tin gần nhất. Xem đầy đủ trong Hộp thư Omni.') }}
+        </div>
+        <div v-for="group in groups" :key="group.day">
+          <div class="py-2 text-center text-xs text-ink-gray-5">
+            {{ dayLabel(group.day) }}
+          </div>
+          <div
+            v-for="msg in group.items"
+            :key="msg.name"
+            class="activity mb-2 flex"
+            :class="
+              bubbleSide(msg) === 'right' ? 'justify-end' : 'justify-start'
+            "
+          >
+            <div
+              :class="[
+                'max-w-[85%] rounded-lg px-3 py-1.5 text-base text-ink-gray-9 shadow-sm',
+                bubbleSide(msg) === 'right'
+                  ? 'bg-blue-100'
+                  : 'bg-surface-gray-2',
+                msg.status === 'Failed' || msg.status === 'Blocked'
+                  ? 'border border-red-400'
+                  : '',
+              ]"
+            >
+              <div class="mb-0.5 text-xs text-ink-gray-5">
+                {{ senderLabel(msg) }}
+              </div>
+              <div v-if="msg.text" class="whitespace-pre-wrap break-words">
+                {{ msg.text }}
+              </div>
+              <div
+                v-for="att in safeAttachments(msg.attachments)"
+                :key="att.url"
+                class="mt-1 text-sm"
+              >
+                <a
+                  :href="att.url"
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  class="text-ink-blue-3 underline"
+                  >{{ att.name }}</a
+                >
+              </div>
+              <div
+                v-if="msg.sandbox"
+                class="mt-1 text-xs italic text-ink-gray-6"
+              >
+                {{ __('Thử nghiệm (sandbox), chưa gửi tới khách') }}
+              </div>
+              <div v-if="statusText(msg)" class="mt-1 text-xs text-ink-red-3">
+                {{ statusText(msg) }}
+              </div>
+              <div class="mt-0.5 text-right text-xs text-ink-gray-5">
+                {{ timeLabel(msg.at) }}
+              </div>
+            </div>
+          </div>
+        </div>
+      </template>
+    </div>
+
+    <div
+      v-if="contact"
+      class="border-t px-3 py-2 text-sm text-ink-gray-7 sm:px-10"
+    >
+      <div class="flex flex-wrap items-center gap-2">
+        <Button :label="__('Mở chat Zalo OA')" @click="openChat" />
+        <span v-if="panelMode === 'direct' && contactNames">{{
+          __('Mở chat với {0}', [contactNames])
+        }}</span>
+      </div>
+      <!-- Dự phòng khi thiếu mã Zalo hoặc mã OA: không mở thẳng được hội thoại, phải tìm tay -->
+      <div
+        v-if="panelMode === 'fallback'"
+        class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1"
+      >
+        <span>{{
+          __(
+            'Chưa mở thẳng được hội thoại. Trong danh sách chat, tìm khách theo tên hoặc mã Zalo:',
+          )
+        }}</span>
+        <span v-if="contactNames" class="font-medium text-ink-gray-9">{{
+          contactNames
+        }}</span>
+        <template v-if="contact.zalo_user_id">
+          <span :title="contact.zalo_user_id">{{
+            __('Mã') + ' ' + shortZaloId(contact.zalo_user_id)
+          }}</span>
+          <Button
+            size="sm"
+            variant="ghost"
+            :label="__('Sao chép')"
+            @click="copyId"
+          />
+        </template>
+      </div>
+      <div v-if="contact.name_note" class="mt-1 text-xs text-ink-gray-5">
+        {{ contact.name_note }}
+      </div>
+    </div>
+
+    <div class="border-t px-3 py-2.5 sm:px-10">
+      <div
+        v-if="!compose.can_send"
+        class="mb-2 rounded bg-surface-gray-2 px-3 py-2 text-sm text-ink-gray-7"
+      >
+        {{ compose.reason }}
+      </div>
+      <div
+        v-else-if="compose.paid && compose.message"
+        class="mb-2 rounded border border-amber-400 px-3 py-2 text-sm text-ink-gray-8"
+      >
+        {{ compose.message }}
+      </div>
+      <div
+        v-if="compose.sandbox && compose.linked"
+        class="mb-1 text-xs text-ink-gray-5"
+      >
+        {{
+          __('Chế độ thử: tin gửi chỉ được ghi lại, không gửi thật tới khách.')
+        }}
+      </div>
+      <div v-if="compose.quota" class="mb-1 text-xs text-ink-gray-5">
+        {{ compose.quota.text }}
+      </div>
+      <div class="flex items-end gap-2">
+        <Textarea
+          v-model="text"
+          type="textarea"
+          class="min-h-8 w-full"
+          :rows="3"
+          :disabled="!compose.can_send"
+          :placeholder="__('Nhập tin trả lời Zalo')"
+          @keydown.enter.exact.prevent="submit(0)"
+        />
+        <Button
+          variant="solid"
+          :label="__('Gửi qua Zalo')"
+          :loading="sending"
+          :disabled="!canSubmit(compose, text, sending, compose.max_chars)"
+          @click="submit(0)"
+        />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { computed, nextTick, onBeforeUnmount, onMounted, ref, watch } from 'vue'
+import {
+  Button,
+  LoadingIndicator,
+  Textarea,
+  call,
+  createResource,
+  toast,
+} from 'frappe-ui'
+import { globalStore } from '@/stores/global'
+import {
+  POLL_MS,
+  ZALO_EVENT,
+  botCard,
+  bubbleSide,
+  canSubmit,
+  dayLabel,
+  groupByDay,
+  chatPanelMode,
+  copyToClipboard,
+  isRelevantUpdate,
+  openOaChat,
+  shortZaloId,
+  safeAttachments,
+  sourceOf,
+  timeLabel,
+} from '@/utils/zaloThread'
+
+const props = defineProps({
+  doctype: { type: String, required: true },
+  docname: { type: String, required: true },
+})
+
+const { $socket } = globalStore()
+
+const text = ref('')
+const sending = ref(false)
+const scroller = ref(null)
+const loadFailed = ref(false)
+
+// Dữ liệu và mọi guard (khung 48 giờ, hạn mức, từ chối liên hệ, sandbox) nằm ở máy chủ: omni_crm.api.zalo_tab.
+const conversation = createResource({
+  url: 'omni_crm.api.zalo_tab.get_conversation',
+  makeParams: () => ({ doctype: props.doctype, name: props.docname }),
+  auto: true,
+  onSuccess: () => {
+    loadFailed.value = false
+    nextTick(scrollToBottom)
+  },
+  onError: () => {
+    loadFailed.value = true
+  },
+})
+
+const messages = computed(() => conversation.data?.messages || [])
+const groups = computed(() => groupByDay(messages.value))
+const compose = computed(
+  () =>
+    conversation.data?.compose || {
+      can_send: false,
+      reason: '',
+      paid: false,
+      message: '',
+      sandbox: false,
+      quota: null,
+      linked: false,
+    },
+)
+
+// Nhắn từ trang chính thức của Zalo OA (OA gói Cơ bản không gửi được qua API). Zalo không mở thẳng hội thoại theo
+// tham số, nên chỉ hiện thông tin để nhân viên tự tìm khách. Zalo chặn nhúng trang chat vào khung (đã thử): chỉ có nút mở cửa sổ riêng.
+const contact = computed(() => conversation.data?.contact || null)
+
+// Tóm tắt, ý định, mức gấp, điểm do bot phân tích ghi vào Lead (omni_crm.api.zalo_tab._bot).
+const bot = computed(() => botCard(conversation.data?.bot))
+function chipLabel(chip) {
+  if (chip.key === 'intent') return __('Ý định: {0}', [chip.value])
+  if (chip.key === 'urgency') return __('Mức gấp: {0}', [chip.value])
+  return __('Điểm: {0}', [chip.value])
+}
+const panelMode = computed(() => chatPanelMode(contact.value))
+const contactNames = computed(() => {
+  const c = contact.value
+  if (!c) return ''
+  return [...new Set([c.lead_name, c.display_name].filter(Boolean))].join(' / ')
+})
+
+function openChat() {
+  if (!openOaChat(contact.value)) toast.error(__('Trình duyệt chặn cửa sổ mới'))
+}
+
+async function copyId() {
+  const res = await copyToClipboard(contact.value?.zalo_user_id)
+  if (res.ok) toast.success(__('Đã sao chép mã Zalo'))
+  else toast.error(__('Không sao chép được, hãy chọn và chép tay'))
+}
+
+function senderLabel(msg) {
+  const source = sourceOf(msg)
+  if (source === 'customer') return msg.sender
+  if (source === 'bot') return `${__('Bot')} · ${msg.sender}`
+  if (source === 'echo') return __('Nhân viên (ngoài hệ thống)')
+  return `${__('Sale')} · ${msg.sender}`
+}
+
+function statusText(msg) {
+  if (msg.status === 'Queued' || msg.queued) return __('Đang gửi...')
+  if (msg.status === 'Blocked') return msg.error || __('Bị chặn, chưa gửi')
+  if (msg.status === 'Failed') return msg.error || __('Gửi lỗi')
+  return ''
+}
+
+function scrollToBottom() {
+  const el = scroller.value
+  if (el) el.scrollTop = el.scrollHeight
+}
+
+function reload() {
+  if (sending.value) return
+  conversation.reload()
+}
+
+async function submit(confirmPaid) {
+  if (
+    !canSubmit(
+      compose.value,
+      text.value,
+      sending.value,
+      compose.value.max_chars,
+    )
+  )
+    return
+  const body = text.value
+  sending.value = true
+  try {
+    const res = await call('omni_crm.api.zalo_tab.send', {
+      doctype: props.doctype,
+      name: props.docname,
+      text: body,
+      confirm_paid: confirmPaid,
+    })
+    if (res?.status === 'confirm_required') {
+      if (window.confirm(`${res.warning}\n\n${__('Bạn vẫn muốn gửi?')}`)) {
+        sending.value = false
+        return submit(1)
+      }
+    } else if (res?.status === 'Blocked') {
+      toast.error(res.reason || __('Tin bị chặn, chưa gửi'))
+    } else {
+      text.value = ''
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] || error?.message || __('Không gửi được tin Zalo'),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// Realtime: payload chỉ có {lead, channels}, không có nội dung tin; nhận tín hiệu rồi tải lại qua API có kiểm quyền.
+let timer = null
+let poll = null
+function onUpdate(payload) {
+  if (!isRelevantUpdate(payload, conversation.data?.lead)) return
+  clearTimeout(timer)
+  timer = setTimeout(reload, 500)
+}
+
+onMounted(() => {
+  $socket?.on(ZALO_EVENT, onUpdate)
+  poll = setInterval(reload, POLL_MS) // dự phòng khi mất kết nối realtime
+})
+
+onBeforeUnmount(() => {
+  $socket?.off(ZALO_EVENT, onUpdate)
+  clearInterval(poll)
+  clearTimeout(timer)
+})
+
+watch(
+  () => [props.doctype, props.docname],
+  () => conversation.reload(),
+)
+</script>
