+<template>
+  <div class="flex h-full min-h-0 flex-col overflow-hidden">
+    <div
+      v-if="session"
+      class="flex shrink-0 items-center justify-between gap-2 border-b px-3 py-1.5 sm:px-5"
+    >
+      <span class="text-sm text-ink-gray-5">{{
