+// --- Sale gửi ảnh / tệp qua Messenger (ADR 0023 mục 4) ---
+
+/** Danh sách đuôi mặc định, trùng `omni_crm.channels.meta_messenger.media_out.ACCEPT` (máy chủ gửi kèm trong `compose`). */
+export const DEFAULT_MEDIA_ACCEPT =
+  '.jpg,.jpeg,.png,.gif,.mp4,.mp3,.m4a,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip'
+export const DEFAULT_MEDIA_MAX_MB = 25
+
+const KIND_BY_EXT = {
+  '.jpg': 'image',
+  '.jpeg': 'image',
+  '.png': 'image',
+  '.gif': 'image',
+  '.mp4': 'video',
+  '.mp3': 'audio',
+  '.m4a': 'audio',
+}
+
+/** Đuôi tệp được nhận (chữ thường, có dấu chấm) từ chuỗi `accept` của máy chủ; rỗng hoặc lạ thì dùng danh sách mặc định. */
