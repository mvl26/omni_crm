+    expect(
+      canSubmitWithFile(open, 'x'.repeat(2001), f('a.png', 10), false),
+    ).toBe(false)
+    expect(canSubmitWithFile(open, '', null, false)).toBe(false) // không tệp: như canSubmit cũ
+    expect(canSubmitWithFile(open, 'chào', null, false)).toBe(true)
+  })
+
+  it('đuôi tệp', () => {
