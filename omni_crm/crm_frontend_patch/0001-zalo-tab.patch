+
+<script setup>
+import {
+  computed,
+  nextTick,
+  onBeforeUnmount,
+  onMounted,
+  reactive,
+  ref,
+  watch,
+} from 'vue'
+import {
+  Button,
+  LoadingIndicator,
+  Popover,
+  TextInput,
+  Textarea,
+  call,
+  createResource,
+  toast,
+} from 'frappe-ui'
+import { globalStore } from '@/stores/global'
+import { useMessengerTemplates } from '@/composables/messenger'
+import {
+  POLL_MS,
+  ZALO_EVENT,
+  botCard,
+  bubbleSide,
+  dayLabel,
+  groupByDay,
+  sourceOf,
+  timeLabel,
+} from '@/utils/zaloThread'
+import {
+  acceptList,
+  applyTemplate,
+  canSubmitMessenger,
+  checkMessengerFile,
+  formatSize,
+  isMessengerUpdate,
+  mediaMaxBytes,
+  messengerAttachmentViews,
+  metaInboxUrl,
+  openMetaInbox,
+  overLimit,
+  parseUploadResponse,
+  sendOutcome,
+} from '@/utils/messengerThread'
+
+const props = defineProps({
+  doctype: { type: String, required: true },
+  docname: { type: String, required: true },
+})
+
+const { $socket } = globalStore()
+
+const text = ref('')
+const sending = ref(false)
+const fileInput = ref(null)
+const pickedFile = ref(null) // ảnh/tệp sale chọn, chưa gửi
+let uploaded = null // { file, url }: tệp đã tải lên CRM, dùng lại nếu sale bấm gửi lần nữa (không tải trùng)
+const scroller = ref(null)
+const loadFailed = ref(false)
+const broken = reactive({}) // ảnh / video / âm thanh tải lỗi: rơi về liên kết có nhãn
+
+// Dữ liệu và mọi guard (luật 24 giờ, từ chối liên hệ, sandbox, độ dài, loại/cỡ tệp) nằm ở máy chủ: omni_crm.api.messenger_tab.
+const conversation = createResource({
+  url: 'omni_crm.api.messenger_tab.get_conversation',
+  makeParams: () => ({ doctype: props.doctype, name: props.docname }),
+  auto: true,
+  onSuccess: () => {
+    loadFailed.value = false
+    nextTick(scrollToBottom)
+  },
+  onError: () => {
+    loadFailed.value = true
+  },
+})
+
+const messages = computed(() => conversation.data?.messages || [])
+const groups = computed(() => groupByDay(messages.value))
+const compose = computed(
+  () =>
+    conversation.data?.compose || {
+      can_send: false,
+      reason: '',
+      sandbox: false,
+      linked: false,
+      can_send_media: false,
+    },
+)
+const maxMb = computed(() =>
+  Math.round(mediaMaxBytes(compose.value.media_max_mb) / (1024 * 1024)),
+)
+const textTooLong = computed(() =>
+  overLimit(text.value, compose.value.max_chars),
+)
+
+// Mẫu tin nhắn (ADR 0026): omni_crm.api.messenger_tab.get_templates, tải khi bảng chọn mở lần đầu, không thăm dò.
+const composer = ref(null)
+const {
+  resource: templates,
+  query: templateQuery,
+  items: templateItems,
+  shown: shownTemplates,
+  showSearch: showTemplateSearch,
+  load: loadTemplates,
+  reset: resetTemplates,
+} = useMessengerTemplates(() => ({
+  doctype: props.doctype,
+  name: props.docname,
+}))
+
+function toggleTemplates(togglePopover, isOpen) {
+  if (!isOpen) {
+    templateQuery.value = ''
+    loadTemplates()
+  }
+  togglePopover()
+}
+
+// Chỉ điền vào ô soạn: ô đang có chữ khác thì hỏi trước khi thay (cùng kiểu window.confirm của tab Zalo). Không tự gửi.
+function chooseTemplate(item, close) {
+  if (item.error) return
+  const result = applyTemplate(text.value, item.text)
+  close()
+  if (
+    result.needsConfirm &&
+    !window.confirm(
+      __('Ô soạn đang có chữ. Thay bằng mẫu "{0}"?', [item.title]),
+    )
+  )
+    return
+  text.value = result.text
+  nextTick(focusComposerEnd)
+}
+
+function focusComposerEnd() {
+  const el = composer.value?.$el?.querySelector?.('textarea')
+  if (!el) return
+  el.focus()
+  const end = el.value.length
+  el.setSelectionRange(end, end)
+  el.scrollTop = el.scrollHeight
+}
+
+// Tóm tắt, ý định, mức gấp, điểm do bot phân tích ghi vào Lead (cùng hàm `_bot` của tab Zalo ở máy chủ).
+const bot = computed(() => botCard(conversation.data?.bot))
+function chipLabel(chip) {
+  if (chip.key === 'intent') return __('Ý định: {0}', [chip.value])
+  if (chip.key === 'urgency') return __('Mức gấp: {0}', [chip.value])
+  return __('Điểm: {0}', [chip.value])
+}
+
+// Hộp thư Meta Business Suite: liên kết do máy chủ dựng (mở đúng Page); chỉ nhận https://business.facebook.com/.
+const contact = computed(() => conversation.data?.contact || null)
+const directInbox = computed(() => Boolean(metaInboxUrl(contact.value)))
+const contactNames = computed(() => {
+  const c = contact.value
+  if (!c) return ''
+  return [...new Set([c.lead_name, c.display_name].filter(Boolean))].join(' / ')
+})
+
+function openInbox() {
+  if (!openMetaInbox(contact.value))
+    toast.error(__('Trình duyệt chặn cửa sổ mới'))
+}
+
+function senderLabel(msg) {
+  const source = sourceOf(msg)
+  if (source === 'customer') return msg.sender
+  if (source === 'bot') return `${__('Bot')} · ${msg.sender}`
+  if (source === 'echo') return __('Nhân viên (ngoài hệ thống)')
+  return `${__('Sale')} · ${msg.sender}`
+}
+
+function statusText(msg) {
+  if (msg.status === 'Queued' || msg.queued) return __('Đang gửi...')
+  if (msg.status === 'Blocked') return msg.error || __('Bị chặn, chưa gửi')
+  if (msg.status === 'Failed') return msg.error || __('Gửi lỗi')
+  return ''
+}
+
+function scrollToBottom() {
+  const el = scroller.value
+  if (el) el.scrollTop = el.scrollHeight
+}
+
+function reload() {
+  if (sending.value) return
+  conversation.reload()
+}
+
+function onPickFile(event) {
+  const file = event.target.files?.[0]
+  event.target.value = '' // chọn lại cùng tệp vẫn kích hoạt change
+  if (!file) return
+  const check = checkMessengerFile(file, compose.value)
+  if (check.error) {
+    toast.error(__(check.error))
+    return
+  }
+  pickedFile.value = file
+}
+
+function clearFile() {
+  pickedFile.value = null
+}
+
+// Enter gửi; Shift+Enter xuống dòng. Bỏ qua Enter khi bộ gõ tiếng Việt đang ghép chữ (không gửi nửa chừng).
+function onEnter(event) {
+  if (event.isComposing || event.keyCode === 229) return
+  event.preventDefault()
+  submit()
+}
+
+// Tải tệp lên CRM (gắn vào Lead/Deal đang mở, riêng tư) như tab Zalo, trả file_url. Máy chủ kiểm lại tệp thuộc Lead.
+async function uploadToCrm(file) {
+  if (uploaded?.file === file) return uploaded.url
+  const form = new FormData()
+  form.append('file', file, file.name)
+  form.append('doctype', props.doctype)
+  form.append('docname', props.docname)
+  form.append('is_private', '1')
+  const resp = await fetch('/api/method/upload_file', {
+    method: 'POST',
+    headers: {
+      Accept: 'application/json',
+      'X-Frappe-CSRF-Token': window.csrf_token,
+    },
+    body: form,
+  })
+  const data = await resp.json().catch(() => ({}))
+  const result = parseUploadResponse(resp.ok, data)
+  if (!result.url)
+    throw new Error(result.error || __('Không tải được tệp lên CRM'))
+  uploaded = { file, url: result.url }
+  return result.url
+}
+
+function applyOutcome(res) {
+  const outcome = sendOutcome(res)
+  if (outcome.clearText) text.value = ''
+  if (outcome.clearFile) {
+    pickedFile.value = null
+    uploaded = null
+  }
+  if (!outcome.ok) toast.error(__(outcome.error))
+}
+
+async function submit() {
+  if (
+    !canSubmitMessenger(
+      compose.value,
+      text.value,
+      pickedFile.value,
+      sending.value,
+      compose.value.max_chars,
+    )
+  )
+    return
+  const file = pickedFile.value
+  const body = text.value
+  sending.value = true // giữ cờ đến khi xong cả tải tệp lẫn gửi: không gửi đôi
+  try {
+    if (file) {
+      const fileUrl = await uploadToCrm(file)
+      applyOutcome(
+        await call('omni_crm.api.messenger_tab.send_attachment', {
+          doctype: props.doctype,
+          name: props.docname,
+          file_url: fileUrl,
+          text: body,
+        }),
+      )
+    } else {
+      applyOutcome(
+        await call('omni_crm.api.messenger_tab.send', {
+          doctype: props.doctype,
+          name: props.docname,
+          text: body,
+        }),
+      )
+    }
+  } catch (error) {
+    toast.error(
+      error?.messages?.[0] ||
+        error?.message ||
+        (file
+          ? __('Không gửi được ảnh/tệp qua Messenger')
+          : __('Không gửi được tin Messenger')),
+    )
+  } finally {
+    sending.value = false
+    conversation.reload()
+  }
+}
+
+// Realtime: payload chỉ có {lead, channels}, không có nội dung tin; nhận tín hiệu rồi tải lại qua API có kiểm quyền.
+let timer = null
+let poll = null
+function onUpdate(payload) {
+  if (!isMessengerUpdate(payload, conversation.data?.lead)) return
+  clearTimeout(timer)
+  timer = setTimeout(reload, 500)
+}
+
+function onVisible() {
+  if (!document.hidden) reload()
+}
+
+onMounted(() => {
+  $socket?.on(ZALO_EVENT, onUpdate) // cùng sự kiện `omni_inbox_update` của Hộp thư, lọc theo kênh Meta Messenger
+  // Dự phòng khi mất kết nối realtime; tab trình duyệt ẩn thì không thăm dò, hiện lại thì tải ngay.
+  poll = setInterval(() => {
+    if (!document.hidden) reload()
+  }, POLL_MS)
+  document.addEventListener('visibilitychange', onVisible)
+})
+
+onBeforeUnmount(() => {
+  $socket?.off(ZALO_EVENT, onUpdate)
+  clearInterval(poll)
+  document.removeEventListener('visibilitychange', onVisible)
+  clearTimeout(timer)
+})
+
+watch(
+  () => [props.doctype, props.docname],
+  () => {
+    conversation.reload()
+    resetTemplates() // mẫu đã điền theo Lead cũ: tải lại khi mở bảng chọn
+  },
+)
+</script>
