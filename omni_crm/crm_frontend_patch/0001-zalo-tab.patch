+    }
+    expect(await sendWithConfirm(send, () => false, 'x')).toBeNull()
+    expect(n).toBe(1)
+  })
+  it('lỗi ở lần gọi nào cũng ném ra cho người gọi', async () => {
+    const send = async () => {
+      throw new Error('mạng')
+    }
+    await expect(sendWithConfirm(send, () => true, 'x')).rejects.toThrow('mạng')
+  })
+})
