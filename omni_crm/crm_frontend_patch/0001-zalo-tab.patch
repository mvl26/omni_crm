diff --git a/frontend/src/components/SidePanelLayout.vue b/frontend/src/components/SidePanelLayout.vue
index 592f215..809b322 100644
--- a/frontend/src/components/SidePanelLayout.vue
+++ b/frontend/src/components/SidePanelLayout.vue
@@ -629,6 +629,24 @@ function firstVisibleIndex() {
   margin: 2px;
 }
 
+/* omni_crm (ADR 0016 mục 12): ô chữ nhiều dòng (Tóm tắt của bot, Nhu cầu...) cao theo nội dung thay vì cố định 3 dòng.
+   Trình duyệt chưa hỗ trợ field-sizing giữ 3 dòng và kéo giãn tay được. */
+:deep(.form-control textarea) {
+  field-sizing: content;
+  min-height: 2.25rem;
+  max-height: 60vh;
+  resize: vertical;
+}
+
+/* omni_crm: trường CHỈ ĐỌC dạng chữ (Tóm tắt của bot...) mặc định nằm trong khung cao cố định h-7 nên bị cắt;
