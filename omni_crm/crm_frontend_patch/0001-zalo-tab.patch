+// Hàm thuần cho tab "Zalo" (omni_crm, V3-01): nhóm bong bóng, nhãn, lọc URL an toàn. Không phụ thuộc Vue/DOM.
+
+export const ZALO_EVENT = 'omni_inbox_update'
+export const POLL_MS = 60000
+
+/** Có ký tự điều khiển, khoảng trắng hoặc `\` (trình duyệt coi `\` như `/`, nên `https://evil.com\@zdn.vn` trỏ tới evil.com). */
+function hasBadChars(url) {
+  for (const ch of String(url)) {
+    const code = ch.codePointAt(0)
+    if (
+      ch === '\\' ||
+      code <= 0x20 ||
+      (code >= 0x7f && code <= 0xa0) ||
+      code === 0x2028 ||
+      code === 0x2029 ||
+      code === 0xfeff
+    )
+      return true
+  }
+  return false
+}
+
+/** Chỉ cho phép liên kết http(s) sạch; mọi thứ khác (javascript:, data:, /files/...) bị bỏ. Không `\`, ký tự điều khiển, khoảng trắng. */
+export function isSafeUrl(url) {
+  const value = String(url || '')
+  return /^https?:\/\//i.test(value) && !hasBadChars(value)
+}
+
+/** Danh sách đính kèm đã lọc: chỉ URL http(s), mỗi mục có name để hiển thị; giữ type và thumb nếu có. */
+export function safeAttachments(list) {
+  if (!Array.isArray(list)) return []
+  return list
+    .filter((a) => a && isSafeUrl(a.url))
+    .map((a) => ({
+      url: String(a.url).trim(),
+      name: String(a.name || a.url).slice(0, 120),
+      ...(a.type ? { type: String(a.type).toLowerCase().slice(0, 30) } : {}),
+      ...(a.thumb && isSafeUrl(a.thumb)
+        ? { thumb: String(a.thumb).trim() }
+        : {}),
+    }))
+}
+
+// --- Ảnh / GIF / sticker / tệp khách gửi (V3-05, ADR 0018) ---
+
+/** Hậu tố host CDN Zalo được phép làm src ảnh nội tuyến (khớp danh sách ở máy chủ: omni_crm/utils/media.py). */
+export const ZALO_MEDIA_HOST_SUFFIXES = [
+  'zdn.vn',
+  'zadn.vn',
+  'zaloapp.com',
+  'zalo.me',
+]
+export const INLINE_IMAGE_TYPES = ['image', 'gif', 'sticker']
+
+const TYPE_LABELS = {
+  image: 'Ảnh',
+  gif: 'GIF',
+  sticker: 'Sticker',
+  video: 'Video',
+  link: 'Liên kết',
+  business_card: 'Danh thiếp',
+  audio: 'Tin thoại',
+  location: 'Vị trí',
+  file: 'Tệp',
+}
+
+/**
+ * Được vẽ thành ảnh nội tuyến khi: (1) https tới host CDN Zalo (đúng host hoặc tên miền con), không userinfo, không cổng khác
+ * 443, không `\`/ký tự điều khiển/khoảng trắng; hoặc (2) đường dẫn nội bộ /files, /private/files không có `..` hay `//`
+ * (giống máy chủ `omni_crm/utils/media.py`; tab Zalo hiện tại không nhận /files nhưng hai bên giữ cùng luật).
+ */
+export function isInlineImageUrl(url) {
+  const value = String(url || '')
+  if (!value || hasBadChars(value)) return false
+  if (/^\/(?:private\/)?files\//.test(value)) {
+    const path = value.split(/[?#]/)[0].toLowerCase()
+    return (
+      !path.includes('//') &&
+      !path
+        .split('/')
+        .some((seg) => ['..', '%2e%2e', '.%2e', '%2e.'].includes(seg))
+    )
+  }
+  let u
+  try {
+    u = new URL(value)
+  } catch {
+    return false
+  }
+  if (u.protocol !== 'https:' || u.username || u.password) return false
+  if (u.port && u.port !== '443') return false
+  const host = u.hostname.toLowerCase()
+  return ZALO_MEDIA_HOST_SUFFIXES.some(
+    (suffix) => host === suffix || host.endsWith('.' + suffix),
+  )
+}
+
+/** Nhãn tiếng Việt của loại đính kèm ('Tệp' cho loại lạ hoặc thiếu). */
+export function attachmentLabel(type) {
+  return TYPE_LABELS[String(type || '').toLowerCase()] || 'Tệp'
+}
+
+/** Tên tệp cuối đường dẫn của URL (bỏ query); '' nếu không có. */
+export function fileNameFromUrl(url) {
+  try {
+    const path = new URL(String(url)).pathname.replace(/\/+$/, '')
+    return decodeURIComponent(path.slice(path.lastIndexOf('/') + 1)).slice(
+      0,
+      80,
+    )
+  } catch {
+    return ''
+  }
+}
+
+/** Tên thân thiện: tên khách gửi nếu không phải URL; nếu không thì tên tệp trong URL; cuối cùng là nhãn loại. Không bao giờ in URL dài. */
+export function friendlyName(att) {
+  const name = String(att?.name || '').trim()
+  if (name && !/^https?:\/\//i.test(name)) return name.slice(0, 80)
+  return fileNameFromUrl(att?.url) || attachmentLabel(att?.type)
+}
+
+/**
+ * Mô hình hiển thị cho từng đính kèm: { index, url, label, text, src }.
+ * `src` khác rỗng khi vẽ được thành ảnh (loại ảnh/GIF/sticker và host được phép); ảnh dùng thumbnail nếu host của nó cũng được
+ * phép, GIF và sticker dùng ảnh gốc (để chuyển động). Không có `src` thì chỉ hiện liên kết có nhãn `text`.
+ */
+export function attachmentViews(list) {
+  return safeAttachments(list).map((att, index) => {
+    const label = attachmentLabel(att.type)
+    const media = INLINE_IMAGE_TYPES.includes(att.type)
+    let src = ''
+    if (media && isInlineImageUrl(att.url)) {
+      src =
+        att.type === 'image' && att.thumb && isInlineImageUrl(att.thumb)
+          ? att.thumb
+          : att.url
+    }
+    return {
+      index,
+      url: att.url,
+      type: att.type || 'file',
+      label,
+      src,
+      text: media ? label : friendlyName(att),
+    }
+  })
+}
+
+const MEDIA_TAG = /\[(?:Ảnh|GIF|Sticker)\]\s*/g
+
+/** Nội dung chữ của bong bóng: bỏ nhãn thừa "[Ảnh]" / "[GIF]" / "[Sticker]" khi đã có ảnh hiển thị; giữ chú thích của khách. */
+export function displayText(msg) {
+  const text = String(msg?.text || '')
+  if (!attachmentViews(msg?.attachments).some((v) => v.src)) return text
+  return text.replace(MEDIA_TAG, '').trim()
+}
+
+/** 'left' cho khách, 'right' cho nhân viên / bot / nhân viên trả lời ngoài hệ thống. */
+export function bubbleSide(msg) {
+  return msg?.kind === 'customer' || msg?.direction === 'in' ? 'left' : 'right'
+}
+
+/** Nguồn tin: customer | sale | bot | echo. */
+export function sourceOf(msg) {
+  if (msg?.kind === 'bot' || msg?.bot_sent) return 'bot'
+  if (msg?.kind === 'echo') return 'echo'
+  if (bubbleSide(msg) === 'left') return 'customer'
+  return 'sale'
+}
+
+function parseAt(at) {
+  if (!at) return null
+  const d = new Date(String(at).replace(' ', 'T').slice(0, 19))
+  return isNaN(d.getTime()) ? null : d
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+
+/** Ngày (YYYY-MM-DD) của thời điểm; '' nếu không đọc được. */
+export function dayKey(at) {
+  const d = parseAt(at)
+  return d
+    ? `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+    : ''
+}
+
+/** Giờ:phút (HH:mm); '' nếu không đọc được. */
+export function timeLabel(at) {
+  const d = parseAt(at)
+  return d ? `${pad(d.getHours())}:${pad(d.getMinutes())}` : ''
+}
+
+/** Nhãn ngày dd/mm/yyyy cho đường phân cách ngày. */
+export function dayLabel(key) {
+  const [y, m, d] = String(key).split('-')
+  return y && m && d ? `${d}/${m}/${y}` : ''
+}
+
+/** Nhóm tin theo ngày, giữ thứ tự thời gian: [{ day, items }]. */
+export function groupByDay(messages) {
+  const groups = []
+  for (const msg of messages || []) {
+    const day = dayKey(msg.at)
+    const last = groups[groups.length - 1]
+    if (last && last.day === day) last.items.push(msg)
+    else groups.push({ day, items: [msg] })
+  }
+  return groups
+}
+
+/** Có được bấm Gửi không: khung soạn mở, có chữ, không quá giới hạn, không đang gửi. */
+export function canSubmit(compose, text, sending, maxChars = 6000) {
+  const value = String(text || '').trim()
+  return Boolean(
+    compose?.can_send && !sending && value && value.length <= maxChars,
+  )
+}
+
+/** Tín hiệu realtime `omni_inbox_update` có thuộc hội thoại đang xem không (payload chỉ có {lead, channels}). */
+export function isRelevantUpdate(payload, lead) {
+  if (!payload || !lead || payload.lead !== lead) return false
+  const channels = payload.channels
+  return (
+    !Array.isArray(channels) || !channels.length || channels.includes('Zalo OA')
+  )
+}
+
+// --- Nhắn từ trang chính thức của Zalo OA (OA gói Cơ bản không gửi được qua API) ---
+
+/** Trang chat chính thức của Zalo OA (chung, không chọn khách). */
+export const OA_CHAT_URL = 'https://oa.zalo.me/chat'
+/** Tham số cửa sổ chat: nhỏ gọn để đặt cạnh trang Lead; luôn noopener,noreferrer. */
+export function chatWindowFeatures(screenWidth = 1280, screenHeight = 800) {
+  const width = 480
+  const height = Math.max(520, Math.min(760, Number(screenHeight) - 120 || 700))
+  const left = Math.max(0, Number(screenWidth) - width - 20 || 0)
+  return `noopener,noreferrer,popup=yes,width=${width},height=${height},left=${left},top=40`
+}
+
+/**
+ * Địa chỉ mở đúng hội thoại của khách: ?uid=<mã người dùng Zalo>&oaid=<mã OA> (oaid CHỮ THƯỜNG; viết oaId thì Zalo bỏ
+ * tham số). Chỉ nhận chuỗi số; thiếu hoặc không hợp lệ một trong hai thì rơi về trang chat chung.
+ */
+export function buildOaChatUrl(contact) {
+  const uid = String(contact?.zalo_user_id ?? '').trim()
+  const oaid = String(contact?.oa_id ?? '').trim()
+  if (!/^\d{1,32}$/.test(uid) || !/^\d{1,32}$/.test(oaid)) return OA_CHAT_URL
+  return `${OA_CHAT_URL}?uid=${encodeURIComponent(uid)}&oaid=${encodeURIComponent(oaid)}`
+}
+
+/** Có mở thẳng được hội thoại của khách không (đủ cả uid và oaid hợp lệ). */
+export function hasDirectChatLink(contact) {
+  return buildOaChatUrl(contact) !== OA_CHAT_URL
+}
+
+/**
+ * Chế độ khối "Mở chat Zalo OA": 'none' (không có thông tin khách), 'direct' (mở thẳng hội thoại, chỉ cần nút),
+ * 'fallback' (thiếu uid hoặc oaid: hiện hướng dẫn tìm tay + mã để sao chép).
+ */
+export function chatPanelMode(contact) {
+  if (!contact) return 'none'
+  return hasDirectChatLink(contact) ? 'direct' : 'fallback'
+}
+
+/** Mở trang chat Zalo OA (đúng hội thoại nếu đủ thông tin) ở cửa sổ mới; trả true nếu gọi được window.open. */
+export function openOaChat(contact = null, win = globalThis.window) {
+  if (!win || typeof win.open !== 'function') return false
+  const screen = win.screen || {}
+  win.open(
+    buildOaChatUrl(contact),
+    '_blank',
+    chatWindowFeatures(screen.availWidth, screen.availHeight),
+  )
+  return true
+}
+
+/** Mã Zalo rút gọn để đọc nhanh: giữ 4 ký tự đầu và 4 cuối; mã ngắn giữ nguyên. */
+export function shortZaloId(id) {
+  const value = String(id || '').trim()
+  return value.length > 10 ? `${value.slice(0, 4)}…${value.slice(-4)}` : value
+}
+
+/** Chép chuỗi vào clipboard; không ném lỗi, trả { ok, error }. */
+export async function copyToClipboard(text, nav = globalThis.navigator) {
+  const value = String(text ?? '')
+  if (!value) return { ok: false, error: 'empty' }
+  try {
+    if (!nav?.clipboard?.writeText) return { ok: false, error: 'unsupported' }
+    await nav.clipboard.writeText(value)
+    return { ok: true, error: null }
+  } catch (e) {
+    return { ok: false, error: e?.name || 'failed' }
+  }
+}
+
+/**
+ * Gửi tin, nếu máy chủ yêu cầu xác nhận phí thì hỏi rồi gửi lần hai. Trả kết quả cuối, hoặc null khi người dùng hủy.
+ * Lần hai được AWAIT trong cùng hàm nên người gọi giữ cờ "đang gửi" đến khi xong (không mở lại nút Gửi giữa chừng).
+ */
+export async function sendWithConfirm(sendFn, confirmFn, body) {
+  const first = await sendFn(body, 0)
+  if (first?.status !== 'confirm_required') return first
+  if (!confirmFn(first.warning)) return null
+  return await sendFn(body, 1)
+}
+
+/**
+ * Dữ liệu cho thẻ tóm tắt của bot ở đầu tab Zalo; null khi bot chưa ghi tóm tắt hay ý định.
+ * Trả { summary, chips: [{ key, value }], analyzedAt } (key: intent | urgency | score; bỏ mục trống; điểm 0 vẫn hiện).
+ */
+export function botCard(bot) {
+  if (!bot) return null
+  const summary = String(bot.summary || '').trim()
+  const intent = String(bot.intent || '').trim()
+  if (!summary && !intent) return null
+  const chips = []
+  if (intent) chips.push({ key: 'intent', value: intent })
+  const urgency = String(bot.urgency || '').trim()
+  if (urgency) chips.push({ key: 'urgency', value: urgency })
+  if (bot.score !== null && bot.score !== undefined && bot.score !== '')
+    chips.push({ key: 'score', value: String(bot.score) })
+  const at = bot.analyzed_at
+  return {
+    summary,
+    chips,
+    analyzedAt: parseAt(at) ? `${timeLabel(at)} ${dayLabel(dayKey(at))}` : '',
+  }
+}
+
+// --- V3-09: sale gửi ảnh / tệp qua Zalo ---
+
+const MB = 1024 * 1024
+/** Loại Zalo theo đuôi tệp; giới hạn trùng `omni_crm.channels.zalo.media_out` (ảnh JPG/PNG > 1 MB máy chủ tự nén). */
+export const MEDIA_RULES = {
+  '.jpg': { kind: 'image', max: 15 * MB },
+  '.jpeg': { kind: 'image', max: 15 * MB },
+  '.png': { kind: 'image', max: 15 * MB },
+  '.pdf': { kind: 'file', max: 5 * MB },
+  '.doc': { kind: 'file', max: 5 * MB },
+  '.docx': { kind: 'file', max: 5 * MB },
+  '.csv': { kind: 'file', max: 5 * MB },
+}
+
+/** Đuôi tệp chữ thường ('.pdf'); rỗng nếu không có. */
+export function fileExtension(name) {
+  const value = String(name || '')
+  const dot = value.lastIndexOf('.')
+  return dot > 0 ? value.slice(dot).toLowerCase() : ''
+}
+
+/** Kiểm tệp sale chọn: trả { kind } nếu gửi được, hoặc { error } (chuỗi tiếng Việt chưa dịch). */
+export function checkMediaFile(file) {
+  if (!file) return { error: 'Chưa chọn tệp' }
+  const ext = fileExtension(file.name)
+  if (ext === '.gif')
+    return {
+      error:
+        'Zalo hiện chưa nhận ảnh GIF gửi qua hệ thống; hãy gửi ảnh JPG hoặc PNG',
+    }
+  const rule = MEDIA_RULES[ext]
+  if (!rule)
+    return { error: 'Zalo chỉ nhận ảnh JPG/PNG hoặc tệp PDF/DOC/DOCX/CSV' }
+  if (!file.size) return { error: 'Tệp rỗng' }
+  if (file.size > rule.max) {
+    const limit = Math.round(rule.max / MB)
+    return {
+      error:
+        rule.kind === 'image'
+          ? `Ảnh quá lớn (tối đa ${limit} MB)`
+          : `Tệp quá lớn: Zalo nhận tối đa ${limit} MB`,
+    }
+  }
+  return { kind: rule.kind }
+}
+
+/** Nút Gửi bật khi: có chữ (trong giới hạn) HOẶC có tệp hợp lệ và khung soạn cho gửi ảnh/tệp. */
+export function canSubmitWithFile(
+  compose,
+  text,
+  file,
+  sending,
+  maxChars = 6000,
+) {
+  if (!file) return canSubmit(compose, text, sending, maxChars)
+  const value = String(text || '').trim()
+  return Boolean(
+    compose?.can_send &&
+    compose?.can_send_media &&
+    !sending &&
+    !checkMediaFile(file).error &&
+    value.length <= Math.min(maxChars, 2000),
+  )
+}
