+describe('URL nghiêm ngặt, nhất quán với máy chủ (V3-05)', () => {
+  const BAD = [
+    'https://evil.com\\@zdn.vn/x.jpg',
+    'https://evil.com\\.zdn.vn/x.jpg',
+    'https://photo.zdn.vn/a\\b.jpg',
+    'https://photo.zdn.vn/a\u0001.jpg',
+    'https://photo.zdn.vn/a\u007f.jpg',
+    'https://photo.zdn.vn/a b.jpg',
+    'https://photo.zdn.vn/a\u00a0b.jpg',
+    'https://photo.zdn.vn/a\nb.jpg',
+    ' https://photo.zdn.vn/a.jpg',
+  ]
+  const INLINE_ONLY_BAD = [
+    'https://photo.zdn.vn:8443/a.jpg',
+    'https://user:pw@photo.zdn.vn/a.jpg',
+  ]
+  it('isInlineImageUrl và isSafeUrl loại URL có \\, ký tự điều khiển, khoảng trắng', () => {
+    for (const bad of BAD) {
+      expect(isInlineImageUrl(bad), bad).toBe(false)
+      expect(isSafeUrl(bad), bad).toBe(false)
+    }
+    for (const bad of INLINE_ONLY_BAD) {
+      expect(isInlineImageUrl(bad), bad).toBe(false)
+    }
+  })
+  it('/files: nhận đường sạch, loại .., //, khoảng trắng, ký tự lạ', () => {
+    expect(isInlineImageUrl('/files/a.png')).toBe(true)
+    expect(isInlineImageUrl('/private/files/a.png')).toBe(true)
+    for (const bad of [
+      '/files/../private/x.png',
+      '/files/%2e%2e/x.png',
+      '/private/files/a/../../x',
+      '/files//x.png',
+      '/files/a b.png',
+      '/files/a\\b.png',
+      '/files/a\u0001.png',
+      '//photo.zdn.vn/a.jpg',
+    ]) {
+      expect(isInlineImageUrl(bad), bad).toBe(false)
+    }
+  })
+  it('cổng 443 tường minh vẫn được', () => {
+    expect(isInlineImageUrl('https://photo-stal-27.zdn.vn:443/a.jpg')).toBe(
+      true,
+    )
+  })
+})
