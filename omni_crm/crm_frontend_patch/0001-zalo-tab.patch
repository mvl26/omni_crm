@@ -0,0 +1,25 @@
+// Nội dung ghi chú của cuộc gọi (omni_crm V3-05, ADR 0016 mục 14): FCRM Note.content là HTML của trình soạn thảo.
+// Chuyển thành chữ thuần để hiện trong thẻ cuộc gọi (không chèn HTML thô vào trang: nội dung có thể do bot hoặc khách tạo).
+
+export function htmlToText(html) {
+  if (!html) return ''
+  const withBreaks = String(html)
+    .replace(/<br\s*\/?>/gi, '\n')
+    .replace(/<\/(p|div|li|h[1-6])>/gi, '\n')
+  const doc = new DOMParser().parseFromString(withBreaks, 'text/html')
+  return (doc.body.textContent || '')
+    .replace(/\u00a0/g, ' ')
+    .replace(/\n{3,}/g, '\n\n')
+    .trim()
+}
+
+// Danh sách {name, title, text} từ `_notes` của get_call_log; bỏ ghi chú rỗng.
+export function callNotes(notes) {
+  return (notes || [])
+    .map((n) => ({
+      name: n?.name || '',
+      title: n?.title || '',
+      text: htmlToText(n?.content),
+    }))
+    .filter((n) => n.text || n.title)
+}
