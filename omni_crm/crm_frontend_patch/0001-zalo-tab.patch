+
+// --- Ảnh / GIF / sticker / tệp khách gửi (V3-05, ADR 0018) ---
+
+/** Hậu tố host CDN Zalo được phép làm src ảnh nội tuyến (khớp danh sách ở máy chủ: omni_crm/utils/media.py). */
+export const ZALO_MEDIA_HOST_SUFFIXES = [
+  'zdn.vn',
+  'zadn.vn',
+  'zaloapp.com',
+  'zalo.me',
+]
+export const INLINE_IMAGE_TYPES = ['image', 'gif', 'sticker']
+
+const TYPE_LABELS = {
+  image: 'Ảnh',
+  gif: 'GIF',
+  sticker: 'Sticker',
+  video: 'Video',
+  link: 'Liên kết',
+  business_card: 'Danh thiếp',
+  audio: 'Tin thoại',
+  location: 'Vị trí',
+  file: 'Tệp',
+}
+
+/**
+ * Được vẽ thành ảnh nội tuyến khi: (1) https tới host CDN Zalo (đúng host hoặc tên miền con), không userinfo, không cổng khác
+ * 443, không `\`/ký tự điều khiển/khoảng trắng; hoặc (2) đường dẫn nội bộ /files, /private/files không có `..` hay `//`
