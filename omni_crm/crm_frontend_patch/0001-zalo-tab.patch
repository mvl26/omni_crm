index 0000000..0225fd0
--- /dev/null
+++ b/frontend/src/utils/zaloThread.js
@@ -0,0 +1,181 @@
+// Hàm thuần cho tab "Zalo" (omni_crm, V3-01): nhóm bong bóng, nhãn, lọc URL an toàn. Không phụ thuộc Vue/DOM.
+
+export const ZALO_EVENT = 'omni_inbox_update'
+export const POLL_MS = 60000
+
+/** Chỉ cho phép liên kết http(s); mọi thứ khác (javascript:, data:, /files/...) bị bỏ. */
+export function isSafeUrl(url) {
+  return /^https?:\/\//i.test(String(url || '').trim())
+}
+
+/** Danh sách đính kèm đã lọc: chỉ URL http(s), mỗi mục có name để hiển thị. */
+export function safeAttachments(list) {
+  if (!Array.isArray(list)) return []
+  return list
+    .filter((a) => a && isSafeUrl(a.url))
+    .map((a) => ({
+      url: String(a.url).trim(),
+      name: String(a.name || a.url).slice(0, 120),
+    }))
+}
+
+/** 'left' cho khách, 'right' cho nhân viên / bot / nhân viên trả lời ngoài hệ thống. */
+export function bubbleSide(msg) {
+  return msg?.kind === 'customer' || msg?.direction === 'in' ? 'left' : 'right'
+}
+
+/** Nguồn tin: customer | sale | bot | echo. */
+export function sourceOf(msg) {
+  if (msg?.kind === 'bot' || msg?.bot_sent) return 'bot'
+  if (msg?.kind === 'echo') return 'echo'
+  if (bubbleSide(msg) === 'left') return 'customer'
+  return 'sale'
+}
+
+function parseAt(at) {
+  if (!at) return null
+  const d = new Date(String(at).replace(' ', 'T').slice(0, 19))
+  return isNaN(d.getTime()) ? null : d
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+
+/** Ngày (YYYY-MM-DD) của thời điểm; '' nếu không đọc được. */
+export function dayKey(at) {
+  const d = parseAt(at)
+  return d
+    ? `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+    : ''
+}
+
+/** Giờ:phút (HH:mm); '' nếu không đọc được. */
+export function timeLabel(at) {
+  const d = parseAt(at)
+  return d ? `${pad(d.getHours())}:${pad(d.getMinutes())}` : ''
+}
+
+/** Nhãn ngày dd/mm/yyyy cho đường phân cách ngày. */
+export function dayLabel(key) {
+  const [y, m, d] = String(key).split('-')
+  return y && m && d ? `${d}/${m}/${y}` : ''
+}
+
+/** Nhóm tin theo ngày, giữ thứ tự thời gian: [{ day, items }]. */
+export function groupByDay(messages) {
+  const groups = []
+  for (const msg of messages || []) {
+    const day = dayKey(msg.at)
+    const last = groups[groups.length - 1]
+    if (last && last.day === day) last.items.push(msg)
+    else groups.push({ day, items: [msg] })
+  }
+  return groups
+}
+
+/** Có được bấm Gửi không: khung soạn mở, có chữ, không quá giới hạn, không đang gửi. */
+export function canSubmit(compose, text, sending, maxChars = 6000) {
+  const value = String(text || '').trim()
+  return Boolean(
+    compose?.can_send && !sending && value && value.length <= maxChars,
+  )
+}
+
+/** Tín hiệu realtime `omni_inbox_update` có thuộc hội thoại đang xem không (payload chỉ có {lead, channels}). */
+export function isRelevantUpdate(payload, lead) {
+  if (!payload || !lead || payload.lead !== lead) return false
+  const channels = payload.channels
+  return (
+    !Array.isArray(channels) || !channels.length || channels.includes('Zalo OA')
+  )
+}
+
+// --- Nhắn từ trang chính thức của Zalo OA (OA gói Cơ bản không gửi được qua API) ---
+
+/** Trang chat chính thức của Zalo OA (chung, không chọn khách). */
+export const OA_CHAT_URL = 'https://oa.zalo.me/chat'
+/** Tham số cửa sổ chat: nhỏ gọn để đặt cạnh trang Lead; luôn noopener,noreferrer. */
+export function chatWindowFeatures(screenWidth = 1280, screenHeight = 800) {
+  const width = 480
+  const height = Math.max(520, Math.min(760, Number(screenHeight) - 120 || 700))
+  const left = Math.max(0, Number(screenWidth) - width - 20 || 0)
+  return `noopener,noreferrer,popup=yes,width=${width},height=${height},left=${left},top=40`
+}
+
+/**
+ * Địa chỉ mở đúng hội thoại của khách: ?uid=<mã người dùng Zalo>&oaid=<mã OA> (oaid CHỮ THƯỜNG; viết oaId thì Zalo bỏ
+ * tham số). Chỉ nhận chuỗi số; thiếu hoặc không hợp lệ một trong hai thì rơi về trang chat chung.
+ */
+export function buildOaChatUrl(contact) {
+  const uid = String(contact?.zalo_user_id ?? '').trim()
+  const oaid = String(contact?.oa_id ?? '').trim()
+  if (!/^\d{1,32}$/.test(uid) || !/^\d{1,32}$/.test(oaid)) return OA_CHAT_URL
+  return `${OA_CHAT_URL}?uid=${encodeURIComponent(uid)}&oaid=${encodeURIComponent(oaid)}`
+}
+
+/** Có mở thẳng được hội thoại của khách không (đủ cả uid và oaid hợp lệ). */
+export function hasDirectChatLink(contact) {
+  return buildOaChatUrl(contact) !== OA_CHAT_URL
+}
+
+/**
+ * Chế độ khối "Mở chat Zalo OA": 'none' (không có thông tin khách), 'direct' (mở thẳng hội thoại, chỉ cần nút),
+ * 'fallback' (thiếu uid hoặc oaid: hiện hướng dẫn tìm tay + mã để sao chép).
+ */
+export function chatPanelMode(contact) {
+  if (!contact) return 'none'
+  return hasDirectChatLink(contact) ? 'direct' : 'fallback'
+}
+
+/** Mở trang chat Zalo OA (đúng hội thoại nếu đủ thông tin) ở cửa sổ mới; trả true nếu gọi được window.open. */
+export function openOaChat(contact = null, win = globalThis.window) {
+  if (!win || typeof win.open !== 'function') return false
+  const screen = win.screen || {}
+  win.open(
+    buildOaChatUrl(contact),
+    '_blank',
+    chatWindowFeatures(screen.availWidth, screen.availHeight),
+  )
+  return true
+}
+
+/** Mã Zalo rút gọn để đọc nhanh: giữ 4 ký tự đầu và 4 cuối; mã ngắn giữ nguyên. */
+export function shortZaloId(id) {
+  const value = String(id || '').trim()
+  return value.length > 10 ? `${value.slice(0, 4)}…${value.slice(-4)}` : value
+}
+
+/** Chép chuỗi vào clipboard; không ném lỗi, trả { ok, error }. */
+export async function copyToClipboard(text, nav = globalThis.navigator) {
+  const value = String(text ?? '')
+  if (!value) return { ok: false, error: 'empty' }
+  try {
+    if (!nav?.clipboard?.writeText) return { ok: false, error: 'unsupported' }
+    await nav.clipboard.writeText(value)
+    return { ok: true, error: null }
+  } catch (e) {
+    return { ok: false, error: e?.name || 'failed' }
+  }
+}
+
+/**
+ * Dữ liệu cho thẻ tóm tắt của bot ở đầu tab Zalo; null khi bot chưa ghi tóm tắt hay ý định.
+ * Trả { summary, chips: [{ key, value }], analyzedAt } (key: intent | urgency | score; bỏ mục trống; điểm 0 vẫn hiện).
+ */
+export function botCard(bot) {
+  if (!bot) return null
+  const summary = String(bot.summary || '').trim()
+  const intent = String(bot.intent || '').trim()
+  if (!summary && !intent) return null
+  const chips = []
+  if (intent) chips.push({ key: 'intent', value: intent })
+  const urgency = String(bot.urgency || '').trim()
+  if (urgency) chips.push({ key: 'urgency', value: urgency })
+  if (bot.score !== null && bot.score !== undefined && bot.score !== '')
+    chips.push({ key: 'score', value: String(bot.score) })
+  const at = bot.analyzed_at
+  return {
+    summary,
+    chips,
+    analyzedAt: parseAt(at) ? `${timeLabel(at)} ${dayLabel(dayKey(at))}` : '',
+  }
+}
