+    expect(checkMediaFile(f('a.jpeg', 1000))).toEqual({ kind: 'image' })
+    expect(checkMediaFile(f('b.gif', 1000)).error).toMatch(/JPG hoặc PNG/) // Zalo trả -200 khi gửi GIF
+    expect(checkMediaFile(f('c.docx', 1000))).toEqual({ kind: 'file' })
+    expect(checkMediaFile(f('d.xlsx', 1000)).error).toMatch(/PDF\/DOC/)
+    expect(checkMediaFile(f('khongduoi', 1000)).error).toBeTruthy()
+    expect(checkMediaFile(f('.png', 1000)).error).toBeTruthy()
+    expect(checkMediaFile(null).error).toBeTruthy()
+    expect(checkMediaFile(f('rong.pdf', 0)).error).toBe('Tệp rỗng')
+  })
+
+  it('giới hạn dung lượng: tệp/GIF 5 MB, ảnh 15 MB (máy chủ nén xuống 1 MB)', () => {
+    const MB = 1024 * 1024
+    expect(checkMediaFile(f('a.pdf', 5 * MB)).kind).toBe('file')
+    expect(checkMediaFile(f('a.pdf', 5 * MB + 1)).error).toMatch(/5 MB/)
+    expect(checkMediaFile(f('a.png', 3 * MB)).kind).toBe('image')
+    expect(checkMediaFile(f('a.png', 15 * MB + 1)).error).toMatch(/15 MB/)
+  })
+
+  it('nút Gửi: có tệp thì không cần chữ, nhưng cần quyền gửi ảnh/tệp', () => {
+    expect(canSubmitWithFile(open, '', f('a.pdf', 10), false)).toBe(true)
+    expect(
+      canSubmitWithFile(open, 'kèm chú thích', f('a.png', 10), false),
