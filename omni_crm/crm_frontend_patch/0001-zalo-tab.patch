+  const list = Array.isArray(data?.templates) ? data.templates : []
+  const out = []
+  for (const t of list) {
+    if (!t || typeof t !== 'object') continue
+    const name = String(t.name ?? '').trim()
+    const title = String(t.title ?? '').trim() || name
+    if (!title) continue
+    const body = t.text == null ? '' : String(t.text).replace(/\r\n?/g, '\n')
