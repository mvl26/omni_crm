index 0000000..92a3ba6
--- /dev/null
+++ b/frontend/tests/unit/zaloThread.test.js
@@ -0,0 +1,115 @@
+import { describe, expect, it } from 'vitest'
+import {
+  bubbleSide,
+  canSubmit,
+  dayKey,
+  dayLabel,
+  groupByDay,
+  isRelevantUpdate,
+  isSafeUrl,
+  safeAttachments,
+  sourceOf,
+  timeLabel,
+} from '@/utils/zaloThread'
+
+describe('isSafeUrl / safeAttachments', () => {
+  it('chỉ nhận http(s)', () => {
+    expect(isSafeUrl('https://x.example/a.png')).toBe(true)
+    expect(isSafeUrl(' HTTP://x.example ')).toBe(true)
+    for (const bad of [
+      'javascript:alert(1)',
+      'data:text/html,x',
+      '/files/a.pdf',
+      '//x.example',
+      '',
+      null,
+      undefined,
+    ]) {
+      expect(isSafeUrl(bad)).toBe(false)
+    }
+  })
+  it('lọc đính kèm và đặt tên', () => {
+    const out = safeAttachments([
+      { url: 'https://x.example/a.png', name: 'a.png' },
+      { url: 'javascript:x' },
+      { url: 'https://x.example/b' },
+      null,
+    ])
+    expect(out).toEqual([
+      { url: 'https://x.example/a.png', name: 'a.png' },
+      { url: 'https://x.example/b', name: 'https://x.example/b' },
+    ])
+    expect(safeAttachments(undefined)).toEqual([])
+  })
+})
+
+describe('bubbleSide / sourceOf', () => {
+  it('khách bên trái, còn lại bên phải', () => {
+    expect(bubbleSide({ kind: 'customer', direction: 'in' })).toBe('left')
+    for (const kind of ['sale', 'bot', 'echo']) {
+      expect(bubbleSide({ kind, direction: 'out' })).toBe('right')
+    }
+  })
+  it('nhận biết nguồn', () => {
+    expect(sourceOf({ kind: 'customer', direction: 'in' })).toBe('customer')
+    expect(sourceOf({ kind: 'bot', direction: 'out' })).toBe('bot')
+    expect(sourceOf({ kind: 'sale', bot_sent: true, direction: 'out' })).toBe(
+      'bot',
+    )
+    expect(sourceOf({ kind: 'echo', direction: 'out' })).toBe('echo')
+    expect(sourceOf({ kind: 'sale', direction: 'out' })).toBe('sale')
+  })
+})
