+describe('thời gian và nhóm theo ngày', () => {
+  it('định dạng giờ và ngày theo giờ máy chủ', () => {
+    expect(timeLabel('2026-11-04 09:05:33.123456')).toBe('09:05')
+    expect(dayKey('2026-11-04 23:59:59')).toBe('2026-11-04')
+    expect(dayLabel('2026-11-04')).toBe('04/11/2026')
+    expect(timeLabel('hỏng')).toBe('')
+    expect(dayKey(null)).toBe('')
+  })
+  it('nhóm tin theo ngày, giữ thứ tự', () => {
+    const msgs = [
+      { name: 'a', at: '2026-11-03 23:00:00' },
+      { name: 'b', at: '2026-11-04 00:10:00' },
+      { name: 'c', at: '2026-11-04 08:00:00' },
+    ]
+    const groups = groupByDay(msgs)
+    expect(groups.map((g) => g.day)).toEqual(['2026-11-03', '2026-11-04'])
+    expect(groups[1].items.map((m) => m.name)).toEqual(['b', 'c'])
+    expect(groupByDay(null)).toEqual([])
+  })
+})
