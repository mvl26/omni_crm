+import { createResource } from 'frappe-ui'
+import { computed, ref } from 'vue'
+import {
+  filterTemplates,
+  needsTemplateSearch,
+  templateList,
+} from '@/utils/messengerThread'
+
+// Tab Messenger (ADR 0023) chỉ hiện khi app omni_crm đã cài và công tắc không bị tắt (Omni Settings.messenger_tab_disabled).
+// Nếu omni_crm không có trên site (hoặc bản omni_crm cũ chưa có API này), lời gọi lỗi và tab đơn giản không hiện (CRM chạy như cũ).
+export const messengerEnabled = ref(false)
+
+createResource({
+  url: 'omni_crm.api.messenger_tab.tab_state',
+  cache: 'Omni Messenger Tab Enabled',
+  auto: true,
+  onSuccess: (data) => {
+    messengerEnabled.value = Boolean(data?.enabled)
+  },
+  onError: () => {
+    messengerEnabled.value = false
+  },
+})
+
+/**
+ * Mẫu tin nhắn của tab Messenger (ADR 0026): một resource cho mỗi tab (tab được tạo lại theo Lead/Deal), chỉ tải khi
+ * bảng chọn mở lần đầu, không thăm dò. Máy chủ đã lọc, sắp xếp và điền sẵn theo Lead và người dùng. Lỗi tải hiện ngay
+ * trong bảng chọn (có nút thử lại), không bật thông báo chung.
+ */
+export function useMessengerTemplates(getParams) {
+  const resource = createResource({
+    url: 'omni_crm.api.messenger_tab.get_templates',
+    makeParams: () => getParams(),
+    onError: () => {},
+  })
+  const query = ref('')
+  const items = computed(() => templateList(resource.data))
+  const shown = computed(() => filterTemplates(items.value, query.value))
+  const showSearch = computed(() => needsTemplateSearch(items.value))
+
+  function load() {
+    if (resource.loading || resource.fetched) return
+    resource.fetch().catch(() => {}) // lỗi đã nằm ở resource.error
+  }
+
+  function reset() {
+    resource.reset()
+    query.value = ''
+  }
+
+  return { resource, query, items, shown, showSearch, load, reset }
+}
