diff --git a/frontend/src/utils/zaloThread.js b/frontend/src/utils/zaloThread.js
new file mode 100644
index 0000000..959ad1b
--- /dev/null
+++ b/frontend/src/utils/zaloThread.js
@@ -0,0 +1,90 @@
+// Hàm thuần cho tab "Zalo" (omni_crm, V3-01): nhóm bong bóng, nhãn, lọc URL an toàn. Không phụ thuộc Vue/DOM.
+
+export const ZALO_EVENT = 'omni_inbox_update'
+export const POLL_MS = 60000
+
+/** Chỉ cho phép liên kết http(s); mọi thứ khác (javascript:, data:, /files/...) bị bỏ. */
+export function isSafeUrl(url) {
+  return /^https?:\/\//i.test(String(url || '').trim())
+}
+
+/** Danh sách đính kèm đã lọc: chỉ URL http(s), mỗi mục có name để hiển thị. */
+export function safeAttachments(list) {
+  if (!Array.isArray(list)) return []
+  return list
+    .filter((a) => a && isSafeUrl(a.url))
+    .map((a) => ({
+      url: String(a.url).trim(),
+      name: String(a.name || a.url).slice(0, 120),
+    }))
+}
+
+/** 'left' cho khách, 'right' cho nhân viên / bot / nhân viên trả lời ngoài hệ thống. */
+export function bubbleSide(msg) {
+  return msg?.kind === 'customer' || msg?.direction === 'in' ? 'left' : 'right'
+}
+
+/** Nguồn tin: customer | sale | bot | echo. */
+export function sourceOf(msg) {
+  if (msg?.kind === 'bot' || msg?.bot_sent) return 'bot'
+  if (msg?.kind === 'echo') return 'echo'
+  if (bubbleSide(msg) === 'left') return 'customer'
+  return 'sale'
+}
+
+function parseAt(at) {
+  if (!at) return null
+  const d = new Date(String(at).replace(' ', 'T').slice(0, 19))
+  return isNaN(d.getTime()) ? null : d
+}
+
+const pad = (n) => String(n).padStart(2, '0')
+
+/** Ngày (YYYY-MM-DD) của thời điểm; '' nếu không đọc được. */
+export function dayKey(at) {
+  const d = parseAt(at)
+  return d
+    ? `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+    : ''
+}
+
+/** Giờ:phút (HH:mm); '' nếu không đọc được. */
+export function timeLabel(at) {
+  const d = parseAt(at)
+  return d ? `${pad(d.getHours())}:${pad(d.getMinutes())}` : ''
+}
+
+/** Nhãn ngày dd/mm/yyyy cho đường phân cách ngày. */
+export function dayLabel(key) {
+  const [y, m, d] = String(key).split('-')
+  return y && m && d ? `${d}/${m}/${y}` : ''
+}
+
+/** Nhóm tin theo ngày, giữ thứ tự thời gian: [{ day, items }]. */
+export function groupByDay(messages) {
+  const groups = []
+  for (const msg of messages || []) {
+    const day = dayKey(msg.at)
+    const last = groups[groups.length - 1]
+    if (last && last.day === day) last.items.push(msg)
+    else groups.push({ day, items: [msg] })
+  }
+  return groups
+}
+
+/** Có được bấm Gửi không: khung soạn mở, có chữ, không quá giới hạn, không đang gửi. */
+export function canSubmit(compose, text, sending, maxChars = 6000) {
+  const value = String(text || '').trim()
+  return Boolean(
+    compose?.can_send && !sending && value && value.length <= maxChars,
+  )
+}
+
+/** Tín hiệu realtime `omni_inbox_update` có thuộc hội thoại đang xem không (payload chỉ có {lead, channels}). */
+export function isRelevantUpdate(payload, lead) {
+  if (!payload || !lead || payload.lead !== lead) return false
+  const channels = payload.channels
+  return (
+    !Array.isArray(channels) || !channels.length || channels.includes('Zalo OA')
+  )
+}
diff --git a/frontend/tests/unit/zaloThread.test.js b/frontend/tests/unit/zaloThread.test.js
