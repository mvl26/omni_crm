+        :disabled="busy || !turns.length"
+        @click="startNew"
+      />
+    </div>
+    <div
+      ref="scroller"
+      class="min-h-0 flex-1 overflow-y-auto px-3 py-3 sm:px-5"
+    >
+      <div
+        v-if="startError"
+        class="rounded bg-surface-red-1 px-3 py-2 text-base text-ink-red-4"
+      >
+        {{ startError }}
+      </div>
+      <div
+        v-else-if="!hasKey && session"
+        class="mb-3 rounded border border-outline-amber-2 bg-surface-amber-1 px-3 py-2 text-base text-ink-gray-8"
+      >
+        {{ __('Trợ lý chưa cấu hình khoá AI.') }}
+        <a :href="settingsUrl" class="underline" target="_blank">{{
+          __('Mở Omni Settings')
+        }}</a>
+      </div>
+      <div
+        v-if="!turns.length && !startError"
+        class="py-6 text-center text-base text-ink-gray-5"
+      >
+        {{
+          __(
+            'Gõ một câu lệnh, ví dụ: "ghi log cuộc gọi hôm nay cho khách này". Trợ lý thao tác bằng quyền của bạn và không gửi gì cho khách.',
+          )
+        }}
+      </div>
+      <div v-for="(turn, i) in turns" :key="i" class="mb-3">
+        <div v-if="turn.role === 'user'" class="flex justify-end">
+          <div
+            class="max-w-[95%] whitespace-pre-wrap break-words rounded-lg bg-surface-gray-3 px-3 py-2 text-base text-ink-gray-9"
+          >
+            {{ turn.text }}
+          </div>
+        </div>
+        <div v-else class="flex flex-col items-start gap-1.5">
+          <div
+            v-if="turn.text"
+            class="max-w-[95%] whitespace-pre-wrap break-words rounded-lg border border-outline-gray-2 px-3 py-2 text-base text-ink-gray-8"
+            :class="turn.error ? 'text-ink-red-4' : ''"
+          >
+            {{ turn.text }}
+            <a
+              v-if="turn.settingsUrl"
+              :href="turn.settingsUrl"
+              class="underline"
+              target="_blank"
+              >{{ __('Mở Omni Settings') }}</a
+            >
+          </div>
+          <template v-for="act in turn.actions || []" :key="act.action">
+            <!-- Thao tác chờ duyệt: chưa bấm thì không có gì thay đổi trong CSDL -->
+            <div
+              v-if="act.changes"
+              class="w-full max-w-[95%] rounded-lg border border-outline-amber-2 px-3 py-2 text-sm"
+            >
+              <div class="mb-1 font-medium text-ink-gray-9">
+                {{ toolText(act.tool) }} ·
+                <span
+                  :class="
+                    act.status === 'Pending'
+                      ? 'text-ink-amber-3'
+                      : 'text-ink-gray-6'
+                  "
+                  >{{ statusText(act.status) }}</span
+                >
+              </div>
+              <table class="w-full text-ink-gray-8">
+                <tr v-for="c in act.changes" :key="c.field">
+                  <td class="pr-2 align-top text-ink-gray-6">{{ c.label }}</td>
+                  <td class="pr-2 align-top line-through decoration-ink-gray-4">
+                    {{ shown(c.old) }}
+                  </td>
+                  <td class="align-top font-medium">→ {{ shown(c.new) }}</td>
+                </tr>
+              </table>
+              <div v-if="act.status === 'Pending'" class="mt-2 flex gap-2">
+                <Button
+                  size="sm"
+                  variant="solid"
+                  :label="__('Duyệt')"
+                  :loading="deciding === act.action"
+                  @click="decide(act, 'approve')"
+                />
+                <Button
+                  size="sm"
+                  :label="__('Bỏ')"
+                  :disabled="deciding === act.action"
+                  @click="decide(act, 'reject')"
+                />
+              </div>
+            </div>
+            <!-- Thao tác đã ghi: link tới bản ghi để kiểm ngay -->
+            <div v-else class="text-sm text-ink-gray-7">
+              <span
+                :class="
+                  act.status === 'Success'
+                    ? 'text-ink-green-3'
+                    : 'text-ink-red-4'
+                "
+                >{{ statusText(act.status) }}</span
+              >
+              · {{ toolText(act.tool) }}
+              <template v-for="link in act.links || []" :key="link.name">
+                ·
+                <button
+                  v-if="linkTab(link)"
+                  type="button"
+                  class="underline"
+                  @click="emit('open-tab', linkTab(link))"
+                >
+                  {{ link.label }} {{ link.name }}
+                </button>
+                <span v-else class="text-ink-gray-8"
+                  >{{ link.label }} {{ link.name
+                  }}<template v-if="link.detail">
+                    ({{ link.detail }})</template
+                  ></span
+                >
+              </template>
+              <span v-if="act.error"> · {{ act.error }}</span>
+            </div>
+          </template>
+        </div>
+      </div>
+      <div
+        v-if="busy"
+        class="flex items-center gap-2 text-base text-ink-gray-5"
+      >
+        <LoadingIndicator class="h-4 w-4" />
+        <span>{{ __('Trợ lý đang xử lý...') }}</span>
+      </div>
+    </div>
+    <div class="shrink-0 border-t px-3 py-2.5 sm:px-5">
+      <div class="flex items-end gap-2">
+        <Textarea
+          v-model="text"
+          type="textarea"
+          class="assistant-input w-full"
+          :rows="4"
+          :disabled="!session"
+          :placeholder="
+            busy
+              ? __('Đang chờ trợ lý trả lời...')
+              : __(
+                  'Nhập câu lệnh cho trợ lý (Enter để gửi, Shift+Enter xuống dòng)',
+                )
+          "
+          @keydown.enter.exact.prevent="submit"
+        />
+        <Button
+          variant="solid"
+          :label="__('Gửi')"
+          :loading="busy"
+          :disabled="!canSend(text, busy, session)"
+          @click="submit"
+        />
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { nextTick, onBeforeUnmount, onMounted, ref } from 'vue'
+import { Button, LoadingIndicator, Textarea, call } from 'frappe-ui'
+import {
+  canSend,
+  hasWrites,
+  linkTab,
+  shown,
+  statusText,
+  toolText,
+} from '@/utils/assistantChat'
+
+// Trợ lý AI nội bộ (omni_crm V3-05): mọi kiểm tra quyền, trần ghi, chờ duyệt nằm ở omni_crm.assistant.api.
+const props = defineProps({
+  doctype: { type: String, required: true },
+  docname: { type: String, required: true },
+})
+const emit = defineEmits(['changed', 'open-tab'])
+
+const API = 'omni_crm.assistant.api.'
+const session = ref('')
+const hasKey = ref(true)
+const settingsUrl = ref('/app/omni-settings')
+const startError = ref('')
+const turns = ref([])
+const text = ref('')
+const busy = ref(false)
+const deciding = ref('')
+const scroller = ref(null)
+
+function errorText(err) {
+  return (
+    err?.messages?.[0] ||
+    err?.message ||
+    __('Có lỗi, thử lại sau.')
+  ).replace(/<[^>]*>/g, '')
+}
+
+function scrollToBottom() {
+  nextTick(() => {
+    const el = scroller.value
+    if (el) el.scrollTop = el.scrollHeight
+  })
+}
+
+onMounted(async () => {
+  try {
+    const res = await call(API + 'start_session', {
+      lead: props.doctype === 'CRM Lead' ? props.docname : null,
+    })
+    session.value = res.session
+    turns.value = res.history || []
+    hasKey.value = res.has_key
+    settingsUrl.value = res.settings_url || settingsUrl.value
+  } catch (err) {
+    startError.value = errorText(err)
+  }
+  scrollToBottom()
+})
+
+// "Cuộc trò chuyện mới": phiên mới cho Lead này; lịch sử cũ vẫn lưu ở máy chủ (Omni Assistant Session)
+async function startNew() {
+  try {
+    const res = await call(API + 'start_session', {
+      lead: props.doctype === 'CRM Lead' ? props.docname : null,
+      new: 1,
+    })
+    session.value = res.session
+    turns.value = res.history || []
+  } catch (err) {
+    turns.value.push({ role: 'assistant', text: errorText(err), error: true })
+  }
+}
+
+// Rời trang (đổi tab, đổi Lead, đóng trang): đóng phiên
+function closeSession() {
+  if (!session.value) return
+  const id = session.value
+  session.value = ''
+  call(API + 'close_session', { session_id: id }).catch(() => {})
+}
+onBeforeUnmount(closeSession)
+window.addEventListener('pagehide', closeSession)
+onBeforeUnmount(() => window.removeEventListener('pagehide', closeSession))
+
+async function submit() {
+  if (!canSend(text.value, busy.value, session.value)) return
+  const message = text.value.trim()
+  turns.value.push({ role: 'user', text: message })
+  text.value = ''
+  busy.value = true
+  scrollToBottom()
+  try {
+    const res = await call(API + 'chat', {
+      session_id: session.value,
+      message,
+    })
+    if (res.error) {
+      turns.value.push({
+        role: 'assistant',
+        text: res.error,
+        error: true,
+        settingsUrl: res.settings_url,
+      })
+    } else {
+      turns.value.push({
+        role: 'assistant',
+        text: res.reply,
+        actions: res.actions,
+      })
+      if (hasWrites(res.actions)) emit('changed')
+    }
+  } catch (err) {
+    turns.value.push({ role: 'assistant', text: errorText(err), error: true })
+  } finally {
+    busy.value = false
+    scrollToBottom()
+  }
+}
+
+async function decide(act, kind) {
+  deciding.value = act.action
+  try {
+    const res = await call(API + kind, { action_name: act.action })
+    act.status = res.status
+    if (res.status === 'Success') emit('changed')
+  } catch (err) {
+    turns.value.push({ role: 'assistant', text: errorText(err), error: true })
+  } finally {
+    deciding.value = ''
+  }
+}
+</script>
+
+<style scoped>
+/* Ô nhập cao theo nội dung (tối thiểu 4 dòng, tối đa 40% màn hình), kéo giãn được */
+.assistant-input :deep(textarea) {
+  field-sizing: content;
+  min-height: 6.5rem;
+  max-height: 40vh;
+  resize: vertical;
+  font-size: 0.95rem;
+  line-height: 1.5;
+}
+</style>
