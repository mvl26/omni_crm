--- /dev/null
+++ b/frontend/src/composables/leadContact.js
@@ -0,0 +1,48 @@
+import { call, createResource, toast } from 'frappe-ui'
+import { ref } from 'vue'
+
+// Nút "Tạo liên hệ" trên trang Lead (omni_crm V3-06). Chỉ hiện khi omni_crm đã cài và công tắc
+// Omni Settings.lead_contact_button_disabled không bật. Không có omni_crm thì lời gọi lỗi và nút không hiện.
+export const leadContactEnabled = ref(false)
+export const leadContactBusy = ref(false)
+
+createResource({
+  url: 'omni_crm.api.lead_contact.state',
+  cache: 'Omni Lead Contact Enabled',
+  auto: true,
+  onSuccess: (data) => {
+    leadContactEnabled.value = Boolean(data?.enabled)
+  },
+  onError: () => {
+    leadContactEnabled.value = false
+  },
+})
+
+// Tạo (hoặc cập nhật) Liên hệ từ Lead rồi mở trang Liên hệ trong CRM.
+export async function syncContactFromLead(lead, router) {
+  if (!lead || leadContactBusy.value) return
+  leadContactBusy.value = true
+  try {
+    const res = await call('omni_crm.api.lead_contact.sync_from_lead', {
+      lead,
+    })
+    const added = (res.added || []).join(', ')
+    toast.success(
+      res.created
+        ? __('Đã tạo liên hệ {0}', [res.contact])
+        : added
+          ? __('Đã cập nhật liên hệ {0}: thêm {1}', [res.contact, added])
+          : __('Liên hệ {0} đã đủ dữ liệu của Lead', [res.contact]),
+    )
+    router.push({ name: 'Contact', params: { contactId: res.contact } })
+  } catch (err) {
+    toast.error(
+      (err?.messages?.[0] || __('Không tạo được liên hệ')).replace(
+        /<[^>]*>/g,
+        '',
+      ),
+    )
+  } finally {
+    leadContactBusy.value = false
+  }
+}
diff --git a/frontend/src/composables/messenger.js b/frontend/src/composables/messenger.js
