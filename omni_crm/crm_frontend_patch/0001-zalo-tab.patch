+      ok: false,
+      clearText: Boolean(res.text_outbound),
+      clearFile: false,
+      error: res.reason || 'Tin bị chặn, chưa gửi',
+    }
+  return { ok: true, clearText: true, clearFile: true, error: '' }
+}
+
+// --- Mẫu tin nhắn (ADR 0026): máy chủ `get_templates` đã lọc, sắp xếp và điền sẵn theo Lead và người dùng ---
+
+/** Có nhiều hơn chừng này mẫu thì bảng chọn hiện ô tìm. */
+export const TEMPLATE_SEARCH_AFTER = 5
+
+/** Chữ dùng để so khớp khi tìm: bỏ dấu tiếng Việt (cả đ/Đ), chữ thường, gộp khoảng trắng. */
+export function foldText(value) {
+  return String(value ?? '')
+    .normalize('NFD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/đ/g, 'd')
+    .replace(/\s+/g, ' ')
+    .trim()
+}
+
+/**
+ * Danh sách mẫu từ kết quả `get_templates` ({ templates: [...] }): [{ key, name, title, note, text, error }], giữ thứ tự
+ * máy chủ. Mẫu lỗi (`error` khác rỗng) hoặc nội dung trống thì `text` = '' và có `error`: hiện mờ, không chọn được.
+ * Bỏ mục rác (không phải object, không có tên lẫn tiêu đề). Chữ thuần, hiển thị bằng nội suy.
+ */
+export function templateList(data) {
+  const list = Array.isArray(data?.templates) ? data.templates : []
+  const out = []
+  for (const t of list) {
+    if (!t || typeof t !== 'object') continue
+    const name = String(t.name ?? '').trim()
+    const title = String(t.title ?? '').trim() || name
+    if (!title) continue
+    const body = t.text == null ? '' : String(t.text).replace(/\r\n?/g, '\n')
+    const error = t.error
+      ? String(t.error).trim() || 'Mẫu lỗi'
+      : body.trim()
+        ? ''
+        : 'Nội dung mẫu trống'
+    out.push({
+      key: out.length,
+      name: name || title,
+      title,
+      note: String(t.note ?? '').trim(),
+      text: error ? '' : body,
+      error,
+    })
+  }
+  return out
+}
+
+/** Bảng chọn có cần ô tìm không (nhiều hơn `TEMPLATE_SEARCH_AFTER` mẫu). */
+export function needsTemplateSearch(list) {
+  return Array.isArray(list) && list.length > TEMPLATE_SEARCH_AFTER
+}
+
+/**
+ * Lọc mẫu theo tiêu đề, ghi chú và nội dung; không phân biệt hoa thường và dấu tiếng Việt; mọi từ trong ô tìm phải có
+ * mặt. Ô tìm rỗng (sau khi bỏ khoảng trắng) trả cả danh sách. Mẫu lỗi chỉ so theo tiêu đề và ghi chú (nội dung không dùng).
+ */
+export function filterTemplates(list, query) {
+  const items = Array.isArray(list) ? list : []
+  const q = foldText(query)
+  if (!q) return items
+  const words = q.split(' ')
+  return items.filter((t) => {
+    if (!t || typeof t !== 'object') return false
+    const hay = foldText([t.title, t.note, t.error ? '' : t.text].join(' '))
+    return words.every((w) => hay.includes(w))
+  })
+}
+
+/**
+ * Điền mẫu vào ô soạn: { text, needsConfirm }. Ô trống (chỉ khoảng trắng) thì điền thẳng; đang có chữ khác thì phải hỏi
+ * sale trước khi thay. Không bao giờ tự gửi; chữ dài hơn giới hạn vẫn điền (nút Gửi tự khóa, có dòng báo độ dài).
+ */
+export function applyTemplate(current, text) {
+  const value = text == null ? '' : String(text)
+  const now = current == null ? '' : String(current)
+  return { text: value, needsConfirm: Boolean(now.trim()) && now !== value }
+}
+
+/** Chữ (đã bỏ khoảng trắng hai đầu, như `canSubmit`) dài quá `maxChars`: { length, max }; trong giới hạn thì null. */
+export function overLimit(text, maxChars = 6000) {
+  const length = String(text || '').trim().length
+  return length > maxChars ? { length, max: maxChars } : null
+}
